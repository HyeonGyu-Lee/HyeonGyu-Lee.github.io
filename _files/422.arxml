                                                         <PARAMETERS>
                                                            <!-- PARAMETER DEFINITION: DcmDspRoutineSignalEndianness -->
                                                            <ECUC-ENUMERATION-PARAM-DEF UUID="ECUC:6d3957b3-7c15-49b9-aaef-cf4851aef251">
                                                               <SHORT-NAME>DcmDspRoutineSignalEndianness</SHORT-NAME>
                                                               <DESC>
                                                                  <L-2 L="EN">Defines the endianness of the data belonging to a Routine Out Signal for Start subfunction.</L-2>
                                                               </DESC>
                                                               <INTRODUCTION>
                                                                  <P>
                                                                     <L-1 L="EN">If no DcmDspRoutineSignalEndianness is defined the value of DcmDspDataDefaultEndianness is applicable.</L-1>
                                                                  </P>
                                                               </INTRODUCTION>
                                                               <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_Dcm_01017</RELATED-TRACE-ITEM-REF>
