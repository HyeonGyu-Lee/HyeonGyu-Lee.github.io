                              </ECUC-FLOAT-PARAM-DEF>
                              <!-- PARAMETER DEFINITION: J1939NmDevErrorDetect -->
                              <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:110eb439-484b-4167-8849-b7b17156b975">
                                 <SHORT-NAME>J1939NmDevErrorDetect</SHORT-NAME>
                                 <DESC>
                                    <L-2 L="EN">Switches the Default Error Tracer (Det) detection and notification ON or OFF.</L-2>
                                 </DESC>
                                 <INTRODUCTION>
                                    <P>
                                       <L-1 L="EN">* true: enabled (ON).
                                        * false: disabled (OFF).</L-1>
                                    </P>
                                 </INTRODUCTION>
