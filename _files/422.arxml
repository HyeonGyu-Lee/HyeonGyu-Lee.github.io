                                                               </VALUE-CONFIG-CLASSES>
                                                               <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                                            </ECUC-FLOAT-PARAM-DEF>
                                                            <!-- PARAMETER DEFINITION: DcmDspDiagnosisRepresentationDataOffset -->
                                                            <ECUC-FLOAT-PARAM-DEF UUID="ECUC:62c422b2-3b2e-2cbd-5a7b-5e4ffbb45723">
                                                               <SHORT-NAME>DcmDspDiagnosisRepresentationDataOffset</SHORT-NAME>
                                                               <DESC>
                                                                  <L-2 L="EN">Data offset of the alternative Diagnosis Representation for this scale.</L-2>
                                                               </DESC>
                                                               <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_Dcm_01005</RELATED-TRACE-ITEM-REF>
                                                               <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                                               <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
