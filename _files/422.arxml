                           <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                           <UPPER-MULTIPLICITY-INFINITE>true</UPPER-MULTIPLICITY-INFINITE>
                           <PARAMETERS>
                              <!-- PARAMETER DEFINITION: MemMapCompilerMemClassSymbolImpl -->
                              <ECUC-STRING-PARAM-DEF UUID="ECUC:fa3cfa5c-9127-4aea-8b33-241ae080e55d">
                                 <SHORT-NAME>MemMapCompilerMemClassSymbolImpl</SHORT-NAME>
                                 <DESC>
                                    <L-2 L="EN">Defines the implementation behind a MemClassSymbol and configures the Compiler Abstraction.</L-2>
                                 </DESC>
