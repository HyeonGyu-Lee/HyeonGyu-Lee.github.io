                              <!-- PARAMETER DEFINITION: XcpSuppressTxSupport -->
                              <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:ab4d5e08-c0d7-441d-b2b8-f8f53621014a">
                                 <SHORT-NAME>XcpSuppressTxSupport</SHORT-NAME>
                                 <DESC>
                                    <L-2 L="EN">Switches the support of suppressing transmission of PDUs per communication channel on or off.</L-2>
                                 </DESC>
                                 <INTRODUCTION>
                                    <P>
                                       <L-1 L="EN">TRUE: Suppressing of TxPDUs supported
                                        FALSE: Suppressing of TxPDUs not supported</L-1>
                                    </P>
                                 </INTRODUCTION>
                                 <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_Xcp_00176</RELATED-TRACE-ITEM-REF>
