                                    <!-- PARAMETER DEFINITION: J1939TpTxDynamicBlockCalculation -->
                                    <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:90c02ca1-3d43-48b9-872c-dec31552ad7e">
                                       <SHORT-NAME>J1939TpTxDynamicBlockCalculation</SHORT-NAME>
                                       <DESC>
                                          <L-2 L="EN">Enable dynamic calculation of "maximum number of packets that can be sent" value in TP.CM_RTS, based on the available amount of data in upper layers reported via PduR_J1939TpCopyTxData.</L-2>
                                       </DESC>
                                       <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_J1939Tp_00191</RELATED-TRACE-ITEM-REF>
                                       <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                       <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
