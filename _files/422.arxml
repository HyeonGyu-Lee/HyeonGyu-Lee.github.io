                                 <PARAMETERS>
                                    <!-- PARAMETER DEFINITION: TcpIpDhcpDefaultRouter -->
                                    <ECUC-STRING-PARAM-DEF UUID="ECUC:27f1f5a3-48a4-40fd-87fe-1771f5d75b9d">
