                                                      <ECUC-INTEGER-PARAM-DEF UUID="ECUC:cc407bb6-0c02-cd27-b812-391fbf021b5d">
                                                         <SHORT-NAME>ComFilterPeriod</SHORT-NAME>
                                                         <DESC>
                                                            <L-2 L="EN">This parameter defines the period of the ComFilterAlgorithm ONE_EVERY_N.</L-2>
                                                         </DESC>
                                                         <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_Com_00312</RELATED-TRACE-ITEM-REF>
                                                         <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                                         <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
