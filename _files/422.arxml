                                             <SHORT-NAME>CanTrcvPnFrameCanId</SHORT-NAME>
                                             <DESC>
                                                <L-2 L="EN">CAN ID of the Wake-up Frame (WUF).</L-2>
                                             </DESC>
                                             <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_CanTrcv_00163</RELATED-TRACE-ITEM-REF>
                                             <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                             <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                             <SCOPE>LOCAL</SCOPE>
                                             <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                             <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                                             <VALUE-CONFIG-CLASSES>
                                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                             </VALUE-CONFIG-CLASSES>
                                             <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                             <MAX>4294967295</MAX>
                                             <MIN>0</MIN>
                                          </ECUC-INTEGER-PARAM-DEF>
                                          <!-- PARAMETER DEFINITION: CanTrcvPnFrameCanIdMask -->
                                          <ECUC-INTEGER-PARAM-DEF UUID="ECUC:138f069a-dcc3-403d-9398-9d247ccefbf8">
                                             <SHORT-NAME>CanTrcvPnFrameCanIdMask</SHORT-NAME>
                                             <DESC>
                                                <L-2 L="EN">ID Mask for the selective activation of the transceiver. It is used to enableFrame Wake-up (WUF) on a group of IDs.</L-2>
                                             </DESC>
                                             <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_CanTrcv_00162</RELATED-TRACE-ITEM-REF>
                                             <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                             <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                             <SCOPE>LOCAL</SCOPE>
                                             <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                             <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                                             <VALUE-CONFIG-CLASSES>
                                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                             </VALUE-CONFIG-CLASSES>
                                             <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                             <MAX>4294967295</MAX>
                                             <MIN>0</MIN>
                                          </ECUC-INTEGER-PARAM-DEF>
                                          <!-- PARAMETER DEFINITION: CanTrcvPnFrameDlc -->
