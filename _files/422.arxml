                                                <ECUC-FOREIGN-REFERENCE-DEF UUID="ECUC:8dfda3f1-4048-42bd-b6b4-52263cf45d62">
                                                   <SHORT-NAME>DbgDebugDataRef</SHORT-NAME>
                                                   <DESC>
                                                      <L-2 L="EN">Reference to staticMemory used for Debug Data.</L-2>
                                                   </DESC>
                                                   <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_Dbg_00867</RELATED-TRACE-ITEM-REF>
