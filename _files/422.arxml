                                          <!-- PARAMETER DEFINITION: FrNmPnEnabled -->
                                          <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:349def50-5c4c-494f-b926-68c7f7ac48dd">
                                             <SHORT-NAME>FrNmPnEnabled</SHORT-NAME>
                                             <DESC>
                                                <L-2 L="EN">Enables or disables support of partial networking.</L-2>
                                             </DESC>
                                             <INTRODUCTION>
                                                <P>
                                                   <L-1 L="EN">false: Partial networking Range not supported
                                                        true: Partial networking supported</L-1>
                                                </P>
                                             </INTRODUCTION>
