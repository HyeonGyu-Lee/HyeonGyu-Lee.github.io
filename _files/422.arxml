                              <ECUC-INTEGER-PARAM-DEF UUID="ECUC:3d367d10-5882-49fc-8c48-9fe02b6f883a">
                                 <SHORT-NAME>DltInitBufferSize</SHORT-NAME>
                                 <DESC>
                                    <L-2 L="EN">Buffer size for the C-init buffer. This buffer is for storing messages from other BSW modules before Dlt is initialized.</L-2>
                                 </DESC>
                                 <INTRODUCTION>
                                    <P>
                                       <L-1 L="EN">Unit: byte</L-1>
                                    </P>
                                 </INTRODUCTION>
                                 <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_Dlt_00823</RELATED-TRACE-ITEM-REF>
