                                    <!-- PARAMETER DEFINITION: CanWakeupFunctionalityAPI -->
                                    <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:f4fba261-5da0-4946-a6ec-bee9048c2068">
                                       <SHORT-NAME>CanWakeupFunctionalityAPI</SHORT-NAME>
                                       <DESC>
                                          <L-2 L="EN">Adds / removes the service Can_CheckWakeup() from the code.</L-2>
                                       </DESC>
