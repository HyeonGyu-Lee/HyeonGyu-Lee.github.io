                                                <ECUC-INTEGER-PARAM-DEF UUID="ECUC:f668be4e-b74c-4470-a577-d9e4cdb7804f">
                                                   <SHORT-NAME>FrNmTxUserDataPduId</SHORT-NAME>
                                                   <DESC>
