                              </ECUC-BOOLEAN-PARAM-DEF>
                              <!-- PARAMETER DEFINITION: OcuSetPinStateApi -->
                              <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:c36e8660-4995-4cbe-b664-645a361723c9">
                                 <SHORT-NAME>OcuSetPinStateApi</SHORT-NAME>
