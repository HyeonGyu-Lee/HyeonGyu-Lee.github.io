                                                                           <SHORT-NAME>DcmDspDataTypeCategory</SHORT-NAME>
                                                                           <DESC>
                                                                              <L-2 L="EN">Data category of the alternative Diagnosis Representation.</L-2>
                                                                           </DESC>
