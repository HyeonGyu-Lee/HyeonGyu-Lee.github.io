                                                      </ECUC-VALUE-CONFIGURATION-CLASS>
                                                      <ECUC-VALUE-CONFIGURATION-CLASS>
                                                         <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                         <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                                      </ECUC-VALUE-CONFIGURATION-CLASS>
                                                   </VALUE-CONFIG-CLASSES>
                                                   <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                                   <MAX>7</MAX>
                                                   <MIN>0</MIN>
                                                </ECUC-INTEGER-PARAM-DEF>
                                             </PARAMETERS>
                                          </ECUC-PARAM-CONF-CONTAINER-DEF>
                                       </SUB-CONTAINERS>
                                    </ECUC-PARAM-CONF-CONTAINER-DEF>
                                 </SUB-CONTAINERS>
                              </ECUC-PARAM-CONF-CONTAINER-DEF>
                           </SUB-CONTAINERS>
                        </ECUC-PARAM-CONF-CONTAINER-DEF>
                        <!-- Container Definition: CanTrcvGeneral -->
                        <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:fce14966-e5e5-4705-80b8-c0fedce975d9">
                           <SHORT-NAME>CanTrcvGeneral</SHORT-NAME>
                           <DESC>
                              <L-2 L="EN">Container gives CAN transceiver driver basic information.</L-2>
                           </DESC>
                           <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_CanTrcv_00090</RELATED-TRACE-ITEM-REF>
                           <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
