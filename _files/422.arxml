                                    <ECUC-SYMBOLIC-NAME-REFERENCE-DEF UUID="ECUC:61a02a48-1812-4052-8e57-b48bc38ce491">
                                       <SHORT-NAME>CanWakeupSourceRef</SHORT-NAME>
