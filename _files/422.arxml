                                       <SHORT-NAME>FrTpTimeFrIf</SHORT-NAME>
                                       <DESC>
                                          <L-2 L="EN">This parameter defines the time in seconds of waiting for the next try (if retry is activated) to send via FrIf_Transmit.</L-2>
                                       </DESC>
                                       <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_FrTp_00031</RELATED-TRACE-ITEM-REF>
                                       <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
