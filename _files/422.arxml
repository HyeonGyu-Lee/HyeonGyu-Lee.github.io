                        <SUPPORTED-CONFIG-VARIANT>VARIANT-PRE-COMPILE</SUPPORTED-CONFIG-VARIANT>
                     </SUPPORTED-CONFIG-VARIANTS>
                     <CONTAINERS>
                        <!-- Container Definition: FrNmChannelConfig -->
                        <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:1e8c6f6c-4887-43c7-89d0-bd5fab7cf16e">
                           <SHORT-NAME>FrNmChannelConfig</SHORT-NAME>
