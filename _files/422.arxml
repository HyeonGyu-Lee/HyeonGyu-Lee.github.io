                        <!-- Container Definition: EepPublishedInformation -->
                        <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:51498e4e-e34f-4241-ae3e-86fc4685b744">
                           <SHORT-NAME>EepPublishedInformation</SHORT-NAME>
                           <DESC>
                              <L-2 L="EN">Additional published parameters not covered by CommonPublishedInformation container.</L-2>
                           </DESC>
                           <INTRODUCTION>
                              <P>
                                 <L-1 L="EN">Note that these parameters do not have any configuration class setting, since they are published information.</L-1>
                              </P>
                           </INTRODUCTION>
                           <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_Eep_00111</RELATED-TRACE-ITEM-REF>
                           <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                           <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                           <PARAMETERS>
                              <!-- PARAMETER DEFINITION: EepAllowedWriteCycles -->
                              <ECUC-INTEGER-PARAM-DEF UUID="ECUC:870ed76e-b5cb-4605-b433-94f94b0f6434">
                                 <SHORT-NAME>EepAllowedWriteCycles</SHORT-NAME>
                                 <DESC>
                                    <L-2 L="EN">Specified maximum number of write cycles under worst case conditions of specific EEPROM hardware (e.g. +90°C)</L-2>
                                 </DESC>
                                 <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_Eep_00177</RELATED-TRACE-ITEM-REF>
