                                          <!-- Container Definition: ComFilter -->
                                          <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:ff798fc5-c44a-89ba-256d-8fe02a42653a">
                                             <SHORT-NAME>ComFilter</SHORT-NAME>
                                             <DESC>
                                                <L-2 L="EN">This container contains the configuration parameters of the AUTOSAR COM module's Filters.</L-2>
                                             </DESC>
                                             <INTRODUCTION>
                                                <P>
                                                   <L-1 L="EN">Note: On sender side the container is used to specify the transmission mode conditions.</L-1>
                                                </P>
                                             </INTRODUCTION>
                                             <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_Com_00339</RELATED-TRACE-ITEM-REF>
