                     </SUPPORTED-CONFIG-VARIANTS>
                     <CONTAINERS>
                        <!-- Container Definition: SdConfig -->
                        <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:130bd546-f092-45a3-b09e-073504d54f03">
                           <SHORT-NAME>SdConfig</SHORT-NAME>
