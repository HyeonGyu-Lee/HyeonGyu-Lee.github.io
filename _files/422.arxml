                                          <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:3558b31b-7110-47cc-975d-74f20df27299">
                                             <SHORT-NAME>DbgLocalDebugData</SHORT-NAME>
                                             <DESC>
                                                <L-2 L="EN">Reference to a localDebugData.</L-2>
                                             </DESC>
