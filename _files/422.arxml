                                    <DESTINATION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/AUTOSAR/EcucDefs/Csm/CsmMacGenerate/CsmMacGenerateConfig</DESTINATION-REF>
                                    <DESTINATION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/AUTOSAR/EcucDefs/Csm/CsmSignatureGenerate/CsmSignatureGenerateConfig</DESTINATION-REF>
                                 </DESTINATION-REFS>
                              </ECUC-CHOICE-REFERENCE-DEF>
                              <!-- Reference Definition: SecOCSameBufferPduRef -->
