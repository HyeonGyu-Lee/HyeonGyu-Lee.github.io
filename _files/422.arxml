                                                      <ECUC-VALUE-CONFIGURATION-CLASS>
                                                         <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                         <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                                      </ECUC-VALUE-CONFIGURATION-CLASS>
                                                   </VALUE-CONFIG-CLASSES>
                                                   <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                                   <MAX>65535</MAX>
                                                   <MIN>1</MIN>
                                                </ECUC-INTEGER-PARAM-DEF>
                                                <!-- PARAMETER DEFINITION: RamTstEndAddress -->
                                                <ECUC-INTEGER-PARAM-DEF UUID="ECUC:db9b3de1-6fa0-4124-9b4c-54348cf8a124">
                                                   <SHORT-NAME>RamTstEndAddress</SHORT-NAME>
                                                   <DESC>
                                                      <L-2 L="EN">End Address of the RAM block.</L-2>
                                                   </DESC>
                                                   <INTRODUCTION>
                                                      <P>
                                                         <L-1 L="EN">Constraint: It must be larger than the RamTstStartAddress.</L-1>
                                                      </P>
                                                   </INTRODUCTION>
