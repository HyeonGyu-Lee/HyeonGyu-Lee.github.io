                                                <!-- Container Definition: BswMModeSwitchErrorEvent -->
                                                <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:f66b3d92-e79d-46aa-8be6-009f3b69562e">
                                                   <SHORT-NAME>BswMModeSwitchErrorEvent</SHORT-NAME>
                                                   <DESC>
                                                      <L-2 L="EN">This is a notification that an error occurred because the partition containing the mode users of the Mode Declaration Group Prototype was restarted by the RTE. Because the Mode Machine Instance holding the current mode can reside on that terminated partition, the Mode Manager has to be informed about</L-2>
                                                   </DESC>
                                                   <INTRODUCTION>
                                                      <P>
                                                         <L-1 L="EN">the loss of this partition.</L-1>
                                                      </P>
                                                   </INTRODUCTION>
                                                   <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_BswM_00990</RELATED-TRACE-ITEM-REF>
                                                   <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                                   <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                                   <REFERENCES>
