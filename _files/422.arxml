                                          <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:a6c03700-6002-9aff-6058-b0f1c102c8b0">
                                             <SHORT-NAME>DAQ</SHORT-NAME>
                                             <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                          </ECUC-ENUMERATION-LITERAL-DEF>
