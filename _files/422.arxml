                                       <LITERALS>
                                          <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:04a14867-ab93-8f06-5a7b-ee78ffca7410">
                                             <SHORT-NAME>J1939DCM_ISO9141</SHORT-NAME>
