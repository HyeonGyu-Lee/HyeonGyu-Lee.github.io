                                             <PARAMETERS>
                                                <!-- PARAMETER DEFINITION: FrNmRxPduContainsData -->
                                                <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:7f31b219-7c94-4c4e-85be-eb7fc3c12e67">
                                                   <SHORT-NAME>FrNmRxPduContainsData</SHORT-NAME>
                                                   <DESC>
                                                      <L-2 L="EN">This parameter defines if the PDU contains NM Data.</L-2>
                                                   </DESC>
