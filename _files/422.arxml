                        <!-- Container Definition: FrSMGeneral -->
                        <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:c7bab0a0-434a-4b1b-9cbc-a4fa164375e0">
                           <SHORT-NAME>FrSMGeneral</SHORT-NAME>
                           <DESC>
                              <L-2 L="EN">This container contains the general configuration parameters of the FlexRay State Manager.</L-2>
                           </DESC>
                           <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_FrSM_00107</RELATED-TRACE-ITEM-REF>
                           <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                           <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                           <PARAMETERS>
                              <!-- PARAMETER DEFINITION: FrSMAllSlotsSupport -->
                              <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:8f4124ce-8edf-4cd4-b758-e71735ad93dd">
                                 <SHORT-NAME>FrSMAllSlotsSupport</SHORT-NAME>
                                 <DESC>
                                    <L-2 L="EN">Configuration parameter to enable/disable FrSM support to enable/disable the switching from key-slot/single-slot mode to all-slot mode.</L-2>
                                 </DESC>
                                 <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_FrSM_00172</RELATED-TRACE-ITEM-REF>
