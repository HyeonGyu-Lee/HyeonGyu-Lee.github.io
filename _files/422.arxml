                                       <SHORT-NAME>DcmDslProtocol</SHORT-NAME>
                                       <DESC>
                                          <L-2 L="EN">This container contains the configurations of the diagnostic protocols used in Dcm.</L-2>
                                       </DESC>
                                       <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_Dcm_00694</RELATED-TRACE-ITEM-REF>
