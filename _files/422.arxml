                  <!-- Module Definition: EthTSyn -->
                  <ECUC-MODULE-DEF UUID="ECUC:ef7ca060-383c-4345-bcef-cb7d6d00dedc">
                     <SHORT-NAME>EthTSyn</SHORT-NAME>
                     <DESC>
                        <L-2 L="EN">Configuration of the Synchronized Time-base Manager (StbM) module with respect to global time handling on Ethernet.</L-2>
                     </DESC>
                     <ADMIN-DATA>
                        <DOC-REVISIONS>
                           <DOC-REVISION>
                              <REVISION-LABEL>4.2.2</REVISION-LABEL>
                              <ISSUED-BY>AUTOSAR</ISSUED-BY>
                              <DATE>2014-10-31</DATE>
                           </DOC-REVISION>
                        </DOC-REVISIONS>
                     </ADMIN-DATA>
                     <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_EthTSyn_00001</RELATED-TRACE-ITEM-REF>
                     <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                     <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                     <POST-BUILD-VARIANT-SUPPORT>false</POST-BUILD-VARIANT-SUPPORT>
                     <SUPPORTED-CONFIG-VARIANTS>
                        <SUPPORTED-CONFIG-VARIANT>VARIANT-PRE-COMPILE</SUPPORTED-CONFIG-VARIANT>
                     </SUPPORTED-CONFIG-VARIANTS>
                     <CONTAINERS>
                        <!-- Container Definition: EthTSynGeneral -->
                        <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:4abfff0e-f4a2-4116-9884-99088bd9f63c">
                           <SHORT-NAME>EthTSynGeneral</SHORT-NAME>
                           <DESC>
                              <L-2 L="EN">This container holds the general parameters of the Ethernet-specific Synchronized Time-base Manager</L-2>
                           </DESC>
                           <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_EthTSyn_00003</RELATED-TRACE-ITEM-REF>
                           <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                           <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                           <PARAMETERS>
                              <!-- PARAMETER DEFINITION: EthTSynDevErrorDetect -->
                              <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:97c1bf48-863c-4419-bdfa-7a95e310d14b">
                                 <SHORT-NAME>EthTSynDevErrorDetect</SHORT-NAME>
                                 <DESC>
                                    <L-2 L="EN">Switches the Default Error Tracer (Det) detection and notification ON or OFF.</L-2>
                                 </DESC>
                                 <INTRODUCTION>
                                    <P>
                                       <L-1 L="EN">* true: enabled (ON).
                                        * false: disabled (OFF).</L-1>
                                    </P>
                                 </INTRODUCTION>
                                 <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_EthTSyn_00002</RELATED-TRACE-ITEM-REF>
                                 <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                 <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                 <SCOPE>LOCAL</SCOPE>
                                 <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                 <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                 <VALUE-CONFIG-CLASSES>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                       <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                       <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                 </VALUE-CONFIG-CLASSES>
                                 <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                              </ECUC-BOOLEAN-PARAM-DEF>
                              <!-- PARAMETER DEFINITION: EthTSynHardwareTimestampSupport -->
                              <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:3f62e37c-2192-48e6-8a7c-55c0e9390d01">
                                 <SHORT-NAME>EthTSynHardwareTimestampSupport</SHORT-NAME>
                                 <DESC>
                                    <L-2 L="EN">Activate/Deactivate the hardware time stamping functionality of the Ethernet hardware.</L-2>
                                 </DESC>
                                 <INTRODUCTION>
                                    <P>
                                       <L-1 L="EN">True: Timestamp is retrieved from the Ethernet hardware
                                        False: Timestamp is retrieved from the StbM</L-1>
                                    </P>
                                 </INTRODUCTION>
                                 <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_EthTSyn_00018</RELATED-TRACE-ITEM-REF>
                                 <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                 <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                 <SCOPE>LOCAL</SCOPE>
                                 <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                 <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                 <VALUE-CONFIG-CLASSES>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                       <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                       <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                 </VALUE-CONFIG-CLASSES>
                                 <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                              </ECUC-BOOLEAN-PARAM-DEF>
                              <!-- PARAMETER DEFINITION: EthTSynMainFunctionPeriod -->
                              <ECUC-FLOAT-PARAM-DEF UUID="ECUC:7b8bdf27-fc9a-4fbc-97bd-7a50abb0fa2e">
                                 <SHORT-NAME>EthTSynMainFunctionPeriod</SHORT-NAME>
                                 <DESC>
                                    <L-2 L="EN">Schedule period of the main function EthTSyn_MainFunction. Unit: [s].</L-2>
                                 </DESC>
                                 <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_EthTSyn_00012</RELATED-TRACE-ITEM-REF>
                                 <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                 <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                 <SCOPE>LOCAL</SCOPE>
                                 <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                 <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                 <VALUE-CONFIG-CLASSES>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                       <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                       <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                 </VALUE-CONFIG-CLASSES>
                                 <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                 <MAX>Inf</MAX>
                                 <MIN>0</MIN>
                              </ECUC-FLOAT-PARAM-DEF>
                              <!-- PARAMETER DEFINITION: EthTSynVersionInfo -->
                              <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:b2dd9067-201b-46f0-97fb-f28dd9b030d8">
                                 <SHORT-NAME>EthTSynVersionInfo</SHORT-NAME>
                                 <DESC>
                                    <L-2 L="EN">Activate/Deactivate the version information API (EthTSyn_GetVersionInfo). True: version information API activated False: version information API deactivated.</L-2>
                                 </DESC>
                                 <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_EthTSyn_00015</RELATED-TRACE-ITEM-REF>
                                 <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                 <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                 <SCOPE>LOCAL</SCOPE>
                                 <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                 <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                 <VALUE-CONFIG-CLASSES>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                       <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                       <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                 </VALUE-CONFIG-CLASSES>
                                 <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                              </ECUC-BOOLEAN-PARAM-DEF>
                           </PARAMETERS>
                        </ECUC-PARAM-CONF-CONTAINER-DEF>
                        <!-- Container Definition: EthTSynGlobalTimeDomain -->
                        <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:ee0c077f-5d03-463d-9144-6a3c3f3bc7ef">
                           <SHORT-NAME>EthTSynGlobalTimeDomain</SHORT-NAME>
                           <DESC>
                              <L-2 L="EN">This represents the existence of a global time domain on Ethernet. The EthTSyn module can administrate several global time domains at the same time that in itself form a hierarchy of domains and sub-domains.</L-2>
                           </DESC>
                           <INTRODUCTION>
                              <P>
                                 <L-1 L="EN">If the EthTSyn exists it is assumed that at least one global time domain exists.</L-1>
                              </P>
                           </INTRODUCTION>
                           <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_EthTSyn_00004</RELATED-TRACE-ITEM-REF>
                           <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                           <UPPER-MULTIPLICITY-INFINITE>true</UPPER-MULTIPLICITY-INFINITE>
                           <PARAMETERS>
                              <!-- PARAMETER DEFINITION: EthTSynGlobalTimeDomainId -->
                              <ECUC-INTEGER-PARAM-DEF UUID="ECUC:ff017776-276e-443f-a9d2-7abe546ebf62">
                                 <SHORT-NAME>EthTSynGlobalTimeDomainId</SHORT-NAME>
                                 <DESC>
                                    <L-2 L="EN">This Parameter is deprecated and will be removed in future.</L-2>
                                    <L-2 L="EN">Tags: atp.Status=obsolete, atp.StatusRevisionBegin=4.2.2</L-2>
                                 </DESC>
                                 <INTRODUCTION>
                                    <P>
                                       <L-1 L="EN">Old description: The global time domain ID.</L-1>
                                    </P>
                                    <P>
                                       <L-1 L="EN">This element is obsolete and will be removed in a future revision.</L-1>
                                    </P>
                                 </INTRODUCTION>
                                 <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_EthTSyn_00005</RELATED-TRACE-ITEM-REF>
                                 <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                 <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                 <SCOPE>LOCAL</SCOPE>
                                 <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                 <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                 <VALUE-CONFIG-CLASSES>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                       <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                       <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                 </VALUE-CONFIG-CLASSES>
                                 <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                 <MAX>31</MAX>
                                 <MIN>0</MIN>
                              </ECUC-INTEGER-PARAM-DEF>
                              <!-- PARAMETER DEFINITION: EthTSynGlobalTimeFollowUpTimeout -->
                              <ECUC-FLOAT-PARAM-DEF UUID="ECUC:adab14e1-14ee-447e-a1c8-ead773249f38">
                                 <SHORT-NAME>EthTSynGlobalTimeFollowUpTimeout</SHORT-NAME>
                                 <DESC>
                                    <L-2 L="EN"/>
                                 </DESC>
                                 <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_EthTSyn_00007</RELATED-TRACE-ITEM-REF>
                                 <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                 <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                 <SCOPE>LOCAL</SCOPE>
                                 <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                 <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                 <VALUE-CONFIG-CLASSES>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                       <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                       <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                 </VALUE-CONFIG-CLASSES>
                                 <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                 <MAX>Inf</MAX>
                                 <MIN>0</MIN>
                              </ECUC-FLOAT-PARAM-DEF>
                           </PARAMETERS>
                           <REFERENCES>
                              <!-- Symbolic Name Reference Definition: EthTSynSynchronizedTimeBaseRef -->
                              <ECUC-SYMBOLIC-NAME-REFERENCE-DEF UUID="ECUC:e2e57238-23bd-4436-8aac-2b4dac409201">
                                 <SHORT-NAME>EthTSynSynchronizedTimeBaseRef</SHORT-NAME>
                                 <DESC>
                                    <L-2 L="EN">Mandatory reference to the required synchronized time-base.</L-2>
                                 </DESC>
                                 <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_EthTSyn_00013</RELATED-TRACE-ITEM-REF>
                                 <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                 <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                 <SCOPE>LOCAL</SCOPE>
                                 <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                 <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                 <VALUE-CONFIG-CLASSES>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                       <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                       <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                 </VALUE-CONFIG-CLASSES>
                                 <DESTINATION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/AUTOSAR/EcucDefs/StbM/StbMSynchronizedTimeBase</DESTINATION-REF>
                              </ECUC-SYMBOLIC-NAME-REFERENCE-DEF>
                           </REFERENCES>
                           <SUB-CONTAINERS>
                              <!-- Container Definition: EthTSynGlobalTimeMaster -->
                              <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:20d1e409-b2eb-4086-bbe6-0525aff7c21c">
                                 <SHORT-NAME>EthTSynGlobalTimeMaster</SHORT-NAME>
                                 <DESC>
                                    <L-2 L="EN">Configuration of the global time master. Each global time domain is required to have exactly one global time master. This master may or may not exist on the configured ECU.</L-2>
                                 </DESC>
                                 <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_EthTSyn_00008</RELATED-TRACE-ITEM-REF>
                                 <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                 <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                 <PARAMETERS>
                                    <!-- PARAMETER DEFINITION: EthTSynGlobalTimeTxFollowUpOffset -->
                                    <ECUC-FLOAT-PARAM-DEF UUID="ECUC:144256e5-4ef8-8799-714a-f1273c3b0ee6">
                                       <SHORT-NAME>EthTSynGlobalTimeTxFollowUpOffset</SHORT-NAME>
                                       <DESC>
                                          <L-2 L="EN">This represents configuration of the TX offset for Follow_Up / Pdelay_Resp_Follow_Up messages. Unit: seconds</L-2>
                                       </DESC>
                                       <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_EthTSyn_00020</RELATED-TRACE-ITEM-REF>
                                       <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                       <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                       <SCOPE>LOCAL</SCOPE>
                                       <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                       <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                       <VALUE-CONFIG-CLASSES>
                                          <ECUC-VALUE-CONFIGURATION-CLASS>
                                             <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                             <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                          </ECUC-VALUE-CONFIGURATION-CLASS>
                                       </VALUE-CONFIG-CLASSES>
                                       <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                       <MAX>Inf</MAX>
                                       <MIN>0</MIN>
                                    </ECUC-FLOAT-PARAM-DEF>
                                    <!-- PARAMETER DEFINITION: EthTSynGlobalTimeTxPdelayReqPeriod -->
                                    <ECUC-FLOAT-PARAM-DEF UUID="ECUC:20432b32-7ee2-81fc-6476-e8f0ef2d1ef4">
                                       <SHORT-NAME>EthTSynGlobalTimeTxPdelayReqPeriod</SHORT-NAME>
                                       <DESC>
                                          <L-2 L="EN">This represents configuration of the TX period for Pdelay_Req messages. Unit: seconds</L-2>
                                       </DESC>
                                       <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_EthTSyn_00019</RELATED-TRACE-ITEM-REF>
                                       <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                       <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                       <SCOPE>LOCAL</SCOPE>
                                       <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                       <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                       <VALUE-CONFIG-CLASSES>
                                          <ECUC-VALUE-CONFIGURATION-CLASS>
                                             <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                             <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                          </ECUC-VALUE-CONFIGURATION-CLASS>
                                       </VALUE-CONFIG-CLASSES>
                                       <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                       <MAX>Inf</MAX>
                                       <MIN>0</MIN>
                                    </ECUC-FLOAT-PARAM-DEF>
                                    <!-- PARAMETER DEFINITION: EthTSynGlobalTimeTxPeriod -->
                                    <ECUC-FLOAT-PARAM-DEF UUID="ECUC:895a28b4-2c4e-4b59-ac47-70aadc1de237">
                                       <SHORT-NAME>EthTSynGlobalTimeTxPeriod</SHORT-NAME>
                                       <DESC>
                                          <L-2 L="EN">This represents configuration of the TX period. Unit: seconds</L-2>
                                       </DESC>
                                       <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_EthTSyn_00010</RELATED-TRACE-ITEM-REF>
                                       <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                       <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                       <SCOPE>LOCAL</SCOPE>
                                       <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                       <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                       <VALUE-CONFIG-CLASSES>
                                          <ECUC-VALUE-CONFIGURATION-CLASS>
                                             <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                             <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                          </ECUC-VALUE-CONFIGURATION-CLASS>
                                       </VALUE-CONFIG-CLASSES>
                                       <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                       <MAX>Inf</MAX>
                                       <MIN>0</MIN>
                                    </ECUC-FLOAT-PARAM-DEF>
                                 </PARAMETERS>
                                 <REFERENCES>
                                    <!-- Reference Definition: EthTSynGlobalTimeEthIfRef -->
                                    <ECUC-REFERENCE-DEF UUID="ECUC:c6496c14-1aaf-8d15-615b-86889b88b373">
                                       <SHORT-NAME>EthTSynGlobalTimeEthIfRef</SHORT-NAME>
                                       <DESC>
                                          <L-2 L="EN">This represents the reference to the Ethernet interface taken to fetch the global time information.</L-2>
                                       </DESC>
                                       <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_EthTSyn_00016</RELATED-TRACE-ITEM-REF>
                                       <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                       <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                       <SCOPE>LOCAL</SCOPE>
                                       <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                       <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                       <VALUE-CONFIG-CLASSES>
                                          <ECUC-VALUE-CONFIGURATION-CLASS>
                                             <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                             <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                          </ECUC-VALUE-CONFIGURATION-CLASS>
                                       </VALUE-CONFIG-CLASSES>
                                       <DESTINATION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/AUTOSAR/EcucDefs/EthIf/EthIfConfigSet/EthIfController</DESTINATION-REF>
                                    </ECUC-REFERENCE-DEF>
                                 </REFERENCES>
                              </ECUC-PARAM-CONF-CONTAINER-DEF>
                              <!-- Container Definition: EthTSynGlobalTimeSlave -->
                              <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:06ad6036-fb6a-450e-a8c1-7509babd6012">
                                 <SHORT-NAME>EthTSynGlobalTimeSlave</SHORT-NAME>
                                 <DESC>
                                    <L-2 L="EN">Configuration of a time slave. Each global time domain is required to have at least one time slave. The configured ECU may or may not represent a time slave.</L-2>
                                 </DESC>
                                 <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_EthTSyn_00009</RELATED-TRACE-ITEM-REF>
                                 <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                 <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                 <PARAMETERS>
                                    <!-- PARAMETER DEFINITION: EthTSynGlobalTimeTxFollowUpOffset -->
                                    <ECUC-FLOAT-PARAM-DEF UUID="ECUC:fa1dd312-9777-8c21-5e26-610b4700acdc">
                                       <SHORT-NAME>EthTSynGlobalTimeTxFollowUpOffset</SHORT-NAME>
                                       <DESC>
                                          <L-2 L="EN">This represents configuration of the TX offset for Follow_Up / Pdelay_Resp_Follow_Up messages. Unit: seconds</L-2>
                                       </DESC>
                                       <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_EthTSyn_00022</RELATED-TRACE-ITEM-REF>
                                       <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                       <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                       <SCOPE>LOCAL</SCOPE>
                                       <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                       <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                       <VALUE-CONFIG-CLASSES>
                                          <ECUC-VALUE-CONFIGURATION-CLASS>
                                             <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                             <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                          </ECUC-VALUE-CONFIGURATION-CLASS>
                                       </VALUE-CONFIG-CLASSES>
                                       <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                       <MAX>Inf</MAX>
                                       <MIN>0</MIN>
                                    </ECUC-FLOAT-PARAM-DEF>
                                    <!-- PARAMETER DEFINITION: EthTSynGlobalTimeTxPdelayReqPeriod -->
                                    <ECUC-FLOAT-PARAM-DEF UUID="ECUC:061ea75f-c761-8684-5152-58d4f9f2bcea">
                                       <SHORT-NAME>EthTSynGlobalTimeTxPdelayReqPeriod</SHORT-NAME>
                                       <DESC>
                                          <L-2 L="EN">This represents configuration of the TX period for Pdelay_Req messages. Unit: seconds</L-2>
                                       </DESC>
                                       <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_EthTSyn_00021</RELATED-TRACE-ITEM-REF>
                                       <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                       <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                       <SCOPE>LOCAL</SCOPE>
                                       <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                       <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                       <VALUE-CONFIG-CLASSES>
                                          <ECUC-VALUE-CONFIGURATION-CLASS>
                                             <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                             <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                          </ECUC-VALUE-CONFIGURATION-CLASS>
                                       </VALUE-CONFIG-CLASSES>
                                       <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                       <MAX>Inf</MAX>
                                       <MIN>0</MIN>
                                    </ECUC-FLOAT-PARAM-DEF>
                                    <!-- PARAMETER DEFINITION: EthTSynTimeHardwareCorrectionThreshold -->
                                    <ECUC-FLOAT-PARAM-DEF UUID="ECUC:b7b5155b-b081-440e-9987-7ec76ab8e9d9">
                                       <SHORT-NAME>EthTSynTimeHardwareCorrectionThreshold</SHORT-NAME>
                                       <DESC>
                                          <L-2 L="EN">This parameter can be taken to define the maximum deviation between the local time and the time obtained from SYNC message that triggers a correction of the time drift caused by the hardware on the local node.</L-2>
                                       </DESC>
                                       <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_EthTSyn_00014</RELATED-TRACE-ITEM-REF>
                                       <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                       <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                       <SCOPE>LOCAL</SCOPE>
                                       <MULTIPLICITY-CONFIG-CLASSES>
                                          <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                             <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                             <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                          </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                       </MULTIPLICITY-CONFIG-CLASSES>
                                       <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                       <POST-BUILD-VARIANT-MULTIPLICITY>false</POST-BUILD-VARIANT-MULTIPLICITY>
                                       <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                       <VALUE-CONFIG-CLASSES>
                                          <ECUC-VALUE-CONFIGURATION-CLASS>
                                             <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                             <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                          </ECUC-VALUE-CONFIGURATION-CLASS>
                                       </VALUE-CONFIG-CLASSES>
                                       <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                    </ECUC-FLOAT-PARAM-DEF>
                                 </PARAMETERS>
                                 <REFERENCES>
                                    <!-- Reference Definition: EthTSynGlobalTimeEthIfRef -->
                                    <ECUC-REFERENCE-DEF UUID="ECUC:ac24e841-632e-919d-4e36-f66ca64e5169">
                                       <SHORT-NAME>EthTSynGlobalTimeEthIfRef</SHORT-NAME>
                                       <DESC>
                                          <L-2 L="EN">This represents the reference to the Ethernet interface taken to fetch the global time information.</L-2>
                                       </DESC>
                                       <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_EthTSyn_00017</RELATED-TRACE-ITEM-REF>
                                       <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                       <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                       <SCOPE>LOCAL</SCOPE>
                                       <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                       <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                       <VALUE-CONFIG-CLASSES>
                                          <ECUC-VALUE-CONFIGURATION-CLASS>
                                             <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                             <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                          </ECUC-VALUE-CONFIGURATION-CLASS>
                                       </VALUE-CONFIG-CLASSES>
                                       <DESTINATION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/AUTOSAR/EcucDefs/EthIf/EthIfConfigSet/EthIfController</DESTINATION-REF>
                                    </ECUC-REFERENCE-DEF>
                                 </REFERENCES>
                              </ECUC-PARAM-CONF-CONTAINER-DEF>
                           </SUB-CONTAINERS>
                        </ECUC-PARAM-CONF-CONTAINER-DEF>
                     </CONTAINERS>
                  </ECUC-MODULE-DEF>
                  <!-- Module Definition: EthTrcv -->
                  <ECUC-MODULE-DEF UUID="ECUC:8a2137e1-bc21-4205-904d-0ffa23a64aee">
                     <SHORT-NAME>EthTrcv</SHORT-NAME>
                     <DESC>
                        <L-2 L="EN">Configuration of Ethernet Transceiver Driver module</L-2>
                     </DESC>
                     <ADMIN-DATA>
                        <DOC-REVISIONS>
                           <DOC-REVISION>
                              <REVISION-LABEL>4.2.2</REVISION-LABEL>
                              <ISSUED-BY>AUTOSAR</ISSUED-BY>
                              <DATE>2014-10-31</DATE>
                           </DOC-REVISION>
                        </DOC-REVISIONS>
                     </ADMIN-DATA>
                     <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                     <UPPER-MULTIPLICITY-INFINITE>true</UPPER-MULTIPLICITY-INFINITE>
                     <POST-BUILD-VARIANT-SUPPORT>true</POST-BUILD-VARIANT-SUPPORT>
                     <SUPPORTED-CONFIG-VARIANTS>
                        <SUPPORTED-CONFIG-VARIANT>VARIANT-LINK-TIME</SUPPORTED-CONFIG-VARIANT>
                        <SUPPORTED-CONFIG-VARIANT>VARIANT-POST-BUILD</SUPPORTED-CONFIG-VARIANT>
                        <SUPPORTED-CONFIG-VARIANT>VARIANT-PRE-COMPILE</SUPPORTED-CONFIG-VARIANT>
                     </SUPPORTED-CONFIG-VARIANTS>
                     <CONTAINERS>
                        <!-- Container Definition: EthTrcvConfigSet -->
                        <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:9ae2997a-58f0-41bb-9d5e-0ca61818ef46">
                           <SHORT-NAME>EthTrcvConfigSet</SHORT-NAME>
                           <DESC>
                              <L-2 L="EN">This container contains the configuration parameters and sub containers of the AUTOSAR EthTrcv module.</L-2>
                           </DESC>
                           <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_EthTrcv_00016</RELATED-TRACE-ITEM-REF>
                           <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                           <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                           <SUB-CONTAINERS>
                              <!-- Container Definition: EthTrcvConfig -->
                              <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:d73b4a97-6573-48c2-9220-27f3cbd1c8b9">
                                 <SHORT-NAME>EthTrcvConfig</SHORT-NAME>
                                 <DESC>
                                    <L-2 L="EN">Configuration of the individual transceiver</L-2>
                                 </DESC>
                                 <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_EthTrcv_00012</RELATED-TRACE-ITEM-REF>
                                 <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                 <UPPER-MULTIPLICITY-INFINITE>true</UPPER-MULTIPLICITY-INFINITE>
                                 <PARAMETERS>
                                    <!-- PARAMETER DEFINITION: EthTrcvAutoNegotiationEnabled -->
                                    <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:90e21e15-d837-4125-9d89-59ecb4250959">
                                       <SHORT-NAME>EthTrcvAutoNegotiationEnabled</SHORT-NAME>
                                       <DESC>
                                          <L-2 L="EN">Specifies if Auto-Negotiation is enabled (TRUE) or disabled (FALSE) for determination of the Ethernet transceiver speed.</L-2>
                                       </DESC>
                                       <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_EthTrcv_00021</RELATED-TRACE-ITEM-REF>
                                       <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                       <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                       <SCOPE>LOCAL</SCOPE>
                                       <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                       <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                                       <VALUE-CONFIG-CLASSES>
                                          <ECUC-VALUE-CONFIGURATION-CLASS>
                                             <CONFIG-CLASS>LINK</CONFIG-CLASS>
                                             <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                                          </ECUC-VALUE-CONFIGURATION-CLASS>
                                          <ECUC-VALUE-CONFIGURATION-CLASS>
                                             <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                             <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                          </ECUC-VALUE-CONFIGURATION-CLASS>
                                          <ECUC-VALUE-CONFIGURATION-CLASS>
                                             <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                             <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                          </ECUC-VALUE-CONFIGURATION-CLASS>
                                       </VALUE-CONFIG-CLASSES>
                                       <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                    </ECUC-BOOLEAN-PARAM-DEF>
                                    <!-- PARAMETER DEFINITION: EthTrcvConnNeg -->
                                    <ECUC-ENUMERATION-PARAM-DEF UUID="ECUC:9c0b90fa-2691-481b-af25-f3afc1e15cc2">
                                       <SHORT-NAME>EthTrcvConnNeg</SHORT-NAME>
                                       <DESC>
                                          <L-2 L="EN">Specifies the connection negotiation of the Ethernet transceiver link.</L-2>
                                       </DESC>
                                       <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_EthTrcv_00025</RELATED-TRACE-ITEM-REF>
                                       <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                       <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                       <SCOPE>LOCAL</SCOPE>
