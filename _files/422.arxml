                                                </ECUC-BOOLEAN-PARAM-DEF>
                                                <!-- PARAMETER DEFINITION: FrNmRxPduContainsVote -->
                                                <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:55b5885d-6ec5-4dd2-bcdf-24c305343e53">
                                                   <SHORT-NAME>FrNmRxPduContainsVote</SHORT-NAME>
                                                   <DESC>
                                                      <L-2 L="EN">This parameter defines if the PDU contains NM Vote information.</L-2>
                                                   </DESC>
                                                   <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_FrNm_00026</RELATED-TRACE-ITEM-REF>
                                                   <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
