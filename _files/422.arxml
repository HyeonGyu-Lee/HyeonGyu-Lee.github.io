                                       <SHORT-NAME>SdServerTimer</SHORT-NAME>
                                       <DESC>
                                          <L-2 L="EN">This container specifies all timers used by the Service Discovery module for Server Services.</L-2>
                                       </DESC>
                                       <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_SD_00035</RELATED-TRACE-ITEM-REF>
                                       <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                       <UPPER-MULTIPLICITY-INFINITE>true</UPPER-MULTIPLICITY-INFINITE>
