                              <!-- PARAMETER DEFINITION: ComRetryFailedTransmitRequests -->
                              <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:2200aba4-3c6c-4fc4-818a-f5c1d08fd959">
                                 <SHORT-NAME>ComRetryFailedTransmitRequests</SHORT-NAME>
                                 <DESC>
                                    <L-2 L="EN">If this Parameter is set to true, retry of failed transmission requests is enabled. If this Parameter is not present, the default value is assumed.</L-2>
                                 </DESC>
                                 <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_Com_00780</RELATED-TRACE-ITEM-REF>
                                 <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
