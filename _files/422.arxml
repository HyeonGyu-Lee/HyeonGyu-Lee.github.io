                                       <SUB-CONTAINERS>
                                          <!-- Container Definition: FrNmPnFilterMaskByte -->
                                          <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:91459ad1-8fd1-4332-8c12-48678acedb89">
                                             <SHORT-NAME>FrNmPnFilterMaskByte</SHORT-NAME>
                                             <DESC>
                                                <L-2 L="EN">Filter mask byte configuration</L-2>
                                             </DESC>
                                             <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_FrNm_00064</RELATED-TRACE-ITEM-REF>
                                             <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                             <UPPER-MULTIPLICITY>7</UPPER-MULTIPLICITY>
                                             <PARAMETERS>
                                                <!-- PARAMETER DEFINITION: FrNmPnFilterMaskByteIndex -->
                                                <ECUC-INTEGER-PARAM-DEF UUID="ECUC:4adc8277-4162-45d5-9f9e-abc1ef4db5c9">
                                                   <SHORT-NAME>FrNmPnFilterMaskByteIndex</SHORT-NAME>
