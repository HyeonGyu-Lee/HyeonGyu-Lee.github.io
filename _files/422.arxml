                                             <PARAMETERS>
                                                <!-- PARAMETER DEFINITION: SdEventHandlerEventGroupId -->
                                                <ECUC-INTEGER-PARAM-DEF UUID="ECUC:f35274e5-c81e-46db-85e0-c8c87a035ceb">
                                                   <SHORT-NAME>SdEventHandlerEventGroupId</SHORT-NAME>
                                                   <DESC>
                                                      <L-2 L="EN">The EventGroup Id of this EventGroup as a unique identifier of the EventGroup in this service. This identifier is used for EventGroup entries as well.</L-2>
                                                   </DESC>
                                                   <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_SD_00061</RELATED-TRACE-ITEM-REF>
