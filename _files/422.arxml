                                          <ECUC-INTEGER-PARAM-DEF UUID="ECUC:8ae91b97-426b-dd08-ed31-f53047ce48f8">
                                             <SHORT-NAME>FlsTstNumberOfTestedCells</SHORT-NAME>
                                             <DESC>
                                                <L-2 L="EN">Configures the Number of cells to be tested in background mode during one scheduled task (FlsTst_MainFunction() call).</L-2>
                                                <L-2 L="EN">Tags: atp.Status=obsolete, atp.StatusRevisionBegin=4.2.2</L-2>
                                             </DESC>
                                             <INTRODUCTION>
                                                <P>
                                                   <L-1 L="EN">Please note that this parameter is deprecated and is replaced by the FlsTstNumberOfTestedCells parameter in the FlsTstGeneral container.</L-1>
                                                </P>
                                                <P>
                                                   <L-1 L="EN">This element is obsolete and will be removed in a future revision.</L-1>
                                                </P>
                                             </INTRODUCTION>
                                             <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_FlsTst_00119</RELATED-TRACE-ITEM-REF>
