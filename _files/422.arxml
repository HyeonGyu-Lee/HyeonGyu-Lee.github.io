                                          <!-- PARAMETER DEFINITION: FrNmCarWakeUpRxEnabled -->
                                          <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:26b48e2c-d069-4791-8ad8-2dd5841736d6">
                                             <SHORT-NAME>FrNmCarWakeUpRxEnabled</SHORT-NAME>
                                             <DESC>
                                                <L-2 L="EN">Enables or disables support of CarWakeUp bit evaluation in received NM messages.</L-2>
                                             </DESC>
                                             <INTRODUCTION>
                                                <P>
                                                   <L-1 L="EN">FALSE - CarWakeUp not supported
                                                        TRUE - CarWakeUp supported</L-1>
                                                </P>
                                             </INTRODUCTION>
