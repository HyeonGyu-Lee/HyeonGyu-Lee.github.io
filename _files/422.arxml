                                             <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                          </ECUC-VALUE-CONFIGURATION-CLASS>
                                       </VALUE-CONFIG-CLASSES>
                                       <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                       <DEFAULT-VALUE>false</DEFAULT-VALUE>
                                    </ECUC-BOOLEAN-PARAM-DEF>
                                    <!-- PARAMETER DEFINITION: DbgStaticDIDNameRef -->
                                    <ECUC-STRING-PARAM-DEF UUID="ECUC:f18b6408-8c09-4aeb-ba6c-58ba776b15d3">
                                       <SHORT-NAME>DbgStaticDIDNameRef</SHORT-NAME>
                                       <DESC>
                                          <L-2 L="EN">Name of the DID, translated by the configuration/generation tool into consecutive DID numbers starting from 0.</L-2>
                                       </DESC>
                                       <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_Dbg_00830</RELATED-TRACE-ITEM-REF>
