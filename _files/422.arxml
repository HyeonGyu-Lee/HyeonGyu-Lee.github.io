                                                               <L-1 L="EN">[RFC4861 5.1. Conceptual Data Structures]</L-1>
                                                            </P>
                                                         </INTRODUCTION>
                                                         <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_TcpIp_00138</RELATED-TRACE-ITEM-REF>
