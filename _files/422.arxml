                                          <!-- Symbolic Name Reference Definition: FrNmChannelHandle -->
                                          <ECUC-SYMBOLIC-NAME-REFERENCE-DEF UUID="ECUC:d88b8b09-0d28-40bb-89e5-84fefce71b68">
                                             <SHORT-NAME>FrNmChannelHandle</SHORT-NAME>
                                             <DESC>
                                                <L-2 L="EN">Channel identifier configured for the respective instance of the NM.</L-2>
                                             </DESC>
                                             <INTRODUCTION>
                                                <P>
                                                   <L-1 L="EN">The FrNmChannelHandle shall be encoded in the FrNmRxPduId parameter which is passed to FrNm_RxIndication() function called by the FrIf.</L-1>
                                                </P>
                                             </INTRODUCTION>
                                             <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_FrNm_00013</RELATED-TRACE-ITEM-REF>
