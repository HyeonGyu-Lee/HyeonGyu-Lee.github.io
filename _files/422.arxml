                                    </ECUC-ENUMERATION-PARAM-DEF>
                                    <!-- PARAMETER DEFINITION: ComMCDDBusPrefix -->
                                    <ECUC-STRING-PARAM-DEF UUID="ECUC:50ca2f58-6059-4ee9-ba5e-7066c3d8a7ec">
                                       <SHORT-NAME>ComMCDDBusPrefix</SHORT-NAME>
                                       <DESC>
                                          <L-2 L="EN">Prefix to be used for API calls to CDD.</L-2>
                                       </DESC>
                                       <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_ComM_00888</RELATED-TRACE-ITEM-REF>
                                       <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                       <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                       <SCOPE>LOCAL</SCOPE>
                                       <MULTIPLICITY-CONFIG-CLASSES>
