                                                <!-- PARAMETER DEFINITION: RamTstBlockId -->
                                                <ECUC-INTEGER-PARAM-DEF UUID="ECUC:870cc0a7-22ab-4ec1-a6c3-bbdd1f48186a">
                                                   <SHORT-NAME>RamTstBlockId</SHORT-NAME>
