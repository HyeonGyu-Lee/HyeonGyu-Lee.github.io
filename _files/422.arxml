                                                </ECUC-BOOLEAN-PARAM-DEF>
                                                <!-- PARAMETER DEFINITION: FrIfNoneMode -->
                                                <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:8d686556-bea1-49a2-b933-397cc46d55a2">
                                                   <SHORT-NAME>FrIfNoneMode</SHORT-NAME>
                                                   <DESC>
                                                      <L-2 L="EN">Using the "None-Mode" which means that there is no API FrIf_Transmit call of the upper layer for this PDU.</L-2>
                                                   </DESC>
                                                   <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_FrIf_06050</RELATED-TRACE-ITEM-REF>
                                                   <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
