                                                   <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                             </VALUE-CONFIG-CLASSES>
                                             <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                             <MAX>4294967295</MAX>
                                             <MIN>1</MIN>
                                          </ECUC-INTEGER-PARAM-DEF>
                                          <!-- PARAMETER DEFINITION: RamTstMaxNumberOfTestedCells -->
                                          <ECUC-INTEGER-PARAM-DEF UUID="ECUC:ed2796ab-085b-470c-b351-095568a161f2">
                                             <SHORT-NAME>RamTstMaxNumberOfTestedCells</SHORT-NAME>
                                             <DESC>
                                                <L-2 L="EN">This is the maximum value for the number of cells that can be tested in one cycle of a background test.</L-2>
                                             </DESC>
                                             <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_RamTst_00153</RELATED-TRACE-ITEM-REF>
                                             <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                             <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                             <SCOPE>LOCAL</SCOPE>
                                             <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                             <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                             <VALUE-CONFIG-CLASSES>
                                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>LINK</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                             </VALUE-CONFIG-CLASSES>
                                             <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                             <MAX>4294967295</MAX>
                                             <MIN>1</MIN>
                                          </ECUC-INTEGER-PARAM-DEF>
                                          <!-- PARAMETER DEFINITION: RamTstNumberOfBlocks -->
                                          <ECUC-INTEGER-PARAM-DEF UUID="ECUC:2e0f071e-2902-4850-a181-728a84d916b6">
                                             <SHORT-NAME>RamTstNumberOfBlocks</SHORT-NAME>
                                             <DESC>
                                                <L-2 L="EN">Number of RAM blocks configured using the container</L-2>
                                             </DESC>
                                             <INTRODUCTION>
                                                <P>
                                                   <L-1 L="EN">"RamTst_BlockParams"
                                                        calculationFormula = Count of RamTstBlockParams contained in this RamTstAlgParams.</L-1>
                                                </P>
                                             </INTRODUCTION>
                                             <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_RamTst_00141</RELATED-TRACE-ITEM-REF>
