                                                <ECUC-FOREIGN-REFERENCE-DEF UUID="ECUC:9be85ef2-5b62-4543-8feb-bc8c62192cc1">
                                                   <SHORT-NAME>DbgLocalDebugDataRef</SHORT-NAME>
