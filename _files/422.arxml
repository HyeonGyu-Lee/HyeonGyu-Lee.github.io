                              <!-- Container Definition: WdgMWatchdog -->
                              <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:406fc502-fe65-4bb3-ac8c-2c67c4dff4f3">
                                 <SHORT-NAME>WdgMWatchdog</SHORT-NAME>
                                 <DESC>
                                    <L-2 L="EN">This container collects all common (mode-independent) parameters of a Watchdog to be triggered by the Watchdog Manager.</L-2>
                                 </DESC>
                                 <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_WdgM_00347</RELATED-TRACE-ITEM-REF>
