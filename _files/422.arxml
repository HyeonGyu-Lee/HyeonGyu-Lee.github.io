                              <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:02c93db9-fc71-4592-b80c-24592e9417ac">
                                 <SHORT-NAME>RteInExclusiveAreaCheckEnabled</SHORT-NAME>
                                 <DESC>
                                    <L-2 L="EN">Enables the check for RTE_E_IN_EXCLUSIVE_AREA (for blocking APIs).</L-2>
                                 </DESC>
