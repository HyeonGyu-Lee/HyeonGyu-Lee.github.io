                              <ECUC-FLOAT-PARAM-DEF UUID="ECUC:6b1cbe0e-51af-4ec5-86db-827d9528e424">
                                 <SHORT-NAME>J1939NmBusOffDelayTickPeriod</SHORT-NAME>
                                 <DESC>
                                    <L-2 L="EN">Duration of ticks that are used to time BusOff delays after conflicting address claims. This parameter must be synchronized with the main function period of the CAN State Manager.</L-2>
                                 </DESC>
