                                    </ECUC-REFERENCE-DEF>
                                    <!-- Symbolic Name Reference Definition: UdpNmComMNetworkHandleRef -->
                                    <ECUC-SYMBOLIC-NAME-REFERENCE-DEF UUID="ECUC:bbca2ddc-438c-45cb-a7ad-a61d61c86900">
                                       <SHORT-NAME>UdpNmComMNetworkHandleRef</SHORT-NAME>
                                       <DESC>
