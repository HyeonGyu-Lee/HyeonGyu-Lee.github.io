                                          </ECUC-ENUMERATION-LITERAL-DEF>
                                       </LITERALS>
                                    </ECUC-ENUMERATION-PARAM-DEF>
                                    <!-- PARAMETER DEFINITION: XcpMaxOdt -->
                                    <ECUC-INTEGER-PARAM-DEF UUID="ECUC:deda1974-043a-400f-8998-2b69a537e7d7">
                                       <SHORT-NAME>XcpMaxOdt</SHORT-NAME>
                                       <DESC>
                                          <L-2 L="EN">MAX_ODT indicates the maximum amount of ODTs in this DAQ list</L-2>
                                       </DESC>
