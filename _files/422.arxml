                              </ECUC-BOOLEAN-PARAM-DEF>
                              <!-- PARAMETER DEFINITION: OcuVersionInfoApi -->
                              <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:aece3736-8fed-4937-8fa3-90f560dc6b2c">
                                 <SHORT-NAME>OcuVersionInfoApi</SHORT-NAME>
                                 <DESC>
                                    <L-2 L="EN">Switch to indicate that the Ocu_GetVersionInfo() is supported.</L-2>
                                 </DESC>
                                 <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_Ocu_00147</RELATED-TRACE-ITEM-REF>
                                 <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                 <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                 <SCOPE>LOCAL</SCOPE>
                                 <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                 <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
