                              <ECUC-INTEGER-PARAM-DEF UUID="ECUC:c2e5d496-ff9c-4da2-8611-9e723d1dd6e1">
                                 <SHORT-NAME>RteCodeVendorId</SHORT-NAME>
                                 <DESC>
                                    <L-2 L="EN">Holds the vendor ID of the generated Rte code.</L-2>
                                 </DESC>
