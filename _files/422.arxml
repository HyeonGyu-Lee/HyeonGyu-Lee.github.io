                           <SUB-CONTAINERS>
                              <!-- Container Definition: SdInstance -->
                              <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:3c4bbbc4-1c53-4234-a90c-9373ba4d3f3c">
                                 <SHORT-NAME>SdInstance</SHORT-NAME>
                                 <DESC>
                                    <L-2 L="EN">This container represents an instance of the SD; i.e. the SD configuration for a certain link.</L-2>
                                 </DESC>
