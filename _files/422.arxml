                                             <SHORT-NAME>FrNmControlBitVectorActive</SHORT-NAME>
                                             <DESC>
                                                <L-2 L="EN">This parameter is used to activate or deactivate the control bit vector support for a Fr Nm Channel.</L-2>
                                             </DESC>
                                             <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_FrNm_00020</RELATED-TRACE-ITEM-REF>
