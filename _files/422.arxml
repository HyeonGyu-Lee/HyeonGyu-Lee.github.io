                                    <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:3005e8e0-6faa-4028-8d6e-f680863cc62c">
                                       <SHORT-NAME>DcmDspPid</SHORT-NAME>
                                       <DESC>
                                          <L-2 L="EN">This container defines the availability of a PID to the DCM.</L-2>
                                       </DESC>
