                              <!-- Container Definition: DbgStaticDID -->
                              <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:6564daaf-5ff3-41cc-bee9-08fa2a4a5510">
                                 <SHORT-NAME>DbgStaticDID</SHORT-NAME>
                                 <DESC>
                                    <L-2 L="EN">This container holds all configuration parameters for static DIDs. For predefined DIDs, only certain values can be changed.</L-2>
                                 </DESC>
                                 <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_Dbg_00827</RELATED-TRACE-ITEM-REF>
                                 <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                 <UPPER-MULTIPLICITY>200</UPPER-MULTIPLICITY>
                                 <PARAMETERS>
                                    <!-- PARAMETER DEFINITION: DbgAutomaticCollectionFrequency -->
                                    <ECUC-INTEGER-PARAM-DEF UUID="ECUC:5c3e24cd-a31d-490c-a62c-6814fbbe89c3">
                                       <SHORT-NAME>DbgAutomaticCollectionFrequency</SHORT-NAME>
                                       <DESC>
                                          <L-2 L="EN">Cycle time of collection in DataCollectionTicks. A value of "0" indicates that the collection takes place only on request.</L-2>
                                       </DESC>
                                       <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_Dbg_00805</RELATED-TRACE-ITEM-REF>
                                       <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                       <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                       <SCOPE>LOCAL</SCOPE>
                                       <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                       <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                       <VALUE-CONFIG-CLASSES>
                                          <ECUC-VALUE-CONFIGURATION-CLASS>
                                             <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                             <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                          </ECUC-VALUE-CONFIGURATION-CLASS>
                                       </VALUE-CONFIG-CLASSES>
                                       <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                       <DEFAULT-VALUE>0</DEFAULT-VALUE>
                                       <MAX>65535</MAX>
                                       <MIN>0</MIN>
                                    </ECUC-INTEGER-PARAM-DEF>
                                    <!-- PARAMETER DEFINITION: DbgStaticDIDActivation -->
                                    <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:be7f690d-86bb-4d8a-b09b-4b4322c8d4d5">
                                       <SHORT-NAME>DbgStaticDIDActivation</SHORT-NAME>
                                       <DESC>
                                          <L-2 L="EN">Activation or not of the DID for debugging.</L-2>
                                       </DESC>
                                       <INTRODUCTION>
                                          <P>
                                             <L-1 L="EN">* true: DIDOn.
                                                * false: DIDOff.</L-1>
                                          </P>
                                       </INTRODUCTION>
                                       <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_Dbg_00828</RELATED-TRACE-ITEM-REF>
                                       <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                       <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                       <SCOPE>LOCAL</SCOPE>
                                       <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                       <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                       <VALUE-CONFIG-CLASSES>
                                          <ECUC-VALUE-CONFIGURATION-CLASS>
                                             <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                             <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                          </ECUC-VALUE-CONFIGURATION-CLASS>
                                       </VALUE-CONFIG-CLASSES>
                                       <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                       <DEFAULT-VALUE>false</DEFAULT-VALUE>
                                    </ECUC-BOOLEAN-PARAM-DEF>
                                    <!-- PARAMETER DEFINITION: DbgStaticDIDBuffering -->
                                    <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:5f00590e-2b6a-4183-b878-7aec78c1f192">
                                       <SHORT-NAME>DbgStaticDIDBuffering</SHORT-NAME>
                                       <DESC>
                                          <L-2 L="EN">Buffer the data or transmit directly.</L-2>
                                       </DESC>
                                       <INTRODUCTION>
                                          <P>
                                             <L-1 L="EN">* true: BufferingOn.
                                                * false: BufferingOff.</L-1>
                                          </P>
                                       </INTRODUCTION>
                                       <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_Dbg_00829</RELATED-TRACE-ITEM-REF>
                                       <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                       <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                       <SCOPE>LOCAL</SCOPE>
                                       <ORIGIN>AUTOSAR_ECUC</ORIGIN>
