                        <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:54d36a7e-56c3-496e-ab52-8668a8543286">
                           <SHORT-NAME>J1939DcmConfigSet</SHORT-NAME>
                           <DESC>
