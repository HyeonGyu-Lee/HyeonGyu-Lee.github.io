                                    <!-- PARAMETER DEFINITION: FrSMTrcvStdbyDelay -->
                                    <ECUC-FLOAT-PARAM-DEF UUID="ECUC:6e6d4f2d-77c9-4b3b-a051-4f42b4e97849">
                                       <SHORT-NAME>FrSMTrcvStdbyDelay</SHORT-NAME>
                                       <DESC>
                                          <L-2 L="EN">The duration of timer t_TrcvStdbyDelay in seconds. The granularity of this parameter shall be restricted to full FlexRay cycles (FrIfGdCycle).</L-2>
                                       </DESC>
                                       <INTRODUCTION>
                                          <P>
                                             <L-1 L="EN">A value of 0 shall imply that the timer is not used.</L-1>
                                          </P>
                                       </INTRODUCTION>
                                       <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_FrSM_00170</RELATED-TRACE-ITEM-REF>
