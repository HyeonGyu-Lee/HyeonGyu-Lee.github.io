                              <ECUC-ENUMERATION-PARAM-DEF UUID="ECUC:2906b28a-56d2-42e4-b090-35c9cc671503">
                                 <SHORT-NAME>EthTrcvWakeUpSupport</SHORT-NAME>
                                 <DESC>
                                    <L-2 L="EN">Configures wake-up to polling or interrupt or to not used/not supported. In case no wake up is supported by the hardware, the BSWMD pre-configuration shall be set to ETHTRCV_WAKEUP_NOT_SUPPORTED.</L-2>
                                 </DESC>
                                 <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_EthTrcv_00030</RELATED-TRACE-ITEM-REF>
