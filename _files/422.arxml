                                                   <DESTINATION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/AUTOSAR/EcucDefs/FrTrcv/FrTrcvChannel</DESTINATION-REF>
                                                </ECUC-SYMBOLIC-NAME-REFERENCE-DEF>
                                             </REFERENCES>
