                        <!-- Container Definition: DbgGeneral -->
                        <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:e08d9312-2e84-4b33-9269-9d8c45f325e8">
                           <SHORT-NAME>DbgGeneral</SHORT-NAME>
                           <DESC>
                              <L-2 L="EN">This container holds the general parameters of the debugging module.</L-2>
                           </DESC>
                           <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_Dbg_00813</RELATED-TRACE-ITEM-REF>
                           <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                           <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                           <PARAMETERS>
                              <!-- PARAMETER DEFINITION: DbgDevErrorDetect -->
                              <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:ad35a742-5ad7-439a-9794-45b351b1fa83">
                                 <SHORT-NAME>DbgDevErrorDetect</SHORT-NAME>
                                 <DESC>
                                    <L-2 L="EN">Switches the Default Error Tracer (Det) detection and notification ON or OFF.</L-2>
                                 </DESC>
                                 <INTRODUCTION>
                                    <P>
                                       <L-1 L="EN">* true: enabled (ON).
                                        * false: disabled (OFF).</L-1>
                                    </P>
                                 </INTRODUCTION>
                                 <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_Dbg_00812</RELATED-TRACE-ITEM-REF>
                                 <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                 <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                 <SCOPE>LOCAL</SCOPE>
                                 <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                 <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                 <VALUE-CONFIG-CLASSES>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                       <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                       <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                 </VALUE-CONFIG-CLASSES>
                                 <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                              </ECUC-BOOLEAN-PARAM-DEF>
                              <!-- PARAMETER DEFINITION: DbgHeaderFileInclusion -->
                              <ECUC-STRING-PARAM-DEF UUID="ECUC:e7253f4f-b4ab-4a1e-91e2-cfeed9af7006">
                                 <SHORT-NAME>DbgHeaderFileInclusion</SHORT-NAME>
                                 <DESC>
                                    <L-2 L="EN">Name of the header file(s) to be included by the Dbg module.</L-2>
                                 </DESC>
                                 <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_Dbg_00868</RELATED-TRACE-ITEM-REF>
                                 <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                 <UPPER-MULTIPLICITY-INFINITE>true</UPPER-MULTIPLICITY-INFINITE>
                                 <SCOPE>LOCAL</SCOPE>
                                 <MULTIPLICITY-CONFIG-CLASSES>
                                    <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                       <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                       <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                 </MULTIPLICITY-CONFIG-CLASSES>
                                 <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                 <POST-BUILD-VARIANT-MULTIPLICITY>false</POST-BUILD-VARIANT-MULTIPLICITY>
                                 <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                 <VALUE-CONFIG-CLASSES>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                       <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                       <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                 </VALUE-CONFIG-CLASSES>
                                 <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                 <ECUC-STRING-PARAM-DEF-VARIANTS>
                                    <ECUC-STRING-PARAM-DEF-CONDITIONAL>
                                       <REGULAR-EXPRESSION>[a-zA-Z]([a-zA-Z0-9_])*\.h</REGULAR-EXPRESSION>
                                    </ECUC-STRING-PARAM-DEF-CONDITIONAL>
                                 </ECUC-STRING-PARAM-DEF-VARIANTS>
                              </ECUC-STRING-PARAM-DEF>
                              <!-- PARAMETER DEFINITION: DbgVersionInfoApi -->
                              <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:56b3a6b2-2016-4031-acbf-64554837a708">
                                 <SHORT-NAME>DbgVersionInfoApi</SHORT-NAME>
                                 <DESC>
                                    <L-2 L="EN">Activate/Deactivate the version information API (Dbg_GetVersionInfo).</L-2>
                                 </DESC>
                                 <INTRODUCTION>
                                    <P>
                                       <L-1 L="EN">* true: version information API activated.
                                        * false: version information API deactivated.</L-1>
                                    </P>
                                 </INTRODUCTION>
                                 <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_Dbg_00834</RELATED-TRACE-ITEM-REF>
                                 <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                 <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                 <SCOPE>LOCAL</SCOPE>
                                 <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                 <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                 <VALUE-CONFIG-CLASSES>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                       <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                       <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                 </VALUE-CONFIG-CLASSES>
                                 <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                              </ECUC-BOOLEAN-PARAM-DEF>
                           </PARAMETERS>
                        </ECUC-PARAM-CONF-CONTAINER-DEF>
                        <!-- Container Definition: DbgPeriodicDataCollection -->
                        <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:51c936fe-9b42-40c3-9d46-be86d581101b">
                           <SHORT-NAME>DbgPeriodicDataCollection</SHORT-NAME>
                           <DESC>
                              <L-2 L="EN">This container holds the parameters to manage the time base of the debugging module.</L-2>
                           </DESC>
                           <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_Dbg_00819</RELATED-TRACE-ITEM-REF>
                           <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                           <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                           <PARAMETERS>
                              <!-- PARAMETER DEFINITION: DbgDataCollectionTick -->
                              <ECUC-INTEGER-PARAM-DEF UUID="ECUC:4530c00b-8809-4a39-8353-c1426453bc0e">
                                 <SHORT-NAME>DbgDataCollectionTick</SHORT-NAME>
                                 <DESC>
                                    <L-2 L="EN">Number of OS counter ticks to be used as data collection tick. The OS alarm used for periodic collection of DIDs is set with this value.</L-2>
                                 </DESC>
                                 <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_Dbg_00811</RELATED-TRACE-ITEM-REF>
                                 <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                 <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                 <SCOPE>LOCAL</SCOPE>
                                 <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                 <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                 <VALUE-CONFIG-CLASSES>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                       <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                       <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                 </VALUE-CONFIG-CLASSES>
                                 <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                 <MAX>4294967295</MAX>
                                 <MIN>0</MIN>
                              </ECUC-INTEGER-PARAM-DEF>
                           </PARAMETERS>
                           <REFERENCES>
                              <!-- Reference Definition: DbgAlarmReference -->
                              <ECUC-REFERENCE-DEF UUID="ECUC:4a84a3c6-c964-4e11-a62a-3976538694b2">
                                 <SHORT-NAME>DbgAlarmReference</SHORT-NAME>
                                 <DESC>
                                    <L-2 L="EN">Reference to the OS alarm used for periodic collection of DIDs.</L-2>
                                 </DESC>
                                 <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_Dbg_00804</RELATED-TRACE-ITEM-REF>
                                 <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                 <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                 <SCOPE>LOCAL</SCOPE>
                                 <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                 <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                 <VALUE-CONFIG-CLASSES>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                       <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                       <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                 </VALUE-CONFIG-CLASSES>
                                 <DESTINATION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/AUTOSAR/EcucDefs/Os/OsAlarm</DESTINATION-REF>
                              </ECUC-REFERENCE-DEF>
                           </REFERENCES>
                        </ECUC-PARAM-CONF-CONTAINER-DEF>
                        <!-- Container Definition: DbgTimestampConfiguration -->
                        <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:a2003b89-33e4-4fba-8c20-e3b82aca9ca5">
                           <SHORT-NAME>DbgTimestampConfiguration</SHORT-NAME>
                           <DESC>
                              <L-2 L="EN">This container holds the parameters to manage the time stamps of the debugging module.</L-2>
                           </DESC>
                           <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_Dbg_00833</RELATED-TRACE-ITEM-REF>
                           <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                           <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                           <PARAMETERS>
                              <!-- PARAMETER DEFINITION: DbgGlobalTimestampActivation -->
                              <ECUC-ENUMERATION-PARAM-DEF UUID="ECUC:eb1f2eaa-27a4-4655-9abd-48d3dfebd3de">
                                 <SHORT-NAME>DbgGlobalTimestampActivation</SHORT-NAME>
                                 <DESC>
                                    <L-2 L="EN">Initial value for timestamp collection.</L-2>
                                 </DESC>
                                 <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_Dbg_00814</RELATED-TRACE-ITEM-REF>
                                 <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                 <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                 <SCOPE>LOCAL</SCOPE>
                                 <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                 <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                 <VALUE-CONFIG-CLASSES>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                       <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                       <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                 </VALUE-CONFIG-CLASSES>
                                 <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                 <DEFAULT-VALUE>TimestampOff</DEFAULT-VALUE>
                                 <LITERALS>
                                    <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:bee1665c-9f69-945b-1e7e-b45af4c833ba">
                                       <SHORT-NAME>TimestampOff</SHORT-NAME>
                                       <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                    </ECUC-ENUMERATION-LITERAL-DEF>
                                    <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:d29c33c7-fcc2-9d95-2c18-919f187b9bd2">
                                       <SHORT-NAME>TimestampOn</SHORT-NAME>
                                       <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                    </ECUC-ENUMERATION-LITERAL-DEF>
                                 </LITERALS>
                              </ECUC-ENUMERATION-PARAM-DEF>
                              <!-- PARAMETER DEFINITION: DbgTimeStampSize -->
                              <ECUC-ENUMERATION-PARAM-DEF UUID="ECUC:746409f8-40d5-45d5-bbf1-cf8273d480d8">
                                 <SHORT-NAME>DbgTimeStampSize</SHORT-NAME>
                                 <DESC>
                                    <L-2 L="EN">Memory size used for the time stamps of all DIDs.</L-2>
                                 </DESC>
                                 <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_Dbg_00832</RELATED-TRACE-ITEM-REF>
                                 <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                 <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                 <SCOPE>LOCAL</SCOPE>
                                 <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                 <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                 <VALUE-CONFIG-CLASSES>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                       <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                       <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                 </VALUE-CONFIG-CLASSES>
                                 <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                 <DEFAULT-VALUE>TimeStampSize_16Bit</DEFAULT-VALUE>
                                 <LITERALS>
                                    <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:08ecc252-9815-942d-202c-17b749caa847">
                                       <SHORT-NAME>TimeStampSize_16Bit</SHORT-NAME>
                                       <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                    </ECUC-ENUMERATION-LITERAL-DEF>
                                    <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:664ba091-11d2-8fc6-3a77-2dfa6a27d890">
                                       <SHORT-NAME>TimeStampSize_32Bit</SHORT-NAME>
                                       <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                    </ECUC-ENUMERATION-LITERAL-DEF>
                                 </LITERALS>
                              </ECUC-ENUMERATION-PARAM-DEF>
                           </PARAMETERS>
                           <REFERENCES>
                              <!-- Symbolic Name Reference Definition: DbgGptChannel -->
                              <ECUC-SYMBOLIC-NAME-REFERENCE-DEF UUID="ECUC:de1e3f61-12db-4fb7-9015-2eac7100dad1">
                                 <SHORT-NAME>DbgGptChannel</SHORT-NAME>
                                 <DESC>
                                    <L-2 L="EN">Reference to the hardware free running timer of the GPT module for time stamps (if no HWFRT is applied, calls to add timestamps are ignored)</L-2>
                                 </DESC>
                                 <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_Dbg_00815</RELATED-TRACE-ITEM-REF>
                                 <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                 <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                 <SCOPE>LOCAL</SCOPE>
                                 <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                 <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                 <VALUE-CONFIG-CLASSES>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                       <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                       <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                 </VALUE-CONFIG-CLASSES>
                                 <DESTINATION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/AUTOSAR/EcucDefs/Gpt/GptChannelConfigSet/GptChannelConfiguration</DESTINATION-REF>
                              </ECUC-SYMBOLIC-NAME-REFERENCE-DEF>
                           </REFERENCES>
                        </ECUC-PARAM-CONF-CONTAINER-DEF>
                     </CONTAINERS>
                  </ECUC-MODULE-DEF>
                  <!-- Module Definition: Dcm -->
                  <ECUC-MODULE-DEF UUID="ECUC:05a5c435-3e4f-4372-974f-6ee60d1997ef">
                     <SHORT-NAME>Dcm</SHORT-NAME>
                     <DESC>
                        <L-2 L="EN">Configuration of the Dcm (Diagnostic Communications Manager) module.</L-2>
                     </DESC>
                     <ADMIN-DATA>
                        <DOC-REVISIONS>
                           <DOC-REVISION>
                              <REVISION-LABEL>4.2.2</REVISION-LABEL>
                              <ISSUED-BY>AUTOSAR</ISSUED-BY>
                              <DATE>2014-10-31</DATE>
                           </DOC-REVISION>
                        </DOC-REVISIONS>
                     </ADMIN-DATA>
                     <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                     <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                     <POST-BUILD-VARIANT-SUPPORT>true</POST-BUILD-VARIANT-SUPPORT>
                     <SUPPORTED-CONFIG-VARIANTS>
                        <SUPPORTED-CONFIG-VARIANT>VARIANT-LINK-TIME</SUPPORTED-CONFIG-VARIANT>
                        <SUPPORTED-CONFIG-VARIANT>VARIANT-POST-BUILD</SUPPORTED-CONFIG-VARIANT>
                        <SUPPORTED-CONFIG-VARIANT>VARIANT-PRE-COMPILE</SUPPORTED-CONFIG-VARIANT>
                     </SUPPORTED-CONFIG-VARIANTS>
                     <CONTAINERS>
                        <!-- Container Definition: DcmConfigSet -->
                        <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:14704446-8e97-4037-be04-cdf9dd6c0f07">
                           <SHORT-NAME>DcmConfigSet</SHORT-NAME>
                           <DESC>
                              <L-2 L="EN">This container contains the configuration parameters and sub containers of the DCM module supporting multiple configuration sets.</L-2>
                           </DESC>
                           <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_Dcm_00819</RELATED-TRACE-ITEM-REF>
                           <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                           <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                           <SUB-CONTAINERS>
                              <!-- Container Definition: DcmDsd -->
                              <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:1a9bb7bc-401c-4735-bef3-c018f7bcfe36">
                                 <SHORT-NAME>DcmDsd</SHORT-NAME>
                                 <DESC>
                                    <L-2 L="EN">These parameters configure the Diagnostic Service Dispatcher submodule.</L-2>
                                 </DESC>
                                 <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_Dcm_00688</RELATED-TRACE-ITEM-REF>
                                 <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                 <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                 <PARAMETERS>
                                    <!-- PARAMETER DEFINITION: DcmDsdRequestManufacturerNotificationEnabled -->
                                    <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:77d1acd5-0d64-4461-a4f3-acd7c734f0de">
                                       <SHORT-NAME>DcmDsdRequestManufacturerNotificationEnabled</SHORT-NAME>
                                       <DESC>
                                          <L-2 L="EN">Allows to enable or disable the requested notification mechanism for the Manufacturer.</L-2>
                                       </DESC>
                                       <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_Dcm_00783</RELATED-TRACE-ITEM-REF>
                                       <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                       <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                       <SCOPE>ECU</SCOPE>
                                       <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                       <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                       <VALUE-CONFIG-CLASSES>
                                          <ECUC-VALUE-CONFIGURATION-CLASS>
                                             <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                             <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                                          </ECUC-VALUE-CONFIGURATION-CLASS>
                                          <ECUC-VALUE-CONFIGURATION-CLASS>
                                             <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                             <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                          </ECUC-VALUE-CONFIGURATION-CLASS>
                                          <ECUC-VALUE-CONFIGURATION-CLASS>
                                             <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                             <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                          </ECUC-VALUE-CONFIGURATION-CLASS>
                                       </VALUE-CONFIG-CLASSES>
                                       <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                    </ECUC-BOOLEAN-PARAM-DEF>
                                    <!-- PARAMETER DEFINITION: DcmDsdRequestSupplierNotificationEnabled -->
                                    <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:e56f57ca-dbe6-4846-96f9-9121cfb6dd8c">
                                       <SHORT-NAME>DcmDsdRequestSupplierNotificationEnabled</SHORT-NAME>
                                       <DESC>
                                          <L-2 L="EN">Allows to enable or disable the requested notification mechanism for the Supplier.</L-2>
                                       </DESC>
                                       <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_Dcm_00868</RELATED-TRACE-ITEM-REF>
                                       <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                       <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                       <SCOPE>ECU</SCOPE>
                                       <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                       <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                       <VALUE-CONFIG-CLASSES>
                                          <ECUC-VALUE-CONFIGURATION-CLASS>
                                             <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                             <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                                          </ECUC-VALUE-CONFIGURATION-CLASS>
                                          <ECUC-VALUE-CONFIGURATION-CLASS>
                                             <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                             <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                          </ECUC-VALUE-CONFIGURATION-CLASS>
                                          <ECUC-VALUE-CONFIGURATION-CLASS>
                                             <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                             <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                          </ECUC-VALUE-CONFIGURATION-CLASS>
                                       </VALUE-CONFIG-CLASSES>
                                       <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                    </ECUC-BOOLEAN-PARAM-DEF>
                                 </PARAMETERS>
                                 <SUB-CONTAINERS>
                                    <!-- Container Definition: DcmDsdServiceRequestManufacturerNotification -->
                                    <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:173a629f-de23-4819-a3f1-123c64ec9592">
                                       <SHORT-NAME>DcmDsdServiceRequestManufacturerNotification</SHORT-NAME>
                                       <DESC>
                                          <L-2 L="EN">The name of this container is used to define the name of the R-Port through which the DCM accesses the interface ServiceRequestNotification.</L-2>
                                       </DESC>
                                       <INTRODUCTION>
                                          <P>
                                             <L-1 L="EN">The R-Port is named ServiceRequestManufacturerNotification_{Name} where {Name} is the name of the container DcmDsdServiceRequestManufacturerNotification.

                                                The  lowerMultiplicity is 0: If DcmDsdRequestManufacturerNotificationEnabled = false the  Indication API is not available.</L-1>
                                          </P>
                                       </INTRODUCTION>
                                       <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_Dcm_00681</RELATED-TRACE-ITEM-REF>
                                       <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                       <UPPER-MULTIPLICITY-INFINITE>true</UPPER-MULTIPLICITY-INFINITE>
                                    </ECUC-PARAM-CONF-CONTAINER-DEF>
                                    <!-- Container Definition: DcmDsdServiceRequestSupplierNotification -->
                                    <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:974b9deb-2065-4b27-b301-781bb15640cf">
                                       <SHORT-NAME>DcmDsdServiceRequestSupplierNotification</SHORT-NAME>
                                       <DESC>
                                          <L-2 L="EN">The name of this container is used to define the name of the R-Port through which the DCM accesses the interface ServiceRequestNotification.</L-2>
                                       </DESC>
                                       <INTRODUCTION>
                                          <P>
                                             <L-1 L="EN">The R-Port is named ServiceRequestSupplierNotification_&lt;SWC&gt;
                                                where &lt;SWC&gt; is the name of the container DcmDsdServiceRequestSupplierNotification.

                                                The  lowerMultiplicity is 0: If DcmDsdRequestSupplierNotification = false the Indication API is not available.</L-1>
                                          </P>
                                       </INTRODUCTION>
                                       <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_Dcm_00816</RELATED-TRACE-ITEM-REF>
                                       <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                       <UPPER-MULTIPLICITY-INFINITE>true</UPPER-MULTIPLICITY-INFINITE>
                                    </ECUC-PARAM-CONF-CONTAINER-DEF>
                                    <!-- Container Definition: DcmDsdServiceTable -->
                                    <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:aa9cd4bb-b42c-4989-8c88-14b293db1230">
                                       <SHORT-NAME>DcmDsdServiceTable</SHORT-NAME>
                                       <DESC>
                                          <L-2 L="EN">This container contains the configuration (DSD parameters) for a Service Identifier Table.</L-2>
                                       </DESC>
                                       <INTRODUCTION>
                                          <P>
                                             <L-1 L="EN">Note: It is allowed to add OBD services to a DcmDsdServiceTable related to a UDS Protocol. But it is not allowed to add UDS services to a DcmDsdServiceTable related to an OBD Protocol.</L-1>
                                          </P>
                                       </INTRODUCTION>
                                       <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_Dcm_00732</RELATED-TRACE-ITEM-REF>
                                       <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                       <UPPER-MULTIPLICITY>256</UPPER-MULTIPLICITY>
                                       <PARAMETERS>
                                          <!-- PARAMETER DEFINITION: DcmDsdSidTabId -->
                                          <ECUC-INTEGER-PARAM-DEF UUID="ECUC:9beecb56-9c72-48f2-8937-081b15498799">
                                             <SHORT-NAME>DcmDsdSidTabId</SHORT-NAME>
                                             <DESC>
                                                <L-2 L="EN">Due to using possibly more service tables, the unique DcmDsdSidTabId can be used to identify them.</L-2>
                                             </DESC>
                                             <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_Dcm_00736</RELATED-TRACE-ITEM-REF>
                                             <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                             <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                             <SCOPE>ECU</SCOPE>
                                             <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                             <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                             <VALUE-CONFIG-CLASSES>
                                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>LINK</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                             </VALUE-CONFIG-CLASSES>
                                             <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                             <MAX>255</MAX>
                                             <MIN>0</MIN>
                                          </ECUC-INTEGER-PARAM-DEF>
                                       </PARAMETERS>
                                       <SUB-CONTAINERS>
                                          <!-- Container Definition: DcmDsdService -->
                                          <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:b5c531c1-fb24-4f9f-bf59-261058c79cf9">
                                             <SHORT-NAME>DcmDsdService</SHORT-NAME>
                                             <DESC>
                                                <L-2 L="EN">This container contains the configuration (DSD parameters) for a Service.</L-2>
                                             </DESC>
                                             <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_Dcm_00689</RELATED-TRACE-ITEM-REF>
                                             <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                             <UPPER-MULTIPLICITY-INFINITE>true</UPPER-MULTIPLICITY-INFINITE>
                                             <PARAMETERS>
                                                <!-- PARAMETER DEFINITION: DcmDsdServiceUsed -->
                                                <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:4f912f4c-9346-47ab-a542-5fdee942ce2d">
                                                   <SHORT-NAME>DcmDsdServiceUsed</SHORT-NAME>
                                                   <DESC>
                                                      <L-2 L="EN">Allows to activate or deactivate the usage of a Service. This parameter can be used for multi-purpose ECUs.</L-2>
                                                   </DESC>
                                                   <INTRODUCTION>
                                                      <P>
                                                         <L-1 L="EN">true - service is available

                                                                false - service is not available</L-1>
                                                      </P>
                                                   </INTRODUCTION>
                                                   <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_Dcm_01044</RELATED-TRACE-ITEM-REF>
                                                   <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                                   <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                                   <SCOPE>LOCAL</SCOPE>
                                                   <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                                   <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                                                   <VALUE-CONFIG-CLASSES>
                                                      <ECUC-VALUE-CONFIGURATION-CLASS>
                                                         <CONFIG-CLASS>LINK</CONFIG-CLASS>
                                                         <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                                                      </ECUC-VALUE-CONFIGURATION-CLASS>
                                                      <ECUC-VALUE-CONFIGURATION-CLASS>
                                                         <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                                         <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                                      </ECUC-VALUE-CONFIGURATION-CLASS>
                                                      <ECUC-VALUE-CONFIGURATION-CLASS>
                                                         <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                         <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                                      </ECUC-VALUE-CONFIGURATION-CLASS>
                                                   </VALUE-CONFIG-CLASSES>
                                                   <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                                   <DEFAULT-VALUE>true</DEFAULT-VALUE>
                                                </ECUC-BOOLEAN-PARAM-DEF>
                                                <!-- PARAMETER DEFINITION: DcmDsdSidTabFnc -->
                                                <ECUC-FUNCTION-NAME-DEF UUID="ECUC:a926b0f5-720e-43d0-a7c6-b2169c427a55">
                                                   <SHORT-NAME>DcmDsdSidTabFnc</SHORT-NAME>
                                                   <DESC>
                                                      <L-2 L="EN">Callback function of the ECU Supplier specific component for the particular service. The function's prototype is as described for &lt;Module&gt;_&lt;DiagnosticService&gt;. If this parameter is not configured, the service is handled Dcm-internally.</L-2>
                                                   </DESC>
                                                   <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_Dcm_00777</RELATED-TRACE-ITEM-REF>
                                                   <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                                   <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                                   <SCOPE>ECU</SCOPE>
                                                   <MULTIPLICITY-CONFIG-CLASSES>
                                                      <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                                         <CONFIG-CLASS>LINK</CONFIG-CLASS>
                                                         <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                                                      </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                                      <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                                         <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                         <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                                      </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                                      <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                                         <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                         <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                                      </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                                   </MULTIPLICITY-CONFIG-CLASSES>
                                                   <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                                   <POST-BUILD-VARIANT-MULTIPLICITY>false</POST-BUILD-VARIANT-MULTIPLICITY>
                                                   <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                                   <VALUE-CONFIG-CLASSES>
                                                      <ECUC-VALUE-CONFIGURATION-CLASS>
                                                         <CONFIG-CLASS>LINK</CONFIG-CLASS>
                                                         <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                                                      </ECUC-VALUE-CONFIGURATION-CLASS>
                                                      <ECUC-VALUE-CONFIGURATION-CLASS>
                                                         <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                         <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                                      </ECUC-VALUE-CONFIGURATION-CLASS>
                                                      <ECUC-VALUE-CONFIGURATION-CLASS>
                                                         <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                         <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                                      </ECUC-VALUE-CONFIGURATION-CLASS>
                                                   </VALUE-CONFIG-CLASSES>
                                                   <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                                   <ECUC-FUNCTION-NAME-DEF-VARIANTS>
                                                      <ECUC-FUNCTION-NAME-DEF-CONDITIONAL/>
                                                   </ECUC-FUNCTION-NAME-DEF-VARIANTS>
                                                </ECUC-FUNCTION-NAME-DEF>
                                                <!-- PARAMETER DEFINITION: DcmDsdSidTabServiceId -->
                                                <ECUC-INTEGER-PARAM-DEF UUID="ECUC:2ecd1da7-2e54-40a1-a7c7-5afe7ae9a702">
                                                   <SHORT-NAME>DcmDsdSidTabServiceId</SHORT-NAME>
                                                   <DESC>
                                                      <L-2 L="EN">Identifier of the service.</L-2>
                                                   </DESC>
                                                   <INTRODUCTION>
                                                      <P>
                                                         <L-1 L="EN">The possible service identifiers are defined in ISO 14229-1 and ISO 15031-5.</L-1>
                                                      </P>
                                                   </INTRODUCTION>
                                                   <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_Dcm_00735</RELATED-TRACE-ITEM-REF>
                                                   <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                                   <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                                   <SCOPE>ECU</SCOPE>
                                                   <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                                   <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                                   <VALUE-CONFIG-CLASSES>
                                                      <ECUC-VALUE-CONFIGURATION-CLASS>
                                                         <CONFIG-CLASS>LINK</CONFIG-CLASS>
                                                         <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                                                      </ECUC-VALUE-CONFIGURATION-CLASS>
                                                      <ECUC-VALUE-CONFIGURATION-CLASS>
                                                         <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                         <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                                      </ECUC-VALUE-CONFIGURATION-CLASS>
                                                      <ECUC-VALUE-CONFIGURATION-CLASS>
                                                         <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                         <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                                      </ECUC-VALUE-CONFIGURATION-CLASS>
                                                   </VALUE-CONFIG-CLASSES>
                                                   <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                                   <MAX>255</MAX>
                                                   <MIN>0</MIN>
                                                </ECUC-INTEGER-PARAM-DEF>
                                                <!-- PARAMETER DEFINITION: DcmDsdSidTabSubfuncAvail -->
                                                <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:240938a3-1bb7-4aef-8bc4-ff8ef293f1b0">
                                                   <SHORT-NAME>DcmDsdSidTabSubfuncAvail</SHORT-NAME>
                                                   <DESC>
                                                      <L-2 L="EN">Information about whether the service has subfunctions or not. This parameter is used for the handling of the "suppressPosRspMsgIndicationBit" as defined in ISO 14229-1, which can be used as a reference for the configuration.</L-2>
                                                   </DESC>
                                                   <INTRODUCTION>
                                                      <P>
                                                         <L-1 L="EN">true - service has subfunctions, suppressPosRspMsgIndicationBit is available

                                                                false - service has no subfunctions, suppressPosRspMsgIndicationBit is not available</L-1>
                                                      </P>
                                                   </INTRODUCTION>
                                                   <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_Dcm_00737</RELATED-TRACE-ITEM-REF>
                                                   <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                                   <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                                   <SCOPE>ECU</SCOPE>
                                                   <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                                   <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                                   <VALUE-CONFIG-CLASSES>
                                                      <ECUC-VALUE-CONFIGURATION-CLASS>
                                                         <CONFIG-CLASS>LINK</CONFIG-CLASS>
                                                         <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                                                      </ECUC-VALUE-CONFIGURATION-CLASS>
                                                      <ECUC-VALUE-CONFIGURATION-CLASS>
                                                         <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                         <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                                      </ECUC-VALUE-CONFIGURATION-CLASS>
                                                      <ECUC-VALUE-CONFIGURATION-CLASS>
                                                         <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                         <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                                      </ECUC-VALUE-CONFIGURATION-CLASS>
                                                   </VALUE-CONFIG-CLASSES>
                                                   <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                                </ECUC-BOOLEAN-PARAM-DEF>
                                             </PARAMETERS>
                                             <REFERENCES>
                                                <!-- Reference Definition: DcmDsdSidTabModeRuleRef -->
                                                <ECUC-REFERENCE-DEF UUID="ECUC:8873829f-13b9-49f4-b0b0-7e103063f164">
                                                   <SHORT-NAME>DcmDsdSidTabModeRuleRef</SHORT-NAME>
                                                   <DESC>
                                                      <L-2 L="EN">Reference to a DcmDspModeRule which controls the execution of the service. If there is no reference configured, no mode rule check shall be performed.</L-2>
                                                   </DESC>
                                                   <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_Dcm_00918</RELATED-TRACE-ITEM-REF>
                                                   <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                                   <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                                   <SCOPE>ECU</SCOPE>
                                                   <MULTIPLICITY-CONFIG-CLASSES>
                                                      <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                                         <CONFIG-CLASS>LINK</CONFIG-CLASS>
                                                         <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                                                      </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                                      <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                                         <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                         <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                                      </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                                      <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                                         <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                         <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                                      </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                                   </MULTIPLICITY-CONFIG-CLASSES>
