                              <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:fb5b9a75-01e9-4f62-8b7e-35e1862a0337">
                                 <SHORT-NAME>DoIPVinGidMaster</SHORT-NAME>
                                 <DESC>
                                    <L-2 L="EN">Specifies if the DoIP entity is the Vehicle identification Master for the GID (Group ID).</L-2>
                                 </DESC>
                                 <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_DoIP_00017</RELATED-TRACE-ITEM-REF>
                                 <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                 <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                 <SCOPE>LOCAL</SCOPE>
                                 <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                 <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                 <VALUE-CONFIG-CLASSES>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                       <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                       <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                       <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                       <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                       <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                       <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                 </VALUE-CONFIG-CLASSES>
                                 <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                              </ECUC-BOOLEAN-PARAM-DEF>
                              <!-- PARAMETER DEFINITION: DoIPVinInvalidityPattern -->
                              <ECUC-INTEGER-PARAM-DEF UUID="ECUC:71cdeb3f-0bca-40a4-89da-e9be192fb5ed">
                                 <SHORT-NAME>DoIPVinInvalidityPattern</SHORT-NAME>
                                 <DESC>
                                    <L-2 L="EN">Specifies the Byte pattern that is used for response messages if no valid VIN could be retrieved.</L-2>
                                 </DESC>
                                 <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_DoIP_00066</RELATED-TRACE-ITEM-REF>
                                 <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                 <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                 <SCOPE>LOCAL</SCOPE>
                                 <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                 <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                 <VALUE-CONFIG-CLASSES>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                       <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                       <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                       <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                       <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                       <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                       <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                 </VALUE-CONFIG-CLASSES>
                                 <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                 <MAX>255</MAX>
                                 <MIN>0</MIN>
                              </ECUC-INTEGER-PARAM-DEF>
                           </PARAMETERS>
                           <SUB-CONTAINERS>
                              <!-- Container Definition: DoIPGetGidCallback -->
                              <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:e5a263bf-c784-4f01-8ea8-8d5d92fcde5b">
                                 <SHORT-NAME>DoIPGetGidCallback</SHORT-NAME>
                                 <DESC>
                                    <L-2 L="EN">This container describes the usage of a callback function to get the GID. (If this container is not present no callback function shall be used by DoIP module to retrive the GID.)</L-2>
                                 </DESC>
                                 <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_DoIP_00024</RELATED-TRACE-ITEM-REF>
                                 <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                 <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                 <PARAMETERS>
                                    <!-- PARAMETER DEFINITION: DoIPGetGidDirect -->
                                    <ECUC-FUNCTION-NAME-DEF UUID="ECUC:87f4a179-208a-48a0-b9ab-a7c412972e7f">
                                       <SHORT-NAME>DoIPGetGidDirect</SHORT-NAME>
                                       <DESC>
                                          <L-2 L="EN">If the DoIPGetGidDirect parameter exist the DoIP module shall call the configured callback function (&lt;User&gt;_DoIPGetGID) direct. (It is not needed to specify a service port to the DoIP service component.)</L-2>
                                       </DESC>
                                       <INTRODUCTION>
                                          <P>
                                             <L-1 L="EN">If the DoIPGetGidDirect parameter does NOT exist the DoIP module shall use a RPort with a CallbackGetGID type of client-server port interface to retrive the GID.</L-1>
                                          </P>
                                       </INTRODUCTION>
                                       <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_DoIP_00028</RELATED-TRACE-ITEM-REF>
                                       <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                       <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                       <SCOPE>LOCAL</SCOPE>
                                       <MULTIPLICITY-CONFIG-CLASSES>
                                          <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                             <CONFIG-CLASS>LINK</CONFIG-CLASS>
                                             <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                                          </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                          <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                             <CONFIG-CLASS>LINK</CONFIG-CLASS>
                                             <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                          </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                          <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                             <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                             <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                          </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                       </MULTIPLICITY-CONFIG-CLASSES>
                                       <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                       <POST-BUILD-VARIANT-MULTIPLICITY>false</POST-BUILD-VARIANT-MULTIPLICITY>
                                       <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                       <VALUE-CONFIG-CLASSES>
                                          <ECUC-VALUE-CONFIGURATION-CLASS>
                                             <CONFIG-CLASS>LINK</CONFIG-CLASS>
                                             <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                                          </ECUC-VALUE-CONFIGURATION-CLASS>
                                          <ECUC-VALUE-CONFIGURATION-CLASS>
                                             <CONFIG-CLASS>LINK</CONFIG-CLASS>
                                             <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                          </ECUC-VALUE-CONFIGURATION-CLASS>
                                          <ECUC-VALUE-CONFIGURATION-CLASS>
                                             <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                             <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                          </ECUC-VALUE-CONFIGURATION-CLASS>
                                       </VALUE-CONFIG-CLASSES>
                                       <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                       <ECUC-FUNCTION-NAME-DEF-VARIANTS>
                                          <ECUC-FUNCTION-NAME-DEF-CONDITIONAL/>
                                       </ECUC-FUNCTION-NAME-DEF-VARIANTS>
                                    </ECUC-FUNCTION-NAME-DEF>
                                 </PARAMETERS>
                              </ECUC-PARAM-CONF-CONTAINER-DEF>
                              <!-- Container Definition: DoIPPowerModeCallback -->
                              <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:2ff29d7f-73d8-4d8e-b0f9-80290df3875f">
                                 <SHORT-NAME>DoIPPowerModeCallback</SHORT-NAME>
                                 <DESC>
                                    <L-2 L="EN">This container describes the usage of a callback function to retrieve the current power mode. This container shall always be present.</L-2>
                                 </DESC>
                                 <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_DoIP_00023</RELATED-TRACE-ITEM-REF>
                                 <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                 <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                 <PARAMETERS>
                                    <!-- PARAMETER DEFINITION: DoIPPowerModeDirect -->
                                    <ECUC-FUNCTION-NAME-DEF UUID="ECUC:cf0e90d1-c77e-42c9-a19e-5b3ee1c9aab8">
                                       <SHORT-NAME>DoIPPowerModeDirect</SHORT-NAME>
                                       <DESC>
                                          <L-2 L="EN">If the DoIPPowerModeDirect parameter exist the DoIP module shall call the configured callback function (&lt;User&gt;_DoIPGetPowerModeCallback) direct. (It is not needed to specify a service port to the DoIP service component.)</L-2>
                                       </DESC>
                                       <INTRODUCTION>
                                          <P>
                                             <L-1 L="EN">If the DoIPPowerModeDirect parameter does NOT present the DoIP module shall use a RPort with a CallbackGetPowerMode type of client-server port interface to retrive the current power mode.</L-1>
                                          </P>
                                       </INTRODUCTION>
                                       <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_DoIP_00027</RELATED-TRACE-ITEM-REF>
                                       <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                       <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                       <SCOPE>LOCAL</SCOPE>
                                       <MULTIPLICITY-CONFIG-CLASSES>
                                          <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                             <CONFIG-CLASS>LINK</CONFIG-CLASS>
                                             <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                                          </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                          <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                             <CONFIG-CLASS>LINK</CONFIG-CLASS>
                                             <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                          </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                          <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                             <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                             <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                          </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                       </MULTIPLICITY-CONFIG-CLASSES>
                                       <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                       <POST-BUILD-VARIANT-MULTIPLICITY>false</POST-BUILD-VARIANT-MULTIPLICITY>
                                       <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                       <VALUE-CONFIG-CLASSES>
                                          <ECUC-VALUE-CONFIGURATION-CLASS>
                                             <CONFIG-CLASS>LINK</CONFIG-CLASS>
                                             <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                                          </ECUC-VALUE-CONFIGURATION-CLASS>
                                          <ECUC-VALUE-CONFIGURATION-CLASS>
                                             <CONFIG-CLASS>LINK</CONFIG-CLASS>
                                             <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                          </ECUC-VALUE-CONFIGURATION-CLASS>
                                          <ECUC-VALUE-CONFIGURATION-CLASS>
                                             <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                             <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                          </ECUC-VALUE-CONFIGURATION-CLASS>
                                       </VALUE-CONFIG-CLASSES>
                                       <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                       <ECUC-FUNCTION-NAME-DEF-VARIANTS>
                                          <ECUC-FUNCTION-NAME-DEF-CONDITIONAL/>
                                       </ECUC-FUNCTION-NAME-DEF-VARIANTS>
                                    </ECUC-FUNCTION-NAME-DEF>
                                 </PARAMETERS>
                              </ECUC-PARAM-CONF-CONTAINER-DEF>
                              <!-- Container Definition: DoIPTriggerGidSyncCallback -->
                              <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:927e37ff-e9b9-4d89-b2ea-649d6e4d5a69">
                                 <SHORT-NAME>DoIPTriggerGidSyncCallback</SHORT-NAME>
                                 <DESC>
                                    <L-2 L="EN">This container describes the usage of a callback function to trigger the GID synchronization. (If this container does not exist no callback function shall be used by DoIP module to trigger the GID synchronization.)</L-2>
                                 </DESC>
                                 <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_DoIP_00025</RELATED-TRACE-ITEM-REF>
                                 <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                 <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                 <PARAMETERS>
                                    <!-- PARAMETER DEFINITION: DoIPTriggerGidSyncDirect -->
                                    <ECUC-FUNCTION-NAME-DEF UUID="ECUC:7d270003-ea90-4e43-b236-689b211e8fe9">
                                       <SHORT-NAME>DoIPTriggerGidSyncDirect</SHORT-NAME>
                                       <DESC>
                                          <L-2 L="EN">If the DoIPTriggerGidSyncDirect parameter exist the DoIP module shall call the configured callback function (&lt;User&gt;_DoIPTriggerGidSyncCallback) direct. (It is not needed to specify a service port to the DoIP service component.)</L-2>
                                       </DESC>
                                       <INTRODUCTION>
                                          <P>
                                             <L-1 L="EN">If the DoIPTriggerGidSyncDirect parameter does NOT present the DoIP module shall use a RPort with a CallbackTriggerGIDSynchnonization type of client-server port interface to trigger the GID synchronization.</L-1>
                                          </P>
                                       </INTRODUCTION>
                                       <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_DoIP_00029</RELATED-TRACE-ITEM-REF>
                                       <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                       <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                       <SCOPE>LOCAL</SCOPE>
                                       <MULTIPLICITY-CONFIG-CLASSES>
                                          <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                             <CONFIG-CLASS>LINK</CONFIG-CLASS>
                                             <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                                          </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                          <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                             <CONFIG-CLASS>LINK</CONFIG-CLASS>
                                             <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                          </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                          <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                             <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                             <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                          </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                       </MULTIPLICITY-CONFIG-CLASSES>
                                       <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                       <POST-BUILD-VARIANT-MULTIPLICITY>false</POST-BUILD-VARIANT-MULTIPLICITY>
                                       <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                       <VALUE-CONFIG-CLASSES>
                                          <ECUC-VALUE-CONFIGURATION-CLASS>
                                             <CONFIG-CLASS>LINK</CONFIG-CLASS>
                                             <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                                          </ECUC-VALUE-CONFIGURATION-CLASS>
                                          <ECUC-VALUE-CONFIGURATION-CLASS>
                                             <CONFIG-CLASS>LINK</CONFIG-CLASS>
                                             <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                          </ECUC-VALUE-CONFIGURATION-CLASS>
                                          <ECUC-VALUE-CONFIGURATION-CLASS>
                                             <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                             <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                          </ECUC-VALUE-CONFIGURATION-CLASS>
                                       </VALUE-CONFIG-CLASSES>
                                       <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                       <ECUC-FUNCTION-NAME-DEF-VARIANTS>
                                          <ECUC-FUNCTION-NAME-DEF-CONDITIONAL/>
                                       </ECUC-FUNCTION-NAME-DEF-VARIANTS>
                                    </ECUC-FUNCTION-NAME-DEF>
                                 </PARAMETERS>
                              </ECUC-PARAM-CONF-CONTAINER-DEF>
                           </SUB-CONTAINERS>
                        </ECUC-PARAM-CONF-CONTAINER-DEF>
                     </CONTAINERS>
                  </ECUC-MODULE-DEF>
                  <!-- Module Definition: Ea -->
                  <ECUC-MODULE-DEF UUID="ECUC:c6de96ce-a538-4309-b185-f7568c3162b6">
                     <SHORT-NAME>Ea</SHORT-NAME>
                     <DESC>
                        <L-2 L="EN">Configuration of the Ea (EEPROM Abstraction) module.</L-2>
                     </DESC>
                     <ADMIN-DATA>
                        <DOC-REVISIONS>
                           <DOC-REVISION>
                              <REVISION-LABEL>4.2.2</REVISION-LABEL>
                              <ISSUED-BY>AUTOSAR</ISSUED-BY>
                              <DATE>2014-10-31</DATE>
                           </DOC-REVISION>
                        </DOC-REVISIONS>
                     </ADMIN-DATA>
                     <INTRODUCTION>
                        <P>
                           <L-1 L="EN">The module shall abstract from the device specific addressing scheme and segmentation and provide the upper layers with a virtual addressing scheme and segmentation as well as a 'virtually' unlimited number of erase cycles.</L-1>
                        </P>
                     </INTRODUCTION>
                     <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_Ea_00133</RELATED-TRACE-ITEM-REF>
                     <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                     <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                     <POST-BUILD-VARIANT-SUPPORT>false</POST-BUILD-VARIANT-SUPPORT>
                     <SUPPORTED-CONFIG-VARIANTS>
                        <SUPPORTED-CONFIG-VARIANT>VARIANT-PRE-COMPILE</SUPPORTED-CONFIG-VARIANT>
                     </SUPPORTED-CONFIG-VARIANTS>
                     <CONTAINERS>
                        <!-- Container Definition: EaBlockConfiguration -->
                        <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:9b7435b0-8e2b-4fa1-a37d-ddc652cf908c">
                           <SHORT-NAME>EaBlockConfiguration</SHORT-NAME>
                           <DESC>
                              <L-2 L="EN">Configuration of block specific parameters for the EEPROM abstraction module.</L-2>
                           </DESC>
                           <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_Ea_00040</RELATED-TRACE-ITEM-REF>
                           <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                           <UPPER-MULTIPLICITY-INFINITE>true</UPPER-MULTIPLICITY-INFINITE>
                           <PARAMETERS>
                              <!-- PARAMETER DEFINITION: EaBlockNumber -->
                              <ECUC-INTEGER-PARAM-DEF UUID="ECUC:997bcb48-170b-4a2d-ab97-3ba85568fcdf">
                                 <SHORT-NAME>EaBlockNumber</SHORT-NAME>
                                 <DESC>
                                    <L-2 L="EN">Block identifier (handle).</L-2>
                                 </DESC>
                                 <INTRODUCTION>
                                    <P>
                                       <L-1 L="EN">0x0000 and 0xFFFF shall not be used for block numbers (see EA006).

                                        Range: 
                                          min = 2^NVM_DATASET_SELECTION_BITS 
                                          max = 0xFFFF -2^NVM_DATASET_SELECTION_BITS

                                        Note: Depending on the number of bits set aside for dataset selection several other block numbers shall also be left out to ease implementation.</L-1>
                                    </P>
                                 </INTRODUCTION>
                                 <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_Ea_00130</RELATED-TRACE-ITEM-REF>
                                 <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                 <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                 <SCOPE>ECU</SCOPE>
                                 <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                 <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                 <VALUE-CONFIG-CLASSES>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                       <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                       <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                 </VALUE-CONFIG-CLASSES>
                                 <SYMBOLIC-NAME-VALUE>true</SYMBOLIC-NAME-VALUE>
                                 <MAX>65534</MAX>
                                 <MIN>1</MIN>
                              </ECUC-INTEGER-PARAM-DEF>
                              <!-- PARAMETER DEFINITION: EaBlockSize -->
                              <ECUC-INTEGER-PARAM-DEF UUID="ECUC:d93be6ac-f99a-4500-bf92-c61f222dad5d">
                                 <SHORT-NAME>EaBlockSize</SHORT-NAME>
                                 <DESC>
                                    <L-2 L="EN">Size of a logical block in bytes.</L-2>
                                 </DESC>
                                 <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_Ea_00128</RELATED-TRACE-ITEM-REF>
                                 <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                 <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                 <SCOPE>ECU</SCOPE>
                                 <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                 <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                 <VALUE-CONFIG-CLASSES>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                       <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                       <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                 </VALUE-CONFIG-CLASSES>
                                 <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                 <MAX>65535</MAX>
                                 <MIN>1</MIN>
                              </ECUC-INTEGER-PARAM-DEF>
                              <!-- PARAMETER DEFINITION: EaImmediateData -->
                              <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:ceda93f2-07fd-44c2-8d31-b8aabbced641">
                                 <SHORT-NAME>EaImmediateData</SHORT-NAME>
                                 <DESC>
                                    <L-2 L="EN">Marker for high priority data.</L-2>
                                 </DESC>
                                 <INTRODUCTION>
                                    <P>
                                       <L-1 L="EN">true: 	Block contains immediate data.
                                        false:	Block does not contain immediate data.</L-1>
                                    </P>
                                 </INTRODUCTION>
                                 <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_Ea_00131</RELATED-TRACE-ITEM-REF>
                                 <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                 <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                 <SCOPE>ECU</SCOPE>
                                 <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                 <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                 <VALUE-CONFIG-CLASSES>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                       <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                       <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                 </VALUE-CONFIG-CLASSES>
                                 <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                              </ECUC-BOOLEAN-PARAM-DEF>
                              <!-- PARAMETER DEFINITION: EaNumberOfWriteCycles -->
                              <ECUC-INTEGER-PARAM-DEF UUID="ECUC:cd71c820-c85a-4055-97e2-3cce71bc93d3">
                                 <SHORT-NAME>EaNumberOfWriteCycles</SHORT-NAME>
                                 <DESC>
                                    <L-2 L="EN">Number of write cycles required for this block.</L-2>
                                 </DESC>
                                 <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_Ea_00119</RELATED-TRACE-ITEM-REF>
                                 <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                 <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                 <SCOPE>LOCAL</SCOPE>
                                 <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                 <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                 <VALUE-CONFIG-CLASSES>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                       <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                       <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                 </VALUE-CONFIG-CLASSES>
                                 <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                 <MAX>4294967295</MAX>
                                 <MIN>0</MIN>
                              </ECUC-INTEGER-PARAM-DEF>
                           </PARAMETERS>
                           <REFERENCES>
                              <!-- Symbolic Name Reference Definition: EaDeviceIndex -->
                              <ECUC-SYMBOLIC-NAME-REFERENCE-DEF UUID="ECUC:735d011c-31e9-4235-ab22-d5c1a2647936">
                                 <SHORT-NAME>EaDeviceIndex</SHORT-NAME>
                                 <DESC>
                                    <L-2 L="EN">Reference to the device this block is stored in.</L-2>
                                 </DESC>
                                 <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_Ea_00129</RELATED-TRACE-ITEM-REF>
                                 <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                 <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                 <SCOPE>LOCAL</SCOPE>
                                 <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                 <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                 <VALUE-CONFIG-CLASSES>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                       <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                       <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                 </VALUE-CONFIG-CLASSES>
                                 <DESTINATION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/AUTOSAR/EcucDefs/Eep/EepGeneral</DESTINATION-REF>
                              </ECUC-SYMBOLIC-NAME-REFERENCE-DEF>
                           </REFERENCES>
                        </ECUC-PARAM-CONF-CONTAINER-DEF>
                        <!-- Container Definition: EaGeneral -->
                        <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:03c545b5-0414-475e-b6c3-383d510bb159">
                           <SHORT-NAME>EaGeneral</SHORT-NAME>
                           <DESC>
                              <L-2 L="EN">General configuration of the EEPROM abstraction module. This container lists block independent configuration parameters.</L-2>
                           </DESC>
                           <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_Ea_00039</RELATED-TRACE-ITEM-REF>
                           <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                           <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                           <PARAMETERS>
                              <!-- PARAMETER DEFINITION: EaDevErrorDetect -->
                              <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:699071d4-4525-41af-8cd1-1bfe69f6798c">
                                 <SHORT-NAME>EaDevErrorDetect</SHORT-NAME>
                                 <DESC>
                                    <L-2 L="EN">Switches the Default Error Tracer (Det) detection and notification ON or OFF.</L-2>
                                 </DESC>
                                 <INTRODUCTION>
                                    <P>
                                       <L-1 L="EN">* true: enabled (ON).
                                        * false: disabled (OFF).</L-1>
                                    </P>
                                 </INTRODUCTION>
                                 <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_Ea_00120</RELATED-TRACE-ITEM-REF>
                                 <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                 <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                 <SCOPE>LOCAL</SCOPE>
                                 <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                 <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                 <VALUE-CONFIG-CLASSES>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                       <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                       <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                 </VALUE-CONFIG-CLASSES>
                                 <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                              </ECUC-BOOLEAN-PARAM-DEF>
                              <!-- PARAMETER DEFINITION: EaMainFunctionPeriod -->
                              <ECUC-FLOAT-PARAM-DEF UUID="ECUC:23a8e9ad-c4fe-4fae-ac61-283a5fee81e0">
                                 <SHORT-NAME>EaMainFunctionPeriod</SHORT-NAME>
                                 <DESC>
                                    <L-2 L="EN">The period between successive calls to the main function in seconds.</L-2>
                                 </DESC>
                                 <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_Ea_00132</RELATED-TRACE-ITEM-REF>
                                 <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                 <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                 <SCOPE>ECU</SCOPE>
                                 <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                 <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                 <VALUE-CONFIG-CLASSES>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                       <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                       <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                 </VALUE-CONFIG-CLASSES>
                                 <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                 <MAX>Inf</MAX>
                                 <MIN>1E-7</MIN>
                              </ECUC-FLOAT-PARAM-DEF>
                              <!-- PARAMETER DEFINITION: EaNvmJobEndNotification -->
                              <ECUC-FUNCTION-NAME-DEF UUID="ECUC:791c602d-f757-476f-8535-129663700557">
                                 <SHORT-NAME>EaNvmJobEndNotification</SHORT-NAME>
                                 <DESC>
                                    <L-2 L="EN">Mapped to the job end notification routine provided by the upper layer module (NvM_JobEndNotification).</L-2>
                                 </DESC>
                                 <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_Ea_00121</RELATED-TRACE-ITEM-REF>
                                 <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                 <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                 <SCOPE>LOCAL</SCOPE>
                                 <MULTIPLICITY-CONFIG-CLASSES>
                                    <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                       <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                       <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                 </MULTIPLICITY-CONFIG-CLASSES>
                                 <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                 <POST-BUILD-VARIANT-MULTIPLICITY>false</POST-BUILD-VARIANT-MULTIPLICITY>
                                 <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                 <VALUE-CONFIG-CLASSES>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                       <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                       <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                 </VALUE-CONFIG-CLASSES>
                                 <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                 <ECUC-FUNCTION-NAME-DEF-VARIANTS>
                                    <ECUC-FUNCTION-NAME-DEF-CONDITIONAL/>
                                 </ECUC-FUNCTION-NAME-DEF-VARIANTS>
                              </ECUC-FUNCTION-NAME-DEF>
                              <!-- PARAMETER DEFINITION: EaNvmJobErrorNotification -->
                              <ECUC-FUNCTION-NAME-DEF UUID="ECUC:82486646-4e38-4149-89db-6605202cce18">
                                 <SHORT-NAME>EaNvmJobErrorNotification</SHORT-NAME>
                                 <DESC>
                                    <L-2 L="EN">Mapped to the job error notification routine provided by the upper layer module (NvM_JobErrorNotification).</L-2>
                                 </DESC>
                                 <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_Ea_00122</RELATED-TRACE-ITEM-REF>
                                 <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                 <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                 <SCOPE>LOCAL</SCOPE>
                                 <MULTIPLICITY-CONFIG-CLASSES>
                                    <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                       <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                       <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                 </MULTIPLICITY-CONFIG-CLASSES>
                                 <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                 <POST-BUILD-VARIANT-MULTIPLICITY>false</POST-BUILD-VARIANT-MULTIPLICITY>
                                 <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                 <VALUE-CONFIG-CLASSES>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                       <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                       <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                 </VALUE-CONFIG-CLASSES>
                                 <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                 <ECUC-FUNCTION-NAME-DEF-VARIANTS>
                                    <ECUC-FUNCTION-NAME-DEF-CONDITIONAL/>
                                 </ECUC-FUNCTION-NAME-DEF-VARIANTS>
                              </ECUC-FUNCTION-NAME-DEF>
                              <!-- PARAMETER DEFINITION: EaPollingMode -->
                              <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:43431c0d-0ddd-4243-8eaa-e4ebe5013d20">
                                 <SHORT-NAME>EaPollingMode</SHORT-NAME>
                                 <DESC>
                                    <L-2 L="EN">Pre-processor switch to enable and disable the polling mode for this module.</L-2>
                                 </DESC>
                                 <INTRODUCTION>
                                    <P>
                                       <L-1 L="EN">true:	Polling mode enabled, callback functions (provided to EEP module) disabled.

                                        false:	Polling mode disabled, callback functions (provided to EEP module) enabled.</L-1>
                                    </P>
                                 </INTRODUCTION>
                                 <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_Ea_00123</RELATED-TRACE-ITEM-REF>
                                 <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                 <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                 <SCOPE>LOCAL</SCOPE>
                                 <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                 <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                 <VALUE-CONFIG-CLASSES>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                       <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                       <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                 </VALUE-CONFIG-CLASSES>
                                 <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                              </ECUC-BOOLEAN-PARAM-DEF>
                              <!-- PARAMETER DEFINITION: EaSetModeSupported -->
                              <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:aed5447c-ebbe-4b22-878a-ee0ab4fe3622">
                                 <SHORT-NAME>EaSetModeSupported</SHORT-NAME>
                                 <DESC>
                                    <L-2 L="EN">Compile switch to enable / disable the function Ea_SetMode.</L-2>
                                 </DESC>
                                 <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_Ea_00001</RELATED-TRACE-ITEM-REF>
                                 <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                 <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                 <SCOPE>LOCAL</SCOPE>
                                 <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                 <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                 <VALUE-CONFIG-CLASSES>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                       <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                       <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                 </VALUE-CONFIG-CLASSES>
                                 <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                 <DEFAULT-VALUE>true</DEFAULT-VALUE>
                              </ECUC-BOOLEAN-PARAM-DEF>
                              <!-- PARAMETER DEFINITION: EaVersionInfoApi -->
                              <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:d2c0e417-0cc7-4b7e-9cfe-9052f4736927">
                                 <SHORT-NAME>EaVersionInfoApi</SHORT-NAME>
                                 <DESC>
                                    <L-2 L="EN">Pre-processor switch to enable / disable the API to read out the modules version information.</L-2>
                                 </DESC>
                                 <INTRODUCTION>
                                    <P>
                                       <L-1 L="EN">true:	Version info API enabled.
                                        false:	Version info API disabled.</L-1>
                                    </P>
                                 </INTRODUCTION>
                                 <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_Ea_00124</RELATED-TRACE-ITEM-REF>
                                 <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                 <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                 <SCOPE>LOCAL</SCOPE>
                                 <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                 <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                 <VALUE-CONFIG-CLASSES>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                       <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                       <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                 </VALUE-CONFIG-CLASSES>
                                 <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                              </ECUC-BOOLEAN-PARAM-DEF>
                              <!-- PARAMETER DEFINITION: EaVirtualPageSize -->
                              <ECUC-INTEGER-PARAM-DEF UUID="ECUC:7e38c9b0-11ed-4af3-b258-c643137642d0">
                                 <SHORT-NAME>EaVirtualPageSize</SHORT-NAME>
                                 <DESC>
                                    <L-2 L="EN">The size in bytes to which logical blocks shall be aligned.</L-2>
                                 </DESC>
                                 <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_Ea_00125</RELATED-TRACE-ITEM-REF>
                                 <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                 <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                 <SCOPE>LOCAL</SCOPE>
                                 <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                 <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                 <VALUE-CONFIG-CLASSES>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                       <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                       <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                 </VALUE-CONFIG-CLASSES>
                                 <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                 <MAX>65535</MAX>
                                 <MIN>0</MIN>
                              </ECUC-INTEGER-PARAM-DEF>
                           </PARAMETERS>
                        </ECUC-PARAM-CONF-CONTAINER-DEF>
                        <!-- Container Definition: EaPublishedInformation -->
                        <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:dcc718b0-9772-4964-99d6-ab1aa86e8033">
                           <SHORT-NAME>EaPublishedInformation</SHORT-NAME>
                           <DESC>
                              <L-2 L="EN">Additional published parameters not covered by CommonPublishedInformation container.</L-2>
                           </DESC>
                           <INTRODUCTION>
                              <P>
                                 <L-1 L="EN">Note that these parameters do not have any configuration class setting, since they are published information.</L-1>
                              </P>
                           </INTRODUCTION>
                           <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_Ea_00043</RELATED-TRACE-ITEM-REF>
                           <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                           <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                           <PARAMETERS>
                              <!-- PARAMETER DEFINITION: EaBlockOverhead -->
                              <ECUC-INTEGER-PARAM-DEF UUID="ECUC:8f3bc078-5df6-437e-8a6e-1500dc5c5966">
                                 <SHORT-NAME>EaBlockOverhead</SHORT-NAME>
                                 <DESC>
                                    <L-2 L="EN">Management overhead per logical block in bytes.</L-2>
                                 </DESC>
                                 <INTRODUCTION>
                                    <P>
                                       <L-1 L="EN">Note: If the management overhead depends on the block size or block location a formula has to be provided that allows the configurator to calculate the management overhead correctly.</L-1>
                                    </P>
                                 </INTRODUCTION>
                                 <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_Ea_00126</RELATED-TRACE-ITEM-REF>
                                 <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                 <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                 <SCOPE>LOCAL</SCOPE>
                                 <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                 <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                 <VALUE-CONFIG-CLASSES>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                       <CONFIG-CLASS>PUBLISHED-INFORMATION</CONFIG-CLASS>
                                       <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                 </VALUE-CONFIG-CLASSES>
                                 <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                 <MAX>65535</MAX>
                                 <MIN>0</MIN>
                              </ECUC-INTEGER-PARAM-DEF>
                              <!-- PARAMETER DEFINITION: EaPageOverhead -->
                              <ECUC-INTEGER-PARAM-DEF UUID="ECUC:f5c6f8c3-943e-441b-a0b6-5f1f06db40f2">
                                 <SHORT-NAME>EaPageOverhead</SHORT-NAME>
                                 <DESC>
                                    <L-2 L="EN">Management overhead per page in bytes.</L-2>
                                 </DESC>
                                 <INTRODUCTION>
                                    <P>
                                       <L-1 L="EN">Note: If the management overhead depends on the block size or block location a formula has to be provided that allows the configurator to calculate the management overhead correctly.</L-1>
                                    </P>
                                 </INTRODUCTION>
                                 <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_Ea_00127</RELATED-TRACE-ITEM-REF>
                                 <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                 <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                 <SCOPE>LOCAL</SCOPE>
                                 <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                 <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                 <VALUE-CONFIG-CLASSES>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                       <CONFIG-CLASS>PUBLISHED-INFORMATION</CONFIG-CLASS>
                                       <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                 </VALUE-CONFIG-CLASSES>
                                 <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                 <MAX>65535</MAX>
                                 <MIN>0</MIN>
                              </ECUC-INTEGER-PARAM-DEF>
                           </PARAMETERS>
                        </ECUC-PARAM-CONF-CONTAINER-DEF>
                     </CONTAINERS>
                  </ECUC-MODULE-DEF>
                  <!-- Module Definition: EcuC -->
                  <ECUC-MODULE-DEF UUID="ECUC:f72efedf-ee71-4a1b-b4d6-b77adfbf4cf2">
                     <SHORT-NAME>EcuC</SHORT-NAME>
                     <DESC>
                        <L-2 L="EN">Virtual module to collect ECU Configuration specific / global configuration information.</L-2>
                     </DESC>
                     <ADMIN-DATA>
                        <DOC-REVISIONS>
                           <DOC-REVISION>
                              <REVISION-LABEL>4.2.2</REVISION-LABEL>
                              <ISSUED-BY>AUTOSAR</ISSUED-BY>
                              <DATE>2014-10-31</DATE>
                           </DOC-REVISION>
                        </DOC-REVISIONS>
                     </ADMIN-DATA>
                     <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_EcuC_00008</RELATED-TRACE-ITEM-REF>
                     <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                     <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                     <POST-BUILD-VARIANT-SUPPORT>true</POST-BUILD-VARIANT-SUPPORT>
                     <SUPPORTED-CONFIG-VARIANTS>
                        <SUPPORTED-CONFIG-VARIANT>VARIANT-POST-BUILD</SUPPORTED-CONFIG-VARIANT>
                        <SUPPORTED-CONFIG-VARIANT>VARIANT-PRE-COMPILE</SUPPORTED-CONFIG-VARIANT>
                     </SUPPORTED-CONFIG-VARIANTS>
                     <CONTAINERS>
                        <!-- Container Definition: EcucConfigSet -->
                        <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:37cb0ecf-a6ac-4b05-aaf8-d97ec61f1ae8">
                           <SHORT-NAME>EcucConfigSet</SHORT-NAME>
                           <DESC>
                              <L-2 L="EN">This container contains the configuration parameters and sub containers of the global PduCollection.</L-2>
                           </DESC>
                           <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_EcuC_00061</RELATED-TRACE-ITEM-REF>
                           <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                           <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                           <SUB-CONTAINERS>
                              <!-- Container Definition: EcucPduCollection -->
                              <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:cece0b62-6981-43fb-a5b7-d573fdfb2344">
                                 <SHORT-NAME>EcucPduCollection</SHORT-NAME>
                                 <DESC>
                                    <L-2 L="EN">Collection of all Pdu objects flowing through the Com-Stack.</L-2>
                                 </DESC>
                                 <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_EcuC_00002</RELATED-TRACE-ITEM-REF>
                                 <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                 <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                 <PARAMETERS>
                                    <!-- PARAMETER DEFINITION: PduIdTypeEnum -->
                                    <ECUC-ENUMERATION-PARAM-DEF UUID="ECUC:58955203-89bd-4dcf-b3d4-c5e83c87080b">
                                       <SHORT-NAME>PduIdTypeEnum</SHORT-NAME>
                                       <DESC>
                                          <L-2 L="EN">The PduIdType is used within the entire AUTOSAR Com Stack except for bus drivers. The size of this global type depends on the maximum number of PDUs used within one software module. If no software module deals with more PDUs that 256, this type can be set to uint8. If at least one software module handles more than 256 PDUs, this type must be set to uint16. See AUTOSAR_SWS_CommunicationStackTypes for more details.</L-2>
                                       </DESC>
                                       <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_EcuC_00041</RELATED-TRACE-ITEM-REF>
                                       <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                       <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                       <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                       <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                       <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                       <LITERALS>
                                          <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:331a8418-77d1-db36-f360-72b0ae0c73b6">
                                             <SHORT-NAME>UINT16</SHORT-NAME>
                                             <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                          </ECUC-ENUMERATION-LITERAL-DEF>
                                          <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:74f5ad84-30ee-dd82-07d3-02065af14706">
                                             <SHORT-NAME>UINT8</SHORT-NAME>
                                             <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                          </ECUC-ENUMERATION-LITERAL-DEF>
                                       </LITERALS>
                                    </ECUC-ENUMERATION-PARAM-DEF>
                                    <!-- PARAMETER DEFINITION: PduLengthTypeEnum -->
                                    <ECUC-ENUMERATION-PARAM-DEF UUID="ECUC:3ffce745-6c26-4c88-a57f-cd785b21e467">
                                       <SHORT-NAME>PduLengthTypeEnum</SHORT-NAME>
                                       <DESC>
                                          <L-2 L="EN">The PduLengthType is used within the entire AUTOSAR Com Stack except for bus drivers. The size of this global type depends on the maximum length of PDUs to be sent by an ECU. If no segmentation is used the length depends on the maximum payload size of a frame of the underlying communication system (for FlexRay maximum size is 255 bytes, therefore uint8). If segmentation is used it depends on the maximum length of a  segmented N-PDU (in general uint16 is used). See AUTOSAR_SWS_CommunicationStackTypes for more details.</L-2>
                                       </DESC>
                                       <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_EcuC_00042</RELATED-TRACE-ITEM-REF>
                                       <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                       <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                       <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                       <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                       <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                       <LITERALS>
                                          <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:1a82195a-5a3a-d9ef-e50b-7a40cca75012">
                                             <SHORT-NAME>UINT16</SHORT-NAME>
                                             <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                          </ECUC-ENUMERATION-LITERAL-DEF>
                                          <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:71d1c418-a527-86b0-4d9d-21c19a6fd501">
                                             <SHORT-NAME>UINT32</SHORT-NAME>
                                             <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                          </ECUC-ENUMERATION-LITERAL-DEF>
                                          <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:5c5d42c6-1357-dc3b-f97e-0996798c2362">
                                             <SHORT-NAME>UINT8</SHORT-NAME>
                                             <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                          </ECUC-ENUMERATION-LITERAL-DEF>
                                       </LITERALS>
                                    </ECUC-ENUMERATION-PARAM-DEF>
                                 </PARAMETERS>
                                 <SUB-CONTAINERS>
                                    <!-- Container Definition: Pdu -->
                                    <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:422a7abf-add2-418a-81a6-af5cdeae1930">
                                       <SHORT-NAME>Pdu</SHORT-NAME>
                                       <DESC>
                                          <L-2 L="EN">One Pdu flowing through the COM-Stack.</L-2>
                                       </DESC>
                                       <INTRODUCTION>
                                          <P>
                                             <L-1 L="EN">This Pdu is used by all Com-Stack modules to agree on referencing the same Pdu.</L-1>
                                          </P>
                                       </INTRODUCTION>
                                       <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_EcuC_00001</RELATED-TRACE-ITEM-REF>
                                       <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                       <UPPER-MULTIPLICITY-INFINITE>true</UPPER-MULTIPLICITY-INFINITE>
                                       <MULTIPLICITY-CONFIG-CLASSES>
                                          <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                             <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                             <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                          </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                          <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                             <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                             <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                          </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                       </MULTIPLICITY-CONFIG-CLASSES>
                                       <POST-BUILD-VARIANT-MULTIPLICITY>true</POST-BUILD-VARIANT-MULTIPLICITY>
                                       <PARAMETERS>
                                          <!-- PARAMETER DEFINITION: J1939Requestable -->
                                          <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:5f51de6e-5995-4e90-b083-1d5b7a90848c">
                                             <SHORT-NAME>J1939Requestable</SHORT-NAME>
                                             <DESC>
                                                <L-2 L="EN">Pdu can be triggered by the J1939 request message.</L-2>
                                             </DESC>
                                             <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_EcuC_00072</RELATED-TRACE-ITEM-REF>
                                             <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                             <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                             <MULTIPLICITY-CONFIG-CLASSES>
                                                <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                                </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                                <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                                </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                             </MULTIPLICITY-CONFIG-CLASSES>
                                             <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                             <POST-BUILD-VARIANT-MULTIPLICITY>true</POST-BUILD-VARIANT-MULTIPLICITY>
                                             <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                                             <VALUE-CONFIG-CLASSES>
                                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                             </VALUE-CONFIG-CLASSES>
                                             <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                          </ECUC-BOOLEAN-PARAM-DEF>
                                          <!-- PARAMETER DEFINITION: MetaDataLength -->
                                          <ECUC-INTEGER-PARAM-DEF UUID="ECUC:c838922b-b316-448d-9231-b37db46d7178">
                                             <SHORT-NAME>MetaDataLength</SHORT-NAME>
                                             <DESC>
                                                <L-2 L="EN">Number of additional bytes in PDU data that contain auxiliary information (MetaData) for the PDU, e.g. the CAN ID. These bytes are handled as part of the PDU data and increase the PDU data length accordingly.</L-2>
                                             </DESC>
                                             <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_EcuC_00055</RELATED-TRACE-ITEM-REF>
                                             <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                             <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                             <MULTIPLICITY-CONFIG-CLASSES>
                                                <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                                </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                                <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                                </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                             </MULTIPLICITY-CONFIG-CLASSES>
                                             <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                             <POST-BUILD-VARIANT-MULTIPLICITY>true</POST-BUILD-VARIANT-MULTIPLICITY>
                                             <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                                             <VALUE-CONFIG-CLASSES>
                                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                             </VALUE-CONFIG-CLASSES>
                                             <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                             <DEFAULT-VALUE>0</DEFAULT-VALUE>
                                             <MAX>4</MAX>
                                             <MIN>0</MIN>
                                          </ECUC-INTEGER-PARAM-DEF>
                                          <!-- PARAMETER DEFINITION: PduLength -->
                                          <ECUC-INTEGER-PARAM-DEF UUID="ECUC:3996a201-ffdf-43d1-a5e8-f88592a78a35">
                                             <SHORT-NAME>PduLength</SHORT-NAME>
                                             <DESC>
                                                <L-2 L="EN">Length of the Pdu in bytes.  It should be noted that in former AUTOSAR releases (Rel 2.1, Rel 3.0, Rel 3.1, Rel 4.0 Rev. 1) this parameter was defined in bits.</L-2>
                                             </DESC>
                                             <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_EcuC_00003</RELATED-TRACE-ITEM-REF>
                                             <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                             <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                             <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                             <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                                             <VALUE-CONFIG-CLASSES>
                                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                             </VALUE-CONFIG-CLASSES>
                                             <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                             <MAX>4294967295</MAX>
                                             <MIN>0</MIN>
                                          </ECUC-INTEGER-PARAM-DEF>
                                       </PARAMETERS>
                                       <REFERENCES>
                                          <!-- Foreign Reference Definition: SysTPduToFrameTriggeringRef -->
                                          <ECUC-FOREIGN-REFERENCE-DEF UUID="ECUC:c540d959-e145-47c1-b8d4-7bba46200f34">
                                             <SHORT-NAME>SysTPduToFrameTriggeringRef</SHORT-NAME>
                                             <DESC>
                                                <L-2 L="EN">Reference to the FrameTriggering from the SystemTemplate which this Pdu belongs to.</L-2>
                                             </DESC>
                                             <INTRODUCTION>
                                                <P>
                                                   <L-1 L="EN">SysTPduToFrameTriggeringRef shall be used for UserDefinedPdus, NmPdus and NPdus which are not going through the Pdu Router. This reference shall not be used if SysTPduToPduTriggeringRef exists.</L-1>
                                                </P>
                                             </INTRODUCTION>
                                             <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_EcuC_00052</RELATED-TRACE-ITEM-REF>
                                             <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                             <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                             <MULTIPLICITY-CONFIG-CLASSES>
                                                <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                                </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                                <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                                </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                             </MULTIPLICITY-CONFIG-CLASSES>
                                             <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                             <POST-BUILD-VARIANT-MULTIPLICITY>true</POST-BUILD-VARIANT-MULTIPLICITY>
                                             <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                                             <VALUE-CONFIG-CLASSES>
                                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                             </VALUE-CONFIG-CLASSES>
                                             <DESTINATION-TYPE>FRAME-TRIGGERING</DESTINATION-TYPE>
                                          </ECUC-FOREIGN-REFERENCE-DEF>
                                          <!-- Foreign Reference Definition: SysTPduToPduTriggeringRef -->
                                          <ECUC-FOREIGN-REFERENCE-DEF UUID="ECUC:8ae470f5-d0b3-40ad-b681-a858fc793be3">
                                             <SHORT-NAME>SysTPduToPduTriggeringRef</SHORT-NAME>
                                             <DESC>
                                                <L-2 L="EN">Reference to the PduTriggering from the SystemTemplate which this Pdu represents.</L-2>
                                             </DESC>
                                             <INTRODUCTION>
                                                <P>
                                                   <L-1 L="EN">SysTPduToPduTriggeringRef shall be used for all Pdus except UserDefinedPdus, NmPdus and NPdus which are not going through the Pdu Router. For these Pdus, SysTPduToFrameTriggeringRef shall be used.</L-1>
                                                </P>
                                             </INTRODUCTION>
                                             <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_EcuC_00054</RELATED-TRACE-ITEM-REF>
                                             <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                             <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                             <MULTIPLICITY-CONFIG-CLASSES>
                                                <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                                </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                                <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                                </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                             </MULTIPLICITY-CONFIG-CLASSES>
                                             <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                             <POST-BUILD-VARIANT-MULTIPLICITY>true</POST-BUILD-VARIANT-MULTIPLICITY>
                                             <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                                             <VALUE-CONFIG-CLASSES>
                                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                             </VALUE-CONFIG-CLASSES>
                                             <DESTINATION-TYPE>PDU-TRIGGERING</DESTINATION-TYPE>
                                          </ECUC-FOREIGN-REFERENCE-DEF>
                                       </REFERENCES>
                                    </ECUC-PARAM-CONF-CONTAINER-DEF>
                                 </SUB-CONTAINERS>
                              </ECUC-PARAM-CONF-CONTAINER-DEF>
                           </SUB-CONTAINERS>
                        </ECUC-PARAM-CONF-CONTAINER-DEF>
                        <!-- Container Definition: EcucHardware -->
                        <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:4494efcd-a0fa-42f6-9f5d-25817cdc0188">
                           <SHORT-NAME>EcucHardware</SHORT-NAME>
                           <DESC>
                              <L-2 L="EN">Hardware definition of this Ecu.</L-2>
                           </DESC>
                           <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_EcuC_00056</RELATED-TRACE-ITEM-REF>
                           <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                           <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                           <SUB-CONTAINERS>
                              <!-- Container Definition: EcucCoreDefinition -->
                              <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:e12b8e86-0925-4854-b1a6-adee8a2cf090">
                                 <SHORT-NAME>EcucCoreDefinition</SHORT-NAME>
                                 <DESC>
                                    <L-2 L="EN">Definition of one Core on this Ecu.</L-2>
                                 </DESC>
                                 <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_EcuC_00057</RELATED-TRACE-ITEM-REF>
                                 <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                 <UPPER-MULTIPLICITY-INFINITE>true</UPPER-MULTIPLICITY-INFINITE>
                                 <PARAMETERS>
                                    <!-- PARAMETER DEFINITION: EcucCoreId -->
                                    <ECUC-INTEGER-PARAM-DEF UUID="ECUC:9127a2e5-b908-4f76-b741-655836d78c67">
                                       <SHORT-NAME>EcucCoreId</SHORT-NAME>
                                       <DESC>
                                          <L-2 L="EN">ID of the core.</L-2>
                                       </DESC>
                                       <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_EcuC_00058</RELATED-TRACE-ITEM-REF>
                                       <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                       <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                       <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                       <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
