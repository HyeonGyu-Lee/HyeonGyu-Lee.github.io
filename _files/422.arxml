                                                   </DESC>
                                                   <INTRODUCTION>
                                                      <P>
                                                         <L-1 L="EN">Implementation Type: Dcm_ProtocolType</L-1>
                                                      </P>
                                                   </INTRODUCTION>
                                                   <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_Dcm_00696</RELATED-TRACE-ITEM-REF>
