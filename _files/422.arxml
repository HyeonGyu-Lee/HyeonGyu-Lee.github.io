                                    <P>
                                       <L-1 L="EN">False: Partial Networking Gateway is disabled
                                        True: Partial Networking Gateway is enabled</L-1>
                                    </P>
                                 </INTRODUCTION>
                                 <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_ComM_00887</RELATED-TRACE-ITEM-REF>
                                 <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
