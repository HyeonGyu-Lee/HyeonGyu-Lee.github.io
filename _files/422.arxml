                                                   <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                             </VALUE-CONFIG-CLASSES>
                                             <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                             <DEFAULT-VALUE>false</DEFAULT-VALUE>
                                          </ECUC-BOOLEAN-PARAM-DEF>
                                       </PARAMETERS>
                                       <SUB-CONTAINERS>
                                          <!-- Container Definition: CanTrcvPnFrameDataMaskSpec -->
                                          <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:a8cf14ab-3c00-4929-adf3-38a776992bf6">
                                             <SHORT-NAME>CanTrcvPnFrameDataMaskSpec</SHORT-NAME>
                                             <DESC>
                                                <L-2 L="EN">Defines data payload mask to be used on the received payload in order to determine if the transceiver must be woken up by the received Wake-up Frame (WUF).</L-2>
                                             </DESC>
                                             <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_CanTrcv_00165</RELATED-TRACE-ITEM-REF>
                                             <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                             <UPPER-MULTIPLICITY>8</UPPER-MULTIPLICITY>
                                             <PARAMETERS>
                                                <!-- PARAMETER DEFINITION: CanTrcvPnFrameDataMask -->
                                                <ECUC-INTEGER-PARAM-DEF UUID="ECUC:656a6966-3a40-4948-9b0a-562933acdeb9">
                                                   <SHORT-NAME>CanTrcvPnFrameDataMask</SHORT-NAME>
                                                   <DESC>
                                                      <L-2 L="EN">Defines the n byte (Byte0 = LSB) of the data payload mask to be used on the received payload in order to determine if the transceiver must be woken up by the received Wake-up Frame (WUF).</L-2>
                                                   </DESC>
                                                   <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_CanTrcv_00166</RELATED-TRACE-ITEM-REF>
                                                   <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                                   <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                                   <SCOPE>LOCAL</SCOPE>
                                                   <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                                   <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                                                   <VALUE-CONFIG-CLASSES>
                                                      <ECUC-VALUE-CONFIGURATION-CLASS>
                                                         <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                                         <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                                      </ECUC-VALUE-CONFIGURATION-CLASS>
                                                      <ECUC-VALUE-CONFIGURATION-CLASS>
                                                         <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                         <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                                      </ECUC-VALUE-CONFIGURATION-CLASS>
                                                   </VALUE-CONFIG-CLASSES>
                                                   <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                                   <MAX>255</MAX>
                                                   <MIN>0</MIN>
                                                </ECUC-INTEGER-PARAM-DEF>
                                                <!-- PARAMETER DEFINITION: CanTrcvPnFrameDataMaskIndex -->
                                                <ECUC-INTEGER-PARAM-DEF UUID="ECUC:9693190e-eb2c-4688-a833-a834acc4d8d2">
                                                   <SHORT-NAME>CanTrcvPnFrameDataMaskIndex</SHORT-NAME>
                                                   <DESC>
                                                      <L-2 L="EN">holds the position n in frame of the mask-part</L-2>
                                                   </DESC>
                                                   <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_CanTrcv_00167</RELATED-TRACE-ITEM-REF>
                                                   <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
