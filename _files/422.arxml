                              </ECUC-BOOLEAN-PARAM-DEF>
                              <!-- PARAMETER DEFINITION: LinNmRemoteSleepIndicationEnabled -->
                              <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:61c8f2bc-ea1c-415d-be2d-debd42b3dd45">
                                 <SHORT-NAME>LinNmRemoteSleepIndicationEnabled</SHORT-NAME>
                                 <DESC>
                                    <L-2 L="EN">Pre-processor switch for enabling Remote Sleep Indication support. This feature is required for NM Coordinator nodes only.</L-2>
                                 </DESC>
                                 <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_LinNm_00016</RELATED-TRACE-ITEM-REF>
                                 <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
