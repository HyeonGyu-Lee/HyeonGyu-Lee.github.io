                                          <!-- Container Definition: DcmDspStopRoutine -->
                                          <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:0d70b637-3bc1-44c2-bb4e-08db96caa9f4">
                                             <SHORT-NAME>DcmDspStopRoutine</SHORT-NAME>
                                             <DESC>
                                                <L-2 L="EN">Provides the configuration of Stop subservice for RoutineControl service.</L-2>
                                             </DESC>
                                             <INTRODUCTION>
                                                <P>
                                                   <L-1 L="EN">Existence indicates that the StopRoutine in the RoutineControl is supported.</L-1>
                                                </P>
                                             </INTRODUCTION>
                                             <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_Dcm_01022</RELATED-TRACE-ITEM-REF>
