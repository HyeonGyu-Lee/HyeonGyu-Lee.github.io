                                    <ECUC-FUNCTION-NAME-DEF UUID="ECUC:a1575dfa-04a7-496c-bb71-d5dbf722f0cc">
                                       <SHORT-NAME>RamTstTestErrorNotification</SHORT-NAME>
                                       <DESC>
                                          <L-2 L="EN">This function will be called from a background test if an error occurs during the RAM test.</L-2>
                                       </DESC>
                                       <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_RamTst_00139</RELATED-TRACE-ITEM-REF>
                                       <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                       <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                       <SCOPE>LOCAL</SCOPE>
                                       <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                       <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                       <VALUE-CONFIG-CLASSES>
                                          <ECUC-VALUE-CONFIGURATION-CLASS>
                                             <CONFIG-CLASS>LINK</CONFIG-CLASS>
                                             <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                                          </ECUC-VALUE-CONFIGURATION-CLASS>
                                          <ECUC-VALUE-CONFIGURATION-CLASS>
                                             <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                             <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                          </ECUC-VALUE-CONFIGURATION-CLASS>
                                       </VALUE-CONFIG-CLASSES>
                                       <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                       <ECUC-FUNCTION-NAME-DEF-VARIANTS>
                                          <ECUC-FUNCTION-NAME-DEF-CONDITIONAL/>
                                       </ECUC-FUNCTION-NAME-DEF-VARIANTS>
                                    </ECUC-FUNCTION-NAME-DEF>
                                 </PARAMETERS>
                                 <SUB-CONTAINERS>
                                    <!-- Container Definition: RamTstAlgParams -->
                                    <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:72143fb4-1c83-44dc-8753-282521328089">
                                       <SHORT-NAME>RamTstAlgParams</SHORT-NAME>
                                       <DESC>
                                          <L-2 L="EN">This container holds parameters for configuring an algorithm.  For each algorithm selected in the RamTst_Algorithms container there can be one or more RamTstAlgParams containers. The multiplicity of the included container RamTstBlockParams depends on the number of separate blocks of RAM which are defined for the particular test configuration.</L-2>
                                       </DESC>
                                       <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_RamTst_00090</RELATED-TRACE-ITEM-REF>
                                       <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                       <UPPER-MULTIPLICITY>255</UPPER-MULTIPLICITY>
                                       <PARAMETERS>
                                          <!-- PARAMETER DEFINITION: RamTstAlgParamsId -->
                                          <ECUC-INTEGER-PARAM-DEF UUID="ECUC:ee97557e-a517-4dc6-a63d-e47756d5572f">
                                             <SHORT-NAME>RamTstAlgParamsId</SHORT-NAME>
                                             <DESC>
                                                <L-2 L="EN">This is the identifier by which this RamTstAlgParams set can be selected.</L-2>
                                             </DESC>
                                             <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_RamTst_00179</RELATED-TRACE-ITEM-REF>
                                             <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                             <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                             <SCOPE>LOCAL</SCOPE>
                                             <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                             <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                             <VALUE-CONFIG-CLASSES>
                                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>LINK</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                             </VALUE-CONFIG-CLASSES>
                                             <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                             <MAX>255</MAX>
                                             <MIN>1</MIN>
                                          </ECUC-INTEGER-PARAM-DEF>
                                          <!-- PARAMETER DEFINITION: RamTstAlgorithm -->
                                          <ECUC-ENUMERATION-PARAM-DEF UUID="ECUC:c7ffb64f-2076-45ab-83c3-8c16a01d9a62">
                                             <SHORT-NAME>RamTstAlgorithm</SHORT-NAME>
                                             <DESC>
                                                <L-2 L="EN">This is the algorithm for which this RamTstAlgParams set is defined. Note that the same algorithm can be used in more than one RamTstAlgParams.</L-2>
                                             </DESC>
                                             <INTRODUCTION>
                                                <P>
                                                   <L-1 L="EN">Constraint: Only the algorithms selected by RamTstCommon/ RamTstAlgorithms can be used.</L-1>
                                                </P>
                                             </INTRODUCTION>
                                             <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_RamTst_00178</RELATED-TRACE-ITEM-REF>
                                             <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                             <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                             <SCOPE>LOCAL</SCOPE>
                                             <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                             <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                             <VALUE-CONFIG-CLASSES>
                                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>LINK</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                             </VALUE-CONFIG-CLASSES>
                                             <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                             <LITERALS>
                                                <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:89235eef-f97e-92cc-2242-250c14ff289b">
                                                   <SHORT-NAME>RAMTST_ABRAHAM_TEST</SHORT-NAME>
                                                   <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                                </ECUC-ENUMERATION-LITERAL-DEF>
                                                <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:2faa6741-6e4d-9315-2ebb-983974b2121c">
                                                   <SHORT-NAME>RAMTST_CHECKERBOARD_TEST</SHORT-NAME>
                                                   <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                                </ECUC-ENUMERATION-LITERAL-DEF>
                                                <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:90e9f327-35e1-8f1d-3930-313399247e6a">
                                                   <SHORT-NAME>RAMTST_GALPAT_TEST</SHORT-NAME>
                                                   <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                                </ECUC-ENUMERATION-LITERAL-DEF>
                                                <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:06effc39-22d4-8744-462b-64cdcd759234">
                                                   <SHORT-NAME>RAMTST_MARCH_TEST</SHORT-NAME>
                                                   <ORIGIN>AUTOSAR_ECUC</ORIGIN>
