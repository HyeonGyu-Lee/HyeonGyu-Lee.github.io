                                          <ECUC-INTEGER-PARAM-DEF UUID="ECUC:39dd75c8-8b0d-4180-9f2c-35d51b39a4b7">
                                             <SHORT-NAME>SdServerTimerInitialOfferRepetitionsMax</SHORT-NAME>
                                             <DESC>
                                                <L-2 L="EN">Configure the maximum amount of offer repetition. This parameter is mandatory for ServerService.</L-2>
                                             </DESC>
                                             <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_SD_00040</RELATED-TRACE-ITEM-REF>
                                             <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                             <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
