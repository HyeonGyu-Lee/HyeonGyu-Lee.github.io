                                 </PARAMETERS>
                                 <SUB-CONTAINERS>
                                    <!-- Container Definition: ComMNetworkManagement -->
                                    <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:fe18e019-1dc0-4fcb-818a-6e88f759c44f">
                                       <SHORT-NAME>ComMNetworkManagement</SHORT-NAME>
                                       <DESC>
                                          <L-2 L="EN">This container contains the configuration parameters of the networkmanagement.</L-2>
                                       </DESC>
                                       <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_ComM_00607</RELATED-TRACE-ITEM-REF>
                                       <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                       <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                       <PARAMETERS>
                                          <!-- PARAMETER DEFINITION: ComMNmLightTimeout -->
                                          <ECUC-FLOAT-PARAM-DEF UUID="ECUC:d4d7b08e-0dbf-4558-bad7-70c29e72889a">
                                             <SHORT-NAME>ComMNmLightTimeout</SHORT-NAME>
                                             <DESC>
                                                <L-2 L="EN">Defines the timeout (in seconds) after COMM_FULL_COMMUNICATION sub-state COMM_FULL_COM_READY_SLEEP is left.</L-2>
                                             </DESC>
                                             <INTRODUCTION>
                                                <P>
                                                   <L-1 L="EN">The range shall be greater than 0.0 and less or equal to 255.0.</L-1>
                                                </P>
                                             </INTRODUCTION>
                                             <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_ComM_00606</RELATED-TRACE-ITEM-REF>
                                             <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                             <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                             <SCOPE>LOCAL</SCOPE>
                                             <MULTIPLICITY-CONFIG-CLASSES>
                                                <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                                </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                                <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                                </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                             </MULTIPLICITY-CONFIG-CLASSES>
                                             <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                             <POST-BUILD-VARIANT-MULTIPLICITY>false</POST-BUILD-VARIANT-MULTIPLICITY>
                                             <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                             <VALUE-CONFIG-CLASSES>
                                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                             </VALUE-CONFIG-CLASSES>
                                             <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                             <DEFAULT-VALUE>10</DEFAULT-VALUE>
                                             <MAX>255</MAX>
                                             <MIN>0</MIN>
                                          </ECUC-FLOAT-PARAM-DEF>
                                          <!-- PARAMETER DEFINITION: ComMNmVariant -->
                                          <ECUC-ENUMERATION-PARAM-DEF UUID="ECUC:26eeb597-a431-438b-bf4b-e3e94b449731">
                                             <SHORT-NAME>ComMNmVariant</SHORT-NAME>
                                             <DESC>
                                                <L-2 L="EN">Defines the functionality of the networkmanagement.</L-2>
                                             </DESC>
                                             <INTRODUCTION>
                                                <P>
                                                   <L-1 L="EN">Shall be harmonized with NM configuration.</L-1>
                                                </P>
                                             </INTRODUCTION>
                                             <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_ComM_00568</RELATED-TRACE-ITEM-REF>
                                             <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                             <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                             <SCOPE>LOCAL</SCOPE>
                                             <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                             <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                             <VALUE-CONFIG-CLASSES>
                                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                             </VALUE-CONFIG-CLASSES>
                                             <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                             <DEFAULT-VALUE>FULL</DEFAULT-VALUE>
                                             <LITERALS>
                                                <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:522ee0d4-3f70-9229-02a4-cde04dacf646">
                                                   <SHORT-NAME>FULL</SHORT-NAME>
                                                   <ORIGIN>AUTOSAR_ECUC</ORIGIN>
