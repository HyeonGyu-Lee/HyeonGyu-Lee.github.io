                              <ECUC-INTEGER-PARAM-DEF UUID="ECUC:2bd0c280-d8db-4a93-b38f-bc18a85780aa">
                                 <SHORT-NAME>ComSupportedIPduGroups</SHORT-NAME>
                                 <DESC>
                                    <L-2 L="EN">Defines the maximum number of supported I-PDU groups.</L-2>
                                 </DESC>
