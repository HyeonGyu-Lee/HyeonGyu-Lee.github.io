                                       </DESC>
                                       <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_LinTp_00064</RELATED-TRACE-ITEM-REF>
                                       <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
