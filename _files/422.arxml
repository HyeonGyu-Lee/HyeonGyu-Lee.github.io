                        <!-- Container Definition: IcuGeneral -->
                        <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:1d7a6ee1-8bc5-4f5f-b509-c17e210792d6">
                           <SHORT-NAME>IcuGeneral</SHORT-NAME>
                           <DESC>
                              <L-2 L="EN">Configuration of general ICU parameters.</L-2>
                           </DESC>
                           <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_Icu_00026</RELATED-TRACE-ITEM-REF>
                           <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                           <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                           <PARAMETERS>
                              <!-- PARAMETER DEFINITION: IcuDevErrorDetect -->
                              <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:7224bf75-cdc8-408f-91ff-3a99e7a18f84">
                                 <SHORT-NAME>IcuDevErrorDetect</SHORT-NAME>
                                 <DESC>
                                    <L-2 L="EN">Switches the Default Error Tracer (Det) detection and notification ON or OFF.</L-2>
                                 </DESC>
                                 <INTRODUCTION>
                                    <P>
                                       <L-1 L="EN">* true: enabled (ON).
                                        * false: disabled (OFF).</L-1>
                                    </P>
                                 </INTRODUCTION>
                                 <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_Icu_00232</RELATED-TRACE-ITEM-REF>
                                 <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                 <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                 <SCOPE>LOCAL</SCOPE>
                                 <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                 <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
