                                                            <!-- Symbolic Name Reference Definition: DcmDslProtocolComMChannelRef -->
                                                            <ECUC-SYMBOLIC-NAME-REFERENCE-DEF UUID="ECUC:855610d2-6cfe-4554-af1b-1642fe0b6c4d">
                                                               <SHORT-NAME>DcmDslProtocolComMChannelRef</SHORT-NAME>
                                                               <DESC>
                                                                  <L-2 L="EN">Reference to the ComMChannel on which the DcmDslProtocolRxPdu is received and the DcmDslProtocolTxPdu is transmitted.</L-2>
                                                               </DESC>
                                                               <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_Dcm_00952</RELATED-TRACE-ITEM-REF>
                                                               <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                                               <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
