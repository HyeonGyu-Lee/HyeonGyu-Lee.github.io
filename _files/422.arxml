                                 <SHORT-NAME>ComMResetAfterForcingNoComm</SHORT-NAME>
                                 <DESC>
                                    <L-2 L="EN">ComM shall perform a reset after entering "No Communication" mode because of an active mode limitation to "No Communication" mode.</L-2>
                                 </DESC>
                                 <INTRODUCTION>
                                    <P>
                                       <L-1 L="EN">true: Enabled
                                        false: Disabled</L-1>
                                    </P>
                                 </INTRODUCTION>
                                 <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_ComM_00558</RELATED-TRACE-ITEM-REF>
