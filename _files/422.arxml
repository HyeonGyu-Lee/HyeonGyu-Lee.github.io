                                                   <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                             </VALUE-CONFIG-CLASSES>
                                             <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                             <DEFAULT-VALUE>false</DEFAULT-VALUE>
                                          </ECUC-BOOLEAN-PARAM-DEF>
                                          <!-- PARAMETER DEFINITION: SdClientServiceHandleId -->
                                          <ECUC-INTEGER-PARAM-DEF UUID="ECUC:e55d49c4-21ba-4b1c-8dbd-5d33c6c343c0">
                                             <SHORT-NAME>SdClientServiceHandleId</SHORT-NAME>
                                             <DESC>
                                                <L-2 L="EN">The HandleId by which the BswM can identify this Client Service Instance.</L-2>
                                             </DESC>
