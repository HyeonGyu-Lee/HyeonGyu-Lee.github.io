                                             <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                          </ECUC-VALUE-CONFIGURATION-CLASS>
                                       </VALUE-CONFIG-CLASSES>
                                       <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                    </ECUC-BOOLEAN-PARAM-DEF>
                                 </PARAMETERS>
                                 <REFERENCES>
                                    <!-- Reference Definition: FrNmPnEiraRxNSduRef -->
                                    <ECUC-REFERENCE-DEF UUID="ECUC:debf2dcf-ce84-4c52-af2b-642dbffb8346">
                                       <SHORT-NAME>FrNmPnEiraRxNSduRef</SHORT-NAME>
                                       <DESC>
                                          <L-2 L="EN">Reference to a Pdu in the COM-Stack.</L-2>
                                       </DESC>
                                       <INTRODUCTION>
                                          <P>
                                             <L-1 L="EN">Only one SduRef is required for FrNm because the EIRA is the aggregation over all FlexRay Channels.</L-1>
                                          </P>
                                       </INTRODUCTION>
                                       <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_FrNm_00069</RELATED-TRACE-ITEM-REF>
                                       <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                       <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
