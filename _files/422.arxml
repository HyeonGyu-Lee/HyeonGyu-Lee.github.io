                                          <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:1466d83f-619c-4bc9-9e6f-cc6c27153c4b">
                                             <SHORT-NAME>J1939RmUserSendRequest</SHORT-NAME>
                                             <DESC>
                                                <L-2 L="EN">Enable the SendRequest API for this module. In case of RTE, the operation SendRequest of the provided port J1939Rm_SendRequest_{user} is called.</L-2>
                                             </DESC>
                                             <INTRODUCTION>
                                                <P>
                                                   <L-1 L="EN">This parameter shall not be set for J1939RmUserType J1939RM_USER_J1939NM, J1939RM_USER_J1939DCM, or J1939RM_USER_COM.</L-1>
                                                </P>
                                             </INTRODUCTION>
                                             <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_J1939Rm_00029</RELATED-TRACE-ITEM-REF>
