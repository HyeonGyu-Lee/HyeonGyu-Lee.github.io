                                                            <ECUC-CHOICE-CONTAINER-DEF UUID="ECUC:87608d90-bfb5-8f47-3dda-52c2cb66ad0d">
                                                               <SHORT-NAME>DcmDspArgumentScaling</SHORT-NAME>
                                                               <DESC>
                                                                  <L-2 L="EN">This container contains the configuration (arguments) of an alternative Diagnosis Representation. Out if this the scaling between Diagnosis and ECU internal representation and vice versa can be calculated.</L-2>
                                                               </DESC>
                                                               <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_Dcm_01062</RELATED-TRACE-ITEM-REF>
                                                               <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
