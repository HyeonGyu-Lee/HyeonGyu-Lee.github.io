                                          <!-- PARAMETER DEFINITION: SdServerTimerInitialOfferRepetitionBaseDelay -->
                                          <ECUC-FLOAT-PARAM-DEF UUID="ECUC:d29dcea0-ce20-48c0-9107-19d90b75f6ff">
                                             <SHORT-NAME>SdServerTimerInitialOfferRepetitionBaseDelay</SHORT-NAME>
                                             <DESC>
                                                <L-2 L="EN">The base delay in [s] for offer repetitions. Successive offers have an exponential back off delay (1x base delay, 2x base delay, 4x base delay, ...). This parameter is mandatory for ServerService.</L-2>
                                             </DESC>
                                             <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_SD_00041</RELATED-TRACE-ITEM-REF>
                                             <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                             <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
