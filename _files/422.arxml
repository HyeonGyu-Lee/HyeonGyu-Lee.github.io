                              </ECUC-BOOLEAN-PARAM-DEF>
                              <!-- PARAMETER DEFINITION: OcuSetRelativeThresholdApi -->
                              <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:aa3df9f3-f48b-402f-b1a2-e05546637c64">
                                 <SHORT-NAME>OcuSetRelativeThresholdApi</SHORT-NAME>
                                 <DESC>
                                    <L-2 L="EN">Adds / removes the service Ocu_SetRelativeThreshold() from the code.</L-2>
                                 </DESC>
