                                          <!-- Container Definition: SdProvidedMethods -->
                                          <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:c44675a1-0711-453d-875f-d581bcf43cfc">
                                             <SHORT-NAME>SdProvidedMethods</SHORT-NAME>
                                             <DESC>
                                                <L-2 L="EN">Container element for representing the needed elements of the data path for the methods provided by the service.</L-2>
                                             </DESC>
                                             <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_SD_00087</RELATED-TRACE-ITEM-REF>
                                             <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                             <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                             <REFERENCES>
                                                <!-- Symbolic Name Reference Definition: SdServerServiceActivationRef -->
                                                <ECUC-SYMBOLIC-NAME-REFERENCE-DEF UUID="ECUC:41afbb7c-420b-4239-bcc8-a2aaeaf9bd27">
                                                   <SHORT-NAME>SdServerServiceActivationRef</SHORT-NAME>
                                                   <DESC>
                                                      <L-2 L="EN">Reference to a SoAdRoutingGroup to activated and deactivate the data path for methods of the service.</L-2>
                                                   </DESC>
