                              <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:393d1df2-c7d9-4d1b-9b1f-37b58840b592">
                                 <SHORT-NAME>BswMWdgMEnabled</SHORT-NAME>
                                 <DESC>
                                    <L-2 L="EN">enable/disable WdgM module related BswM API:</L-2>
                                 </DESC>
                                 <INTRODUCTION>
                                    <P>
                                       <L-1 L="EN">true: Enabled
                                        false: Disabled</L-1>
                                    </P>
