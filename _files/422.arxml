                              <!-- PARAMETER DEFINITION: SpiUserCallbackHeaderFile -->
                              <ECUC-STRING-PARAM-DEF UUID="ECUC:aba4ab85-f272-4176-9ef8-77dae4986166">
                                 <SHORT-NAME>SpiUserCallbackHeaderFile</SHORT-NAME>
                                 <DESC>
                                    <L-2 L="EN">Header file name which will be included by the Spi. The value of this parameter shall be used as h-char-sequence or q-char-sequence according to ISO C90 section 6.10.2 "source file inclusion". The parameter value MUST NOT represent a path, since ISO C90 does not specify how such a path is treated (i.e., this is implementation defined (and additionally depends on the operating system and the underlying file system)).</L-2>
                                 </DESC>
                                 <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_Spi_00243</RELATED-TRACE-ITEM-REF>
                                 <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                 <UPPER-MULTIPLICITY-INFINITE>true</UPPER-MULTIPLICITY-INFINITE>
                                 <SCOPE>LOCAL</SCOPE>
