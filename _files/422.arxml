                                       <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                       <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                       <PARAMETERS>
                                          <!-- PARAMETER DEFINITION: FrNmActiveWakeupBitEnabled -->
                                          <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:e820dac6-c370-4a46-83bf-662f04593b5d">
                                             <SHORT-NAME>FrNmActiveWakeupBitEnabled</SHORT-NAME>
                                             <DESC>
                                                <L-2 L="EN">Enables/Disables the handling of the Active Wakeup Bit in the FrNm module.</L-2>
                                             </DESC>
