                                    <ECUC-ENUMERATION-PARAM-DEF UUID="ECUC:cfe28085-a28d-960f-3851-70ddf4bc2f18">
                                       <SHORT-NAME>RteExclusiveAreaImplMechanism</SHORT-NAME>
