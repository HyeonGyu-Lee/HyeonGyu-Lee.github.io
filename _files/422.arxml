                                    <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:03522dfa-716f-4cae-b216-c32f5ff584ce">
                                       <SHORT-NAME>CanTTController</SHORT-NAME>
                                       <DESC>
                                          <L-2 L="EN">CanTTController is specified in the SWS TTCAN and contains the configuration parameters of the TTCAN controller(s) (which are needed in addition to the configuration parameters of the CAN controller(s)).</L-2>
                                       </DESC>
                                       <INTRODUCTION>
                                          <P>
                                             <L-1 L="EN">This container is only included and valid if TTCAN is supported by the controller, enabled (see CanSupportTTCANRef, ECUC_Can_00430), and used.</L-1>
                                          </P>
                                       </INTRODUCTION>
                                       <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_Can_00001</RELATED-TRACE-ITEM-REF>
                                       <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                       <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                       <PARAMETERS>
                                          <!-- PARAMETER DEFINITION: CanTTControllerApplWatchdogLimit -->
                                          <ECUC-INTEGER-PARAM-DEF UUID="ECUC:58bdc478-e74c-42df-8d3d-0ba19ae24008">
                                             <SHORT-NAME>CanTTControllerApplWatchdogLimit</SHORT-NAME>
                                             <DESC>
                                                <L-2 L="EN">Defines the maximum time period (unit is 256 times NTU) after which the application has to serve the watchdog.</L-2>
                                             </DESC>
                                             <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_Can_00139</RELATED-TRACE-ITEM-REF>
                                             <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                             <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                             <SCOPE>ECU</SCOPE>
                                             <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                             <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                                             <VALUE-CONFIG-CLASSES>
                                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                             </VALUE-CONFIG-CLASSES>
                                             <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                             <MAX>255</MAX>
                                             <MIN>0</MIN>
                                          </ECUC-INTEGER-PARAM-DEF>
                                          <!-- PARAMETER DEFINITION: CanTTControllerCycleCountMax -->
                                          <ECUC-INTEGER-PARAM-DEF UUID="ECUC:fafa672b-b0c5-4c09-9035-06e2461576cf">
                                             <SHORT-NAME>CanTTControllerCycleCountMax</SHORT-NAME>
                                             <DESC>
                                                <L-2 L="EN">Defines the value for cycle_count_max.</L-2>
                                             </DESC>
                                             <INTRODUCTION>
                                                <P>
                                                   <L-1 L="EN">Allowed values:
                                                        0x00: 1 basic cycle
                                                        0x01: 2 basic cycles
                                                        0x03: 4 basic cycles
                                                        0x07: 8 basic cycles
                                                        0x0F: 16 basic cycles
                                                        0x1F: 32 basic cycles
                                                        0x3F: 64 basic cycles</L-1>
                                                </P>
                                             </INTRODUCTION>
                                             <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_Can_00138</RELATED-TRACE-ITEM-REF>
                                             <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                             <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                             <SCOPE>ECU</SCOPE>
                                             <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                             <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                                             <VALUE-CONFIG-CLASSES>
                                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                             </VALUE-CONFIG-CLASSES>
                                             <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                             <MAX>63</MAX>
                                             <MIN>0</MIN>
                                          </ECUC-INTEGER-PARAM-DEF>
                                          <!-- PARAMETER DEFINITION: CanTTControllerExpectedTxTrigger -->
                                          <ECUC-INTEGER-PARAM-DEF UUID="ECUC:91b067db-e57d-432f-9093-262d567242ec">
                                             <SHORT-NAME>CanTTControllerExpectedTxTrigger</SHORT-NAME>
                                             <DESC>
                                                <L-2 L="EN">Number of expected_tx_trigger.</L-2>
                                             </DESC>
                                             <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_Can_00136</RELATED-TRACE-ITEM-REF>
                                             <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                             <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                             <SCOPE>LOCAL</SCOPE>
                                             <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                             <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                                             <VALUE-CONFIG-CLASSES>
                                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                             </VALUE-CONFIG-CLASSES>
                                             <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                             <MAX>255</MAX>
                                             <MIN>0</MIN>
                                          </ECUC-INTEGER-PARAM-DEF>
                                          <!-- PARAMETER DEFINITION: CanTTControllerExternalClockSynchronisation -->
                                          <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:1f319887-2617-4190-b5d6-95b9e555b180">
                                             <SHORT-NAME>CanTTControllerExternalClockSynchronisation</SHORT-NAME>
                                             <DESC>
                                                <L-2 L="EN">Enables/disables the external clock synchronization.</L-2>
                                             </DESC>
                                             <INTRODUCTION>
                                                <P>
                                                   <L-1 L="EN">TRUE:
                                                        External clock synchronization enabled.
                                                        FALSE:
                                                        External clock synchronization disabled.

                                                        This parameter shall only be configurable if parameter CanTTControllerLevel2 equals TRUE.</L-1>
                                                </P>
                                             </INTRODUCTION>
                                             <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_Can_00135</RELATED-TRACE-ITEM-REF>
                                             <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                             <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                             <SCOPE>ECU</SCOPE>
                                             <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                             <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                                             <VALUE-CONFIG-CLASSES>
                                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                             </VALUE-CONFIG-CLASSES>
                                             <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                          </ECUC-BOOLEAN-PARAM-DEF>
                                          <!-- PARAMETER DEFINITION: CanTTControllerGlobalTimeFiltering -->
                                          <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:ced20e88-c426-42a9-bce0-ed1a2a5f3797">
                                             <SHORT-NAME>CanTTControllerGlobalTimeFiltering</SHORT-NAME>
                                             <DESC>
                                                <L-2 L="EN">Enables/disables the global time filtering.</L-2>
                                             </DESC>
                                             <INTRODUCTION>
                                                <P>
                                                   <L-1 L="EN">TRUE:
                                                        Global time filtering enabled.
                                                        FALSE:
                                                        Global time filtering disabled.

                                                        This parameter shall only be configurable if parameter CanTTControllerLevel2 equals TRUE.</L-1>
                                                </P>
                                             </INTRODUCTION>
                                             <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_Can_00134</RELATED-TRACE-ITEM-REF>
                                             <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                             <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                             <SCOPE>LOCAL</SCOPE>
                                             <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                             <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                                             <VALUE-CONFIG-CLASSES>
                                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                             </VALUE-CONFIG-CLASSES>
                                             <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                          </ECUC-BOOLEAN-PARAM-DEF>
                                          <!-- PARAMETER DEFINITION: CanTTControllerInitialRefOffset -->
                                          <ECUC-INTEGER-PARAM-DEF UUID="ECUC:25750102-31df-4bed-91cf-01253dc78faf">
                                             <SHORT-NAME>CanTTControllerInitialRefOffset</SHORT-NAME>
                                             <DESC>
                                                <L-2 L="EN">Defines the initial value for ref trigger offset.</L-2>
                                             </DESC>
                                             <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_Can_00128</RELATED-TRACE-ITEM-REF>
                                             <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                             <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                             <SCOPE>ECU</SCOPE>
                                             <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                             <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                                             <VALUE-CONFIG-CLASSES>
                                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                             </VALUE-CONFIG-CLASSES>
                                             <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                             <MAX>127</MAX>
                                             <MIN>0</MIN>
                                          </ECUC-INTEGER-PARAM-DEF>
                                          <!-- PARAMETER DEFINITION: CanTTControllerInterruptEnable -->
                                          <ECUC-INTEGER-PARAM-DEF UUID="ECUC:6d752b5f-31aa-4e11-915c-cbe1e1a0f01a">
                                             <SHORT-NAME>CanTTControllerInterruptEnable</SHORT-NAME>
                                             <DESC>
                                                <L-2 L="EN">Enables/disables the respective interrupts.</L-2>
                                             </DESC>
                                             <INTRODUCTION>
                                                <P>
                                                   <L-1 L="EN">Bit Position set to 1: Enable respective interrupt.
                                                        Bit Position set to 0: Disable respective interrupt.

                                                        Bit Position / Interrupt Source: 
                                                        10: Application Watchdog. 
                                                        9: Watch Trigger reached. 
                                                        8: Initialization Watch Trigger reached. 
                                                        7: Change of Error Level. 
                                                        6: Tx Overflow. 
                                                        5: Tx Underflow. 
                                                        4: Global Time Error. 
                                                        3: Gap. 
                                                        2: Start of Cycle. 
                                                        1: Time Discontinuity. 
                                                        0: Master State Change. 

                                                        Bit position "1: Time Discontinuity" and "4: Global Time Error" shall only be configurable if parameter CanTTControllerLevel2 equals TRUE.</L-1>
                                                </P>
                                             </INTRODUCTION>
                                             <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_Can_00140</RELATED-TRACE-ITEM-REF>
                                             <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                             <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                             <SCOPE>LOCAL</SCOPE>
                                             <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                             <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                                             <VALUE-CONFIG-CLASSES>
                                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                             </VALUE-CONFIG-CLASSES>
                                             <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                             <MAX>1023</MAX>
                                             <MIN>0</MIN>
                                          </ECUC-INTEGER-PARAM-DEF>
                                          <!-- PARAMETER DEFINITION: CanTTControllerLevel2 -->
                                          <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:91462836-5301-42da-8b89-dad7c7ddeb2c">
                                             <SHORT-NAME>CanTTControllerLevel2</SHORT-NAME>
                                             <DESC>
                                                <L-2 L="EN">Defines whether Level 2 or Level 1 is used.</L-2>
                                             </DESC>
                                             <INTRODUCTION>
                                                <P>
                                                   <L-1 L="EN">TRUE: Level 2.
                                                        FALSE: Level 1.

                                                        If this parameter is set to FALSE then all parameters with dependency to CanTTControllerLevel2 need not be configured.</L-1>
                                                </P>
                                             </INTRODUCTION>
                                             <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_Can_00131</RELATED-TRACE-ITEM-REF>
                                             <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                             <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                             <SCOPE>LOCAL</SCOPE>
                                             <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                             <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                                             <VALUE-CONFIG-CLASSES>
                                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                             </VALUE-CONFIG-CLASSES>
                                             <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                          </ECUC-BOOLEAN-PARAM-DEF>
                                          <!-- PARAMETER DEFINITION: CanTTControllerNTUConfig -->
                                          <ECUC-FLOAT-PARAM-DEF UUID="ECUC:fc8b7d0e-677b-4c04-b547-ef6602271c33">
                                             <SHORT-NAME>CanTTControllerNTUConfig</SHORT-NAME>
                                             <DESC>
                                                <L-2 L="EN">Defines the config value for NTU (network time unit).</L-2>
                                             </DESC>
                                             <INTRODUCTION>
                                                <P>
                                                   <L-1 L="EN">Value given in microseconds. The value configured shall be greater than 0.
                                                        Together with the local oscillator period, the TUR (time unit ratio) can be derived from the NTU. This parameter shall only be configurable if parameter CanTTControllerLevel2 equals TRUE.</L-1>
                                                </P>
                                             </INTRODUCTION>
                                             <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_Can_00141</RELATED-TRACE-ITEM-REF>
                                             <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                             <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                             <SCOPE>ECU</SCOPE>
                                             <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                             <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                                             <VALUE-CONFIG-CLASSES>
                                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                             </VALUE-CONFIG-CLASSES>
                                             <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                             <MAX>100</MAX>
                                             <MIN>0</MIN>
                                          </ECUC-FLOAT-PARAM-DEF>
                                          <!-- PARAMETER DEFINITION: CanTTControllerOperationMode -->
                                          <ECUC-ENUMERATION-PARAM-DEF UUID="ECUC:fd04f084-a5cc-4c27-9d75-7e1a46e86bfa">
                                             <SHORT-NAME>CanTTControllerOperationMode</SHORT-NAME>
                                             <DESC>
                                                <L-2 L="EN">Defines the operation mode.</L-2>
                                             </DESC>
                                             <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_Can_00127</RELATED-TRACE-ITEM-REF>
                                             <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                             <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                             <SCOPE>ECU</SCOPE>
                                             <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                             <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                                             <VALUE-CONFIG-CLASSES>
                                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                             </VALUE-CONFIG-CLASSES>
                                             <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                             <LITERALS>
                                                <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:3fd64a8a-7d9a-9c65-715c-caf19978e54c">
                                                   <SHORT-NAME>CAN_TT_EVENT_SYNC_TIME_TRIGGERED</SHORT-NAME>
                                                   <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                                </ECUC-ENUMERATION-LITERAL-DEF>
                                                <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:3fef5410-240b-9c34-51d9-eae0a402d47f">
                                                   <SHORT-NAME>CAN_TT_EVENT_TRIGGERED</SHORT-NAME>
                                                   <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                                </ECUC-ENUMERATION-LITERAL-DEF>
                                                <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:2f4bd692-b267-90cd-41cb-11f197c247c6">
                                                   <SHORT-NAME>CAN_TT_TIME_TRIGGERED</SHORT-NAME>
                                                   <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                                </ECUC-ENUMERATION-LITERAL-DEF>
                                             </LITERALS>
                                          </ECUC-ENUMERATION-PARAM-DEF>
                                          <!-- PARAMETER DEFINITION: CanTTControllerSyncDeviation -->
                                          <ECUC-FLOAT-PARAM-DEF UUID="ECUC:26f778c8-15de-4c4a-b05e-fff49e20b233">
                                             <SHORT-NAME>CanTTControllerSyncDeviation</SHORT-NAME>
                                             <DESC>
                                                <L-2 L="EN">Defines the maximum synchronization deviation:</L-2>
                                             </DESC>
                                             <INTRODUCTION>
                                                <P>
                                                   <L-1 L="EN">Given as a percentage value of the NTU (network time unit). The value configured shall be greater than 0.
                                                        This parameter shall only be configurable if parameter CanTTControllerLevel2 equals TRUE.</L-1>
                                                </P>
                                             </INTRODUCTION>
                                             <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_Can_00132</RELATED-TRACE-ITEM-REF>
                                             <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                             <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                             <SCOPE>LOCAL</SCOPE>
                                             <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                             <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                                             <VALUE-CONFIG-CLASSES>
                                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                             </VALUE-CONFIG-CLASSES>
                                             <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                             <MAX>100</MAX>
                                             <MIN>0</MIN>
                                          </ECUC-FLOAT-PARAM-DEF>
                                          <!-- PARAMETER DEFINITION: CanTTControllerTURRestore -->
                                          <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:e5b66746-4e6e-47f5-b62b-ab6452a49082">
                                             <SHORT-NAME>CanTTControllerTURRestore</SHORT-NAME>
                                             <DESC>
                                                <L-2 L="EN">Enables/disables the TUR restore.</L-2>
                                             </DESC>
                                             <INTRODUCTION>
                                                <P>
                                                   <L-1 L="EN">Note that the value configured for TUR can be derived from the value configured for NTU and the local oscillator preriod.
                                                        TRUE:
                                                        TUR restore enabled.  
                                                        FALSE:
                                                        TUR restore disabled. 

                                                        This parameter shall only be configurable if parameter CanTTControllerLevel2 equals TRUE.</L-1>
                                                </P>
                                             </INTRODUCTION>
                                             <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_Can_00133</RELATED-TRACE-ITEM-REF>
                                             <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                             <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                             <SCOPE>LOCAL</SCOPE>
                                             <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                             <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                                             <VALUE-CONFIG-CLASSES>
                                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                             </VALUE-CONFIG-CLASSES>
                                             <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                          </ECUC-BOOLEAN-PARAM-DEF>
                                          <!-- PARAMETER DEFINITION: CanTTControllerTimeMaster -->
                                          <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:68c24e85-bb75-4b38-b9af-05947b2f0f27">
                                             <SHORT-NAME>CanTTControllerTimeMaster</SHORT-NAME>
                                             <DESC>
                                                <L-2 L="EN">Defines whether the controller acts as a potential time master.</L-2>
                                             </DESC>
                                             <INTRODUCTION>
                                                <P>
                                                   <L-1 L="EN">TRUE: Potential time master. 
                                                        FALSE: Time slave.</L-1>
                                                </P>
                                             </INTRODUCTION>
                                             <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_Can_00129</RELATED-TRACE-ITEM-REF>
                                             <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                             <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                             <SCOPE>ECU</SCOPE>
                                             <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                             <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                                             <VALUE-CONFIG-CLASSES>
                                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                             </VALUE-CONFIG-CLASSES>
                                             <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                          </ECUC-BOOLEAN-PARAM-DEF>
                                          <!-- PARAMETER DEFINITION: CanTTControllerTimeMasterPriority -->
                                          <ECUC-INTEGER-PARAM-DEF UUID="ECUC:64837877-30b7-48a4-9f87-a7e4e959010f">
                                             <SHORT-NAME>CanTTControllerTimeMasterPriority</SHORT-NAME>
                                             <DESC>
                                                <L-2 L="EN">Defines the time master priority.</L-2>
                                             </DESC>
                                             <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_Can_00130</RELATED-TRACE-ITEM-REF>
                                             <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                             <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                             <SCOPE>ECU</SCOPE>
                                             <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                             <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                                             <VALUE-CONFIG-CLASSES>
                                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                             </VALUE-CONFIG-CLASSES>
                                             <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                             <MAX>7</MAX>
                                             <MIN>0</MIN>
                                          </ECUC-INTEGER-PARAM-DEF>
                                          <!-- PARAMETER DEFINITION: CanTTControllerTxEnableWindowLength -->
                                          <ECUC-INTEGER-PARAM-DEF UUID="ECUC:432b3c85-542c-48e3-ab51-3944e1d6e421">
                                             <SHORT-NAME>CanTTControllerTxEnableWindowLength</SHORT-NAME>
                                             <DESC>
                                                <L-2 L="EN">Length of the tx enable window given in CAN bit times.</L-2>
                                             </DESC>
                                             <INTRODUCTION>
                                                <P>
                                                   <L-1 L="EN">Definition parameter "CanTTControllerTxEnableWindowlength" is used such that:
                                                        Length of enable window = CanTTControllerTxEnableWindowLength + 1</L-1>
                                                </P>
                                             </INTRODUCTION>
                                             <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_Can_00137</RELATED-TRACE-ITEM-REF>
                                             <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                             <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                             <SCOPE>ECU</SCOPE>
                                             <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                             <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                                             <VALUE-CONFIG-CLASSES>
                                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                             </VALUE-CONFIG-CLASSES>
                                             <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                             <MAX>16</MAX>
                                             <MIN>1</MIN>
                                          </ECUC-INTEGER-PARAM-DEF>
                                          <!-- PARAMETER DEFINITION: CanTTControllerWatchTriggerGapTimeMark -->
                                          <ECUC-INTEGER-PARAM-DEF UUID="ECUC:a880dad8-6591-4dbc-a3d4-8057ff9b6931">
                                             <SHORT-NAME>CanTTControllerWatchTriggerGapTimeMark</SHORT-NAME>
                                             <DESC>
                                                <L-2 L="EN">watch trigger time mark after a gap</L-2>
                                             </DESC>
                                             <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_Can_00158</RELATED-TRACE-ITEM-REF>
                                             <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                             <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                             <SCOPE>LOCAL</SCOPE>
                                             <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                             <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                                             <VALUE-CONFIG-CLASSES>
                                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                             </VALUE-CONFIG-CLASSES>
                                             <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                             <MAX>65535</MAX>
                                             <MIN>0</MIN>
                                          </ECUC-INTEGER-PARAM-DEF>
                                          <!-- PARAMETER DEFINITION: CanTTControllerWatchTriggerTimeMark -->
                                          <ECUC-INTEGER-PARAM-DEF UUID="ECUC:496f1799-9365-4e5b-878a-dd8cab58f338">
                                             <SHORT-NAME>CanTTControllerWatchTriggerTimeMark</SHORT-NAME>
                                             <DESC>
                                                <L-2 L="EN">watch trigger time mark</L-2>
                                             </DESC>
                                             <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_Can_00157</RELATED-TRACE-ITEM-REF>
                                             <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                             <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                             <SCOPE>LOCAL</SCOPE>
                                             <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                             <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                                             <VALUE-CONFIG-CLASSES>
                                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                             </VALUE-CONFIG-CLASSES>
                                             <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                             <MAX>65535</MAX>
                                             <MIN>0</MIN>
                                          </ECUC-INTEGER-PARAM-DEF>
                                          <!-- PARAMETER DEFINITION: CanTTIRQProcessing -->
                                          <ECUC-ENUMERATION-PARAM-DEF UUID="ECUC:089059db-bfe6-43a7-9fa7-99b4b583a2bf">
                                             <SHORT-NAME>CanTTIRQProcessing</SHORT-NAME>
                                             <DESC>
                                                <L-2 L="EN">Enables / disables API Can_MainFunction_BusOff() for handling busoff events in polling mode.</L-2>
                                             </DESC>
                                             <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_Can_00142</RELATED-TRACE-ITEM-REF>
                                             <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                             <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                             <SCOPE>ECU</SCOPE>
                                             <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                             <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                                             <VALUE-CONFIG-CLASSES>
                                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                             </VALUE-CONFIG-CLASSES>
                                             <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                             <LITERALS>
                                                <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:7bc27e44-c968-9123-5842-4a8300d5dc4a">
                                                   <SHORT-NAME>INTERRUPT</SHORT-NAME>
                                                   <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                                </ECUC-ENUMERATION-LITERAL-DEF>
                                                <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:c242e16b-c373-998e-333f-0e295c508c28">
                                                   <SHORT-NAME>POLLING</SHORT-NAME>
                                                   <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                                </ECUC-ENUMERATION-LITERAL-DEF>
                                             </LITERALS>
                                          </ECUC-ENUMERATION-PARAM-DEF>
                                       </PARAMETERS>
                                    </ECUC-PARAM-CONF-CONTAINER-DEF>
                                 </SUB-CONTAINERS>
                              </ECUC-PARAM-CONF-CONTAINER-DEF>
                              <!-- Container Definition: CanHardwareObject -->
                              <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:ee3d6577-0017-42fc-b4d6-8d27c2e66563">
                                 <SHORT-NAME>CanHardwareObject</SHORT-NAME>
                                 <DESC>
                                    <L-2 L="EN">This container contains the configuration (parameters) of CAN Hardware Objects.</L-2>
                                 </DESC>
                                 <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_Can_00324</RELATED-TRACE-ITEM-REF>
                                 <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                 <UPPER-MULTIPLICITY-INFINITE>true</UPPER-MULTIPLICITY-INFINITE>
                                 <PARAMETERS>
                                    <!-- PARAMETER DEFINITION: CanFdPaddingValue -->
                                    <ECUC-INTEGER-PARAM-DEF UUID="ECUC:14711138-dbc9-4e86-8f92-4fcb2a077481">
                                       <SHORT-NAME>CanFdPaddingValue</SHORT-NAME>
                                       <DESC>
                                          <L-2 L="EN">Specifies the value which is used to pad unspecified data in CAN FD frames &gt; 8 bytes for transmission. This is necessary due to the discrete possible values of the DLC if &gt; 8 bytes.</L-2>
                                       </DESC>
                                       <INTRODUCTION>
                                          <P>
                                             <L-1 L="EN">If the length of a PDU which was requested to be sent does not match the allowed DLC values, the remaining bytes up to the next possible value shall be padded with this value.</L-1>
                                          </P>
                                       </INTRODUCTION>
                                       <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_Can_00485</RELATED-TRACE-ITEM-REF>
                                       <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                       <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                       <SCOPE>ECU</SCOPE>
                                       <MULTIPLICITY-CONFIG-CLASSES>
                                          <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                             <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                             <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                          </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                          <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                             <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                             <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                          </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                       </MULTIPLICITY-CONFIG-CLASSES>
                                       <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                       <POST-BUILD-VARIANT-MULTIPLICITY>true</POST-BUILD-VARIANT-MULTIPLICITY>
                                       <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                                       <VALUE-CONFIG-CLASSES>
                                          <ECUC-VALUE-CONFIGURATION-CLASS>
                                             <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                             <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                          </ECUC-VALUE-CONFIGURATION-CLASS>
                                          <ECUC-VALUE-CONFIGURATION-CLASS>
                                             <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                             <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                          </ECUC-VALUE-CONFIGURATION-CLASS>
                                       </VALUE-CONFIG-CLASSES>
                                       <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                       <DEFAULT-VALUE>0</DEFAULT-VALUE>
                                       <MAX>255</MAX>
                                       <MIN>0</MIN>
                                    </ECUC-INTEGER-PARAM-DEF>
                                    <!-- PARAMETER DEFINITION: CanHandleType -->
                                    <ECUC-ENUMERATION-PARAM-DEF UUID="ECUC:6c58c09a-9aa2-4e4d-8ae3-8eba40a77aaf">
                                       <SHORT-NAME>CanHandleType</SHORT-NAME>
                                       <DESC>
                                          <L-2 L="EN">Specifies the type (Full-CAN or Basic-CAN) of a hardware object.</L-2>
                                       </DESC>
                                       <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_Can_00323</RELATED-TRACE-ITEM-REF>
                                       <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                       <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                       <SCOPE>ECU</SCOPE>
                                       <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                       <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                                       <VALUE-CONFIG-CLASSES>
                                          <ECUC-VALUE-CONFIGURATION-CLASS>
                                             <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                             <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                          </ECUC-VALUE-CONFIGURATION-CLASS>
                                          <ECUC-VALUE-CONFIGURATION-CLASS>
                                             <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                             <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                          </ECUC-VALUE-CONFIGURATION-CLASS>
                                       </VALUE-CONFIG-CLASSES>
                                       <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                       <LITERALS>
                                          <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:50af5435-1308-8ebd-3bcc-ba3b63b3ca28">
                                             <SHORT-NAME>BASIC</SHORT-NAME>
                                             <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                          </ECUC-ENUMERATION-LITERAL-DEF>
                                          <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:307cbc95-796f-8689-5e97-22a1120b1381">
                                             <SHORT-NAME>FULL</SHORT-NAME>
                                             <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                          </ECUC-ENUMERATION-LITERAL-DEF>
                                       </LITERALS>
                                    </ECUC-ENUMERATION-PARAM-DEF>
                                    <!-- PARAMETER DEFINITION: CanHwObjectCount -->
                                    <ECUC-INTEGER-PARAM-DEF UUID="ECUC:6d1e7a5e-a3fa-40fe-a488-04313db384f5">
                                       <SHORT-NAME>CanHwObjectCount</SHORT-NAME>
                                       <DESC>
                                          <L-2 L="EN">Number of hardware objects used to implement one HOH. In case of a HRH this parameter defines the number of elements in the hardware FIFO or the number of shadow buffers, in case of a HTH it defines the number of hardware objects used for multiplexed transmission or for a hardware FIFO used by a FullCAN HTH.</L-2>
                                       </DESC>
                                       <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_Can_00467</RELATED-TRACE-ITEM-REF>
                                       <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                       <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                       <SCOPE>ECU</SCOPE>
                                       <MULTIPLICITY-CONFIG-CLASSES>
                                          <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                             <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                             <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                          </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                          <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                             <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                             <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                          </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                       </MULTIPLICITY-CONFIG-CLASSES>
                                       <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                       <POST-BUILD-VARIANT-MULTIPLICITY>true</POST-BUILD-VARIANT-MULTIPLICITY>
                                       <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                                       <VALUE-CONFIG-CLASSES>
                                          <ECUC-VALUE-CONFIGURATION-CLASS>
                                             <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                             <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                          </ECUC-VALUE-CONFIGURATION-CLASS>
                                          <ECUC-VALUE-CONFIGURATION-CLASS>
                                             <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                             <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                          </ECUC-VALUE-CONFIGURATION-CLASS>
                                       </VALUE-CONFIG-CLASSES>
                                       <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                       <DEFAULT-VALUE>1</DEFAULT-VALUE>
                                       <MAX>65535</MAX>
                                       <MIN>1</MIN>
                                    </ECUC-INTEGER-PARAM-DEF>
                                    <!-- PARAMETER DEFINITION: CanIdType -->
                                    <ECUC-ENUMERATION-PARAM-DEF UUID="ECUC:f8442a9b-7752-416c-ac68-8cd3080589c0">
                                       <SHORT-NAME>CanIdType</SHORT-NAME>
                                       <DESC>
                                          <L-2 L="EN">Specifies whether the IdValue is of type</L-2>
                                       </DESC>
                                       <INTRODUCTION>
                                          <P>
                                             <L-1 L="EN">- standard identifier
                                                  - extended identifier
                                                  - mixed mode

                                                ImplementationType: Can_IdType</L-1>
                                          </P>
                                       </INTRODUCTION>
                                       <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_Can_00065</RELATED-TRACE-ITEM-REF>
                                       <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                       <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                       <SCOPE>ECU</SCOPE>
                                       <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                       <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                                       <VALUE-CONFIG-CLASSES>
                                          <ECUC-VALUE-CONFIGURATION-CLASS>
                                             <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                             <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                          </ECUC-VALUE-CONFIGURATION-CLASS>
                                          <ECUC-VALUE-CONFIGURATION-CLASS>
                                             <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                             <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                          </ECUC-VALUE-CONFIGURATION-CLASS>
                                       </VALUE-CONFIG-CLASSES>
                                       <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                       <LITERALS>
                                          <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:b0d87c30-8808-863d-7394-ca932296bf20">
                                             <SHORT-NAME>EXTENDED</SHORT-NAME>
                                             <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                          </ECUC-ENUMERATION-LITERAL-DEF>
                                          <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:78dcd470-c4dc-8a3d-5a2d-3c4c9d1b6b41">
                                             <SHORT-NAME>MIXED</SHORT-NAME>
                                             <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                          </ECUC-ENUMERATION-LITERAL-DEF>
                                          <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:8c7ad8bb-450e-8b44-4a05-57c77c6eafd5">
                                             <SHORT-NAME>STANDARD</SHORT-NAME>
                                             <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                          </ECUC-ENUMERATION-LITERAL-DEF>
                                       </LITERALS>
                                    </ECUC-ENUMERATION-PARAM-DEF>
                                    <!-- PARAMETER DEFINITION: CanObjectId -->
                                    <ECUC-INTEGER-PARAM-DEF UUID="ECUC:5049e195-870c-490c-ac6d-745aae833d04">
                                       <SHORT-NAME>CanObjectId</SHORT-NAME>
                                       <DESC>
                                          <L-2 L="EN">Holds the handle ID of HRH or HTH. The value of this parameter is unique in a given CAN Driver, and it should start with 0 and continue without any gaps.</L-2>
                                       </DESC>
                                       <INTRODUCTION>
                                          <P>
                                             <L-1 L="EN">The HRH and HTH Ids share a common ID range.

                                                Example: HRH0-0, HRH1-1, HTH0-2, HTH1-3</L-1>
                                          </P>
                                       </INTRODUCTION>
                                       <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_Can_00326</RELATED-TRACE-ITEM-REF>
                                       <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                       <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                       <SCOPE>ECU</SCOPE>
                                       <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                       <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                       <VALUE-CONFIG-CLASSES>
                                          <ECUC-VALUE-CONFIGURATION-CLASS>
                                             <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                             <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                          </ECUC-VALUE-CONFIGURATION-CLASS>
                                          <ECUC-VALUE-CONFIGURATION-CLASS>
                                             <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                             <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                          </ECUC-VALUE-CONFIGURATION-CLASS>
                                       </VALUE-CONFIG-CLASSES>
                                       <SYMBOLIC-NAME-VALUE>true</SYMBOLIC-NAME-VALUE>
                                       <MAX>65535</MAX>
                                       <MIN>0</MIN>
                                    </ECUC-INTEGER-PARAM-DEF>
                                    <!-- PARAMETER DEFINITION: CanObjectType -->
                                    <ECUC-ENUMERATION-PARAM-DEF UUID="ECUC:b8abf5c9-4e6a-46bf-a1ae-63b191e72d04">
                                       <SHORT-NAME>CanObjectType</SHORT-NAME>
                                       <DESC>
                                          <L-2 L="EN">Specifies if the HardwareObject is used as Transmit or as Receive object</L-2>
                                       </DESC>
                                       <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_Can_00327</RELATED-TRACE-ITEM-REF>
                                       <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                       <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                       <SCOPE>ECU</SCOPE>
                                       <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                       <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                                       <VALUE-CONFIG-CLASSES>
                                          <ECUC-VALUE-CONFIGURATION-CLASS>
                                             <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                             <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                          </ECUC-VALUE-CONFIGURATION-CLASS>
                                          <ECUC-VALUE-CONFIGURATION-CLASS>
                                             <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                             <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                          </ECUC-VALUE-CONFIGURATION-CLASS>
                                       </VALUE-CONFIG-CLASSES>
                                       <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                       <LITERALS>
                                          <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:df6672f4-9134-8644-5516-95c9fec6b750">
                                             <SHORT-NAME>RECEIVE</SHORT-NAME>
                                             <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                          </ECUC-ENUMERATION-LITERAL-DEF>
                                          <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:693a8ec4-7de5-85d1-4188-999f27e876cc">
                                             <SHORT-NAME>TRANSMIT</SHORT-NAME>
                                             <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                          </ECUC-ENUMERATION-LITERAL-DEF>
                                       </LITERALS>
                                    </ECUC-ENUMERATION-PARAM-DEF>
                                    <!-- PARAMETER DEFINITION: CanTriggerTransmitEnable -->
                                    <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:22b0af01-6ae7-4b23-8b55-c90fa107d1f5">
                                       <SHORT-NAME>CanTriggerTransmitEnable</SHORT-NAME>
                                       <DESC>
                                          <L-2 L="EN">This parameter defines if or if not Can supports the trigger-transmit API for this handle.</L-2>
                                       </DESC>
                                       <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_Can_00486</RELATED-TRACE-ITEM-REF>
                                       <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                       <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                       <SCOPE>ECU</SCOPE>
                                       <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                       <VALUE-CONFIG-CLASSES>
                                          <ECUC-VALUE-CONFIGURATION-CLASS>
                                             <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                             <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                          </ECUC-VALUE-CONFIGURATION-CLASS>
                                          <ECUC-VALUE-CONFIGURATION-CLASS>
                                             <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                             <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                          </ECUC-VALUE-CONFIGURATION-CLASS>
                                       </VALUE-CONFIG-CLASSES>
                                       <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                       <DEFAULT-VALUE>false</DEFAULT-VALUE>
                                    </ECUC-BOOLEAN-PARAM-DEF>
                                 </PARAMETERS>
                                 <REFERENCES>
                                    <!-- Reference Definition: CanControllerRef -->
                                    <ECUC-REFERENCE-DEF UUID="ECUC:e2b98fcd-3e29-4041-a480-aed31e706d97">
                                       <SHORT-NAME>CanControllerRef</SHORT-NAME>
                                       <DESC>
                                          <L-2 L="EN">Reference to CAN Controller to which the HOH is associated to.</L-2>
                                       </DESC>
                                       <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_Can_00322</RELATED-TRACE-ITEM-REF>
                                       <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                       <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                       <SCOPE>LOCAL</SCOPE>
                                       <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                       <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                                       <VALUE-CONFIG-CLASSES>
                                          <ECUC-VALUE-CONFIGURATION-CLASS>
                                             <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                             <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                          </ECUC-VALUE-CONFIGURATION-CLASS>
                                          <ECUC-VALUE-CONFIGURATION-CLASS>
                                             <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                             <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                          </ECUC-VALUE-CONFIGURATION-CLASS>
                                       </VALUE-CONFIG-CLASSES>
                                       <DESTINATION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/AUTOSAR/EcucDefs/Can/CanConfigSet/CanController</DESTINATION-REF>
                                    </ECUC-REFERENCE-DEF>
                                    <!-- Reference Definition: CanMainFunctionRWPeriodRef -->
                                    <ECUC-REFERENCE-DEF UUID="ECUC:185477b7-2192-42b1-9dad-c72942a94b7c">
                                       <SHORT-NAME>CanMainFunctionRWPeriodRef</SHORT-NAME>
                                       <DESC>
                                          <L-2 L="EN">Reference to CanMainFunctionPeriod</L-2>
                                       </DESC>
                                       <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_Can_00438</RELATED-TRACE-ITEM-REF>
                                       <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                       <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                       <SCOPE>LOCAL</SCOPE>
                                       <MULTIPLICITY-CONFIG-CLASSES>
                                          <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                             <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                             <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                          </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                          <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                             <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                             <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                          </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                       </MULTIPLICITY-CONFIG-CLASSES>
                                       <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                       <POST-BUILD-VARIANT-MULTIPLICITY>true</POST-BUILD-VARIANT-MULTIPLICITY>
                                       <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                                       <VALUE-CONFIG-CLASSES>
                                          <ECUC-VALUE-CONFIGURATION-CLASS>
                                             <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                             <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                          </ECUC-VALUE-CONFIGURATION-CLASS>
                                          <ECUC-VALUE-CONFIGURATION-CLASS>
                                             <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                             <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                          </ECUC-VALUE-CONFIGURATION-CLASS>
                                       </VALUE-CONFIG-CLASSES>
                                       <DESTINATION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/AUTOSAR/EcucDefs/Can/CanGeneral/CanMainFunctionRWPeriods</DESTINATION-REF>
                                    </ECUC-REFERENCE-DEF>
                                 </REFERENCES>
                                 <SUB-CONTAINERS>
                                    <!-- Container Definition: CanHwFilter -->
                                    <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:c935096b-0081-4569-8b32-31f4b4a18a22">
                                       <SHORT-NAME>CanHwFilter</SHORT-NAME>
                                       <DESC>
                                          <L-2 L="EN">This container is only valid for HRHs and contains the configuration (parameters) of one hardware filter.</L-2>
                                       </DESC>
                                       <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_Can_00468</RELATED-TRACE-ITEM-REF>
                                       <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                       <UPPER-MULTIPLICITY-INFINITE>true</UPPER-MULTIPLICITY-INFINITE>
                                       <PARAMETERS>
                                          <!-- PARAMETER DEFINITION: CanHwFilterCode -->
                                          <ECUC-INTEGER-PARAM-DEF UUID="ECUC:c12386a9-c7ef-4bac-a5ab-ebff3f0e7d2e">
                                             <SHORT-NAME>CanHwFilterCode</SHORT-NAME>
                                             <DESC>
                                                <L-2 L="EN">Specifies (together with the filter mask) the identifiers range that passes the hardware filter.</L-2>
                                             </DESC>
                                             <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_Can_00469</RELATED-TRACE-ITEM-REF>
                                             <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                             <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                             <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                             <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                                             <VALUE-CONFIG-CLASSES>
                                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                             </VALUE-CONFIG-CLASSES>
                                             <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                             <MAX>4294967295</MAX>
                                             <MIN>0</MIN>
                                          </ECUC-INTEGER-PARAM-DEF>
                                          <!-- PARAMETER DEFINITION: CanHwFilterMask -->
                                          <ECUC-INTEGER-PARAM-DEF UUID="ECUC:539be437-f97a-46a0-bd96-8b23c395a500">
                                             <SHORT-NAME>CanHwFilterMask</SHORT-NAME>
                                             <DESC>
                                                <L-2 L="EN">Describes a mask for hardware-based filtering of CAN identifiers. The CAN identifiers of incoming messages are masked with the appropriate CanFilterMaskValue. Bits holding a 0 mean don't care, i.e. do not compare the message's identifier in the respective bit position.</L-2>
                                             </DESC>
                                             <INTRODUCTION>
                                                <P>
                                                   <L-1 L="EN">The mask shall be build by filling with leading 0. In case of CanIdType 
                                                        EXTENDED or MIXED a 29 bit mask shall be build. In case of CanIdType 
                                                        STANDARD a 11 bit mask shall be build</L-1>
                                                </P>
                                             </INTRODUCTION>
                                             <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_Can_00470</RELATED-TRACE-ITEM-REF>
                                             <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                             <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                             <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                             <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                                             <VALUE-CONFIG-CLASSES>
                                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                             </VALUE-CONFIG-CLASSES>
                                             <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                             <MAX>4294967295</MAX>
                                             <MIN>0</MIN>
                                          </ECUC-INTEGER-PARAM-DEF>
                                       </PARAMETERS>
                                    </ECUC-PARAM-CONF-CONTAINER-DEF>
                                    <!-- Container Definition: CanTTHardwareObjectTrigger -->
                                    <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:5c10353d-3ba8-4140-adf6-b5c02d28c9f0">
                                       <SHORT-NAME>CanTTHardwareObjectTrigger</SHORT-NAME>
                                       <DESC>
                                          <L-2 L="EN">CanTTHardwareObjectTrigger is specified in the SWS TTCAN and contains the configuration (parameters) of TTCAN triggers for Hardware Objects, which are additional to the configuration (parameters) of CAN Hardware Objects.</L-2>
                                       </DESC>
                                       <INTRODUCTION>
                                          <P>
                                             <L-1 L="EN">This container is only included and valid if TTCAN is supported by the controller and, enabled (see CanSupportTTCANRef, ECUC_Can_00430), and used.</L-1>
                                          </P>
                                       </INTRODUCTION>
                                       <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_Can_00002</RELATED-TRACE-ITEM-REF>
                                       <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                       <UPPER-MULTIPLICITY-INFINITE>true</UPPER-MULTIPLICITY-INFINITE>
                                       <PARAMETERS>
                                          <!-- PARAMETER DEFINITION: CanTTHardwareObjectBaseCycle -->
                                          <ECUC-INTEGER-PARAM-DEF UUID="ECUC:bbb7fda0-3f86-4144-b471-33793652290e">
                                             <SHORT-NAME>CanTTHardwareObjectBaseCycle</SHORT-NAME>
                                             <DESC>
                                                <L-2 L="EN">Defines the cycle_offset.</L-2>
                                             </DESC>
                                             <INTRODUCTION>
                                                <P>
                                                   <L-1 L="EN">CanTTHardwareObjectBaseCycle must be not greater than cycle_count_max.</L-1>
                                                </P>
                                             </INTRODUCTION>
                                             <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_Can_00147</RELATED-TRACE-ITEM-REF>
                                             <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                             <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                             <SCOPE>ECU</SCOPE>
                                             <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                             <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                                             <VALUE-CONFIG-CLASSES>
                                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                             </VALUE-CONFIG-CLASSES>
                                             <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                             <MAX>63</MAX>
                                             <MIN>0</MIN>
                                          </ECUC-INTEGER-PARAM-DEF>
                                          <!-- PARAMETER DEFINITION: CanTTHardwareObjectCycleRepetition -->
                                          <ECUC-INTEGER-PARAM-DEF UUID="ECUC:6f58e444-b305-47d4-899b-38971bc77aa6">
                                             <SHORT-NAME>CanTTHardwareObjectCycleRepetition</SHORT-NAME>
                                             <DESC>
                                                <L-2 L="EN">Defines the repeat_factor.</L-2>
                                             </DESC>
                                             <INTRODUCTION>
                                                <P>
                                                   <L-1 L="EN">CanTTHardwareObjectCycleRepetition shall be a power of two (2), greater than cycle_offset but not greater than cycle_count_max + 1.</L-1>
                                                </P>
                                             </INTRODUCTION>
                                             <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_Can_00148</RELATED-TRACE-ITEM-REF>
                                             <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                             <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                             <SCOPE>ECU</SCOPE>
                                             <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                             <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                                             <VALUE-CONFIG-CLASSES>
                                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                             </VALUE-CONFIG-CLASSES>
                                             <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                             <MAX>64</MAX>
                                             <MIN>1</MIN>
                                          </ECUC-INTEGER-PARAM-DEF>
                                          <!-- PARAMETER DEFINITION: CanTTHardwareObjectTimeMark -->
                                          <ECUC-INTEGER-PARAM-DEF UUID="ECUC:737166e8-39c4-4d60-ac3f-00672a8ebf66">
                                             <SHORT-NAME>CanTTHardwareObjectTimeMark</SHORT-NAME>
                                             <DESC>
                                                <L-2 L="EN">Defines the point in time, when the trigger will be activated.</L-2>
                                             </DESC>
                                             <INTRODUCTION>
                                                <P>
                                                   <L-1 L="EN">Value is given in cycle time.</L-1>
                                                </P>
                                             </INTRODUCTION>
                                             <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_Can_00146</RELATED-TRACE-ITEM-REF>
                                             <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                             <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                             <SCOPE>LOCAL</SCOPE>
                                             <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                             <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                                             <VALUE-CONFIG-CLASSES>
                                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                             </VALUE-CONFIG-CLASSES>
                                             <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                             <MAX>65535</MAX>
                                             <MIN>0</MIN>
                                          </ECUC-INTEGER-PARAM-DEF>
                                          <!-- PARAMETER DEFINITION: CanTTHardwareObjectTriggerId -->
                                          <ECUC-INTEGER-PARAM-DEF UUID="ECUC:0da05573-613f-45fd-94f7-68688e7bcf18">
                                             <SHORT-NAME>CanTTHardwareObjectTriggerId</SHORT-NAME>
                                             <DESC>
                                                <L-2 L="EN">Sequential number which allows separation of different TTCAN triggers configured for one and the same hardware object.</L-2>
                                             </DESC>
                                             <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_Can_00155</RELATED-TRACE-ITEM-REF>
                                             <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                             <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                             <SCOPE>LOCAL</SCOPE>
                                             <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                             <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                             <VALUE-CONFIG-CLASSES>
                                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                             </VALUE-CONFIG-CLASSES>
                                             <SYMBOLIC-NAME-VALUE>true</SYMBOLIC-NAME-VALUE>
                                             <MAX>63</MAX>
                                             <MIN>0</MIN>
                                          </ECUC-INTEGER-PARAM-DEF>
                                          <!-- PARAMETER DEFINITION: CanTTHardwareObjectTriggerType -->
                                          <ECUC-ENUMERATION-PARAM-DEF UUID="ECUC:b15710a4-a4ef-45a8-830a-33d47a8b386c">
                                             <SHORT-NAME>CanTTHardwareObjectTriggerType</SHORT-NAME>
                                             <DESC>
                                                <L-2 L="EN">Defines the type of the trigger associated with the hardware object. This parameter depends on plain CAN parameter CAN_OBJECT_TYPE.</L-2>
                                             </DESC>
                                             <INTRODUCTION>
                                                <P>
                                                   <L-1 L="EN">If CAN_OBJECT_TYPE equals RECEIVE than this parameter is fixed to  CAN_TT_RX_TRIGGER.
                                                        If CAN_OBJECT_TYPE equals TRANSMIT than one of the following literals is configurable:
                                                        CAN_TT_TX_REF_TRIGGER,
                                                        CAN_TT_TX_REF_TRIGGER_GAP,
                                                        CAN_TT_TX_TRIGGER_MERGED,
                                                        CAN_TT_TX_TRIGGER_SINGLE,
                                                        CAN_TT_TX_TRIGGER_EXCLUSIVE.</L-1>
                                                </P>
                                             </INTRODUCTION>
                                             <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_Can_00145</RELATED-TRACE-ITEM-REF>
                                             <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                             <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                             <SCOPE>LOCAL</SCOPE>
                                             <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                             <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                                             <VALUE-CONFIG-CLASSES>
                                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                             </VALUE-CONFIG-CLASSES>
                                             <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                             <LITERALS>
                                                <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:68bf5289-34ee-89d3-5d65-19d42c07e68a">
                                                   <SHORT-NAME>CAN_TT_RX_TRIGGER</SHORT-NAME>
                                                   <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                                </ECUC-ENUMERATION-LITERAL-DEF>
                                                <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:dd5be928-40aa-90b7-51c4-1a505ca77627">
                                                   <SHORT-NAME>CAN_TT_TX_REF_TRIGGER</SHORT-NAME>
                                                   <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                                </ECUC-ENUMERATION-LITERAL-DEF>
                                                <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:653170d7-c6ef-8b76-6b84-e446fec6810a">
                                                   <SHORT-NAME>CAN_TT_TX_REF_TRIGGER_GAP</SHORT-NAME>
                                                   <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                                </ECUC-ENUMERATION-LITERAL-DEF>
                                                <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:67f9446c-4224-8ee6-4d65-4c58f35031eb">
                                                   <SHORT-NAME>CAN_TT_TX_TRIGGER_EXCLUSIVE</SHORT-NAME>
                                                   <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                                </ECUC-ENUMERATION-LITERAL-DEF>
                                                <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:5c22b2be-4eff-8fdc-3546-615ee8b62e5c">
                                                   <SHORT-NAME>CAN_TT_TX_TRIGGER_MERGED</SHORT-NAME>
                                                   <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                                </ECUC-ENUMERATION-LITERAL-DEF>
                                                <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:314b236a-f035-85d0-5aca-52042b178e82">
                                                   <SHORT-NAME>CAN_TT_TX_TRIGGER_SINGLE</SHORT-NAME>
                                                   <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                                </ECUC-ENUMERATION-LITERAL-DEF>
                                             </LITERALS>
                                          </ECUC-ENUMERATION-PARAM-DEF>
                                       </PARAMETERS>
                                    </ECUC-PARAM-CONF-CONTAINER-DEF>
                                 </SUB-CONTAINERS>
                              </ECUC-PARAM-CONF-CONTAINER-DEF>
                              <!-- Container Definition: CanIcom -->
                              <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:a83d5f7e-0055-4b7c-813b-853cfac7718b">
                                 <SHORT-NAME>CanIcom</SHORT-NAME>
                                 <DESC>
                                    <L-2 L="EN">This container contains the parameters for configuring pretended networking</L-2>
                                 </DESC>
                                 <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_Can_00440</RELATED-TRACE-ITEM-REF>
                                 <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                 <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                 <SUB-CONTAINERS>
                                    <!-- Container Definition: CanIcomConfig -->
                                    <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:7f6fc855-d99c-4bd4-b348-b46b56f4b567">
                                       <SHORT-NAME>CanIcomConfig</SHORT-NAME>
                                       <DESC>
                                          <L-2 L="EN">This container contains the configuration parameters of the ICOM Configuration.</L-2>
                                       </DESC>
                                       <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_Can_00459</RELATED-TRACE-ITEM-REF>
                                       <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                       <UPPER-MULTIPLICITY-INFINITE>true</UPPER-MULTIPLICITY-INFINITE>
                                       <PARAMETERS>
                                          <!-- PARAMETER DEFINITION: CanIcomConfigId -->
                                          <ECUC-INTEGER-PARAM-DEF UUID="ECUC:a32174e2-70a5-4609-a303-503941f99ce7">
                                             <SHORT-NAME>CanIcomConfigId</SHORT-NAME>
                                             <DESC>
                                                <L-2 L="EN">This parameter identifies the ID of the ICOM configuration.</L-2>
                                             </DESC>
                                             <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_Can_00441</RELATED-TRACE-ITEM-REF>
                                             <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                             <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                             <SCOPE>ECU</SCOPE>
                                             <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                             <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                             <VALUE-CONFIG-CLASSES>
                                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                             </VALUE-CONFIG-CLASSES>
                                             <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                             <MAX>255</MAX>
                                             <MIN>1</MIN>
                                          </ECUC-INTEGER-PARAM-DEF>
                                          <!-- PARAMETER DEFINITION: CanIcomWakeOnBusOff -->
                                          <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:8e7c0fd0-06f2-49fa-b680-9aa65d0d346d">
                                             <SHORT-NAME>CanIcomWakeOnBusOff</SHORT-NAME>
                                             <DESC>
                                                <L-2 L="EN">This parameter defines that the MCU shall wake if the bus off is detected or not.</L-2>
                                             </DESC>
                                             <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_Can_00442</RELATED-TRACE-ITEM-REF>
                                             <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                             <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                             <SCOPE>ECU</SCOPE>
                                             <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                             <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                             <VALUE-CONFIG-CLASSES>
                                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                             </VALUE-CONFIG-CLASSES>
                                             <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                             <DEFAULT-VALUE>true</DEFAULT-VALUE>
                                          </ECUC-BOOLEAN-PARAM-DEF>
                                       </PARAMETERS>
                                       <SUB-CONTAINERS>
                                          <!-- Container Definition: CanIcomWakeupCauses -->
                                          <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:88f58fe7-2127-4109-bbbb-643488678bc0">
                                             <SHORT-NAME>CanIcomWakeupCauses</SHORT-NAME>
                                             <DESC>
                                                <L-2 L="EN">This container contains the configuration parameters of the wakeup causes to leave the power saving mode.</L-2>
                                             </DESC>
                                             <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_Can_00443</RELATED-TRACE-ITEM-REF>
                                             <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                             <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                             <SUB-CONTAINERS>
                                                <!-- Container Definition: CanIcomRxMessage -->
                                                <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:f9946c36-b957-4334-8cbd-baca9391f183">
                                                   <SHORT-NAME>CanIcomRxMessage</SHORT-NAME>
                                                   <DESC>
                                                      <L-2 L="EN">This container contains the configuration parameters for the wakeup causes for matching received messages. It has to be configured as often as received messages are defined as wakeup cause.</L-2>
                                                   </DESC>
                                                   <INTRODUCTION>
                                                      <P>
                                                         <L-1 L="EN">constraint: For all CanIcomRxMessage instances the Message IDs which are defined in CanIcomMessageId and in CanIcomRxMessageIdMask shall not overlap.</L-1>
                                                      </P>
                                                   </INTRODUCTION>
                                                   <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_Can_00447</RELATED-TRACE-ITEM-REF>
                                                   <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                                   <UPPER-MULTIPLICITY-INFINITE>true</UPPER-MULTIPLICITY-INFINITE>
                                                   <PARAMETERS>
                                                      <!-- PARAMETER DEFINITION: CanIcomCounterValue -->
                                                      <ECUC-INTEGER-PARAM-DEF UUID="ECUC:44c7f7cd-27c9-4d44-9040-f939d5741f3f">
                                                         <SHORT-NAME>CanIcomCounterValue</SHORT-NAME>
                                                         <DESC>
                                                            <L-2 L="EN">This parameter defines that the MCU shall wake if the message with the ID is received n times on the communication channel.</L-2>
                                                         </DESC>
                                                         <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_Can_00448</RELATED-TRACE-ITEM-REF>
                                                         <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                                         <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                                         <SCOPE>ECU</SCOPE>
                                                         <MULTIPLICITY-CONFIG-CLASSES>
                                                            <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                                               <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                               <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                                            </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                                            <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                                               <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                               <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                                            </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                                         </MULTIPLICITY-CONFIG-CLASSES>
                                                         <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                                         <POST-BUILD-VARIANT-MULTIPLICITY>false</POST-BUILD-VARIANT-MULTIPLICITY>
                                                         <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                                         <VALUE-CONFIG-CLASSES>
                                                            <ECUC-VALUE-CONFIGURATION-CLASS>
                                                               <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                               <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                                            </ECUC-VALUE-CONFIGURATION-CLASS>
                                                            <ECUC-VALUE-CONFIGURATION-CLASS>
                                                               <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                               <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                                            </ECUC-VALUE-CONFIGURATION-CLASS>
                                                         </VALUE-CONFIG-CLASSES>
                                                         <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                                         <MAX>65536</MAX>
                                                         <MIN>1</MIN>
                                                      </ECUC-INTEGER-PARAM-DEF>
                                                      <!-- PARAMETER DEFINITION: CanIcomMessageId -->
                                                      <ECUC-INTEGER-PARAM-DEF UUID="ECUC:bc842073-5c72-4379-8417-8d7ec3974135">
                                                         <SHORT-NAME>CanIcomMessageId</SHORT-NAME>
                                                         <DESC>
                                                            <L-2 L="EN">This parameter defines the message ID the wakeup causes of this CanIcomRxMessage are configured for. In addition a mask (CanIcomMessageIdMask) can be defined, in that case it is possible to define a range of rx messages, which can create a wakeup condition.</L-2>
                                                         </DESC>
                                                         <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_Can_00449</RELATED-TRACE-ITEM-REF>
                                                         <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                                         <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                                         <SCOPE>ECU</SCOPE>
                                                         <MULTIPLICITY-CONFIG-CLASSES>
                                                            <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                                               <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                               <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                                            </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                                            <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                                               <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                               <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                                            </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                                         </MULTIPLICITY-CONFIG-CLASSES>
                                                         <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                                         <POST-BUILD-VARIANT-MULTIPLICITY>false</POST-BUILD-VARIANT-MULTIPLICITY>
                                                         <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                                         <VALUE-CONFIG-CLASSES>
                                                            <ECUC-VALUE-CONFIGURATION-CLASS>
                                                               <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                               <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                                            </ECUC-VALUE-CONFIGURATION-CLASS>
                                                            <ECUC-VALUE-CONFIGURATION-CLASS>
                                                               <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                               <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                                            </ECUC-VALUE-CONFIGURATION-CLASS>
                                                         </VALUE-CONFIG-CLASSES>
                                                         <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                                         <MAX>536870912</MAX>
                                                         <MIN>0</MIN>
                                                      </ECUC-INTEGER-PARAM-DEF>
                                                      <!-- PARAMETER DEFINITION: CanIcomMessageIdMask -->
                                                      <ECUC-INTEGER-PARAM-DEF UUID="ECUC:ec84df4c-ff4f-4073-9d4e-f56e05565ede">
                                                         <SHORT-NAME>CanIcomMessageIdMask</SHORT-NAME>
                                                         <DESC>
                                                            <L-2 L="EN">Describes a mask for filtering of CAN identifiers. The CAN identifiers of incoming messages are masked with this CanIcomMessageIdMask. If the masked identifier matches the masked value of CanIcomMessageId, it can create a wakeup condition for this CanIcomRxMessage. Bits holding a 0 mean don't care, i.e. do not compare the message's identifier in the respective bit position. The mask shall be build by filling with leading 0.</L-2>
                                                         </DESC>
                                                         <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_Can_00465</RELATED-TRACE-ITEM-REF>
                                                         <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                                         <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                                         <SCOPE>ECU</SCOPE>
                                                         <MULTIPLICITY-CONFIG-CLASSES>
                                                            <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                                               <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                               <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                                            </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                                            <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                                               <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                               <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                                            </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                                         </MULTIPLICITY-CONFIG-CLASSES>
                                                         <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                                         <POST-BUILD-VARIANT-MULTIPLICITY>false</POST-BUILD-VARIANT-MULTIPLICITY>
                                                         <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                                         <VALUE-CONFIG-CLASSES>
                                                            <ECUC-VALUE-CONFIGURATION-CLASS>
                                                               <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                               <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                                            </ECUC-VALUE-CONFIGURATION-CLASS>
                                                            <ECUC-VALUE-CONFIGURATION-CLASS>
                                                               <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                               <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                                            </ECUC-VALUE-CONFIGURATION-CLASS>
                                                         </VALUE-CONFIG-CLASSES>
                                                         <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                                         <MAX>536870912</MAX>
                                                         <MIN>0</MIN>
                                                      </ECUC-INTEGER-PARAM-DEF>
                                                      <!-- PARAMETER DEFINITION: CanIcomMissingMessageTimerValue -->
                                                      <ECUC-FLOAT-PARAM-DEF UUID="ECUC:123941f0-3f0c-4664-9505-666c96bd7da3">
                                                         <SHORT-NAME>CanIcomMissingMessageTimerValue</SHORT-NAME>
                                                         <DESC>
                                                            <L-2 L="EN">This parameter defines that the MCU shall wake if the message with the ID is not received for a specific time in s on the</L-2>
                                                         </DESC>
                                                         <INTRODUCTION>
                                                            <P>
                                                               <L-1 L="EN">communication channel.</L-1>
                                                            </P>
                                                         </INTRODUCTION>
                                                         <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_Can_00450</RELATED-TRACE-ITEM-REF>
                                                         <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                                         <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                                         <SCOPE>ECU</SCOPE>
                                                         <MULTIPLICITY-CONFIG-CLASSES>
                                                            <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                                               <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                               <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                                            </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                                            <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                                               <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                               <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                                            </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                                         </MULTIPLICITY-CONFIG-CLASSES>
                                                         <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                                         <POST-BUILD-VARIANT-MULTIPLICITY>false</POST-BUILD-VARIANT-MULTIPLICITY>
                                                         <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                                         <VALUE-CONFIG-CLASSES>
                                                            <ECUC-VALUE-CONFIGURATION-CLASS>
                                                               <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                               <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                                            </ECUC-VALUE-CONFIGURATION-CLASS>
                                                            <ECUC-VALUE-CONFIGURATION-CLASS>
                                                               <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                               <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                                            </ECUC-VALUE-CONFIGURATION-CLASS>
                                                         </VALUE-CONFIG-CLASSES>
                                                         <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                                      </ECUC-FLOAT-PARAM-DEF>
                                                      <!-- PARAMETER DEFINITION: CanIcomPayloadLengthError -->
                                                      <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:d4192bb5-3b33-4327-a259-dd0d39ba22a9">
                                                         <SHORT-NAME>CanIcomPayloadLengthError</SHORT-NAME>
                                                         <DESC>
                                                            <L-2 L="EN">This parameter defines that the MCU shall wake if a payload error occurs</L-2>
                                                         </DESC>
                                                         <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_Can_00451</RELATED-TRACE-ITEM-REF>
                                                         <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                                         <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                                         <SCOPE>ECU</SCOPE>
                                                         <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                                         <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                                         <VALUE-CONFIG-CLASSES>
                                                            <ECUC-VALUE-CONFIGURATION-CLASS>
                                                               <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                               <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                                            </ECUC-VALUE-CONFIGURATION-CLASS>
                                                            <ECUC-VALUE-CONFIGURATION-CLASS>
                                                               <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                               <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                                            </ECUC-VALUE-CONFIGURATION-CLASS>
                                                         </VALUE-CONFIG-CLASSES>
                                                         <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                                         <DEFAULT-VALUE>false</DEFAULT-VALUE>
                                                      </ECUC-BOOLEAN-PARAM-DEF>
                                                   </PARAMETERS>
                                                   <SUB-CONTAINERS>
                                                      <!-- Container Definition: CanIcomRxMessageSignalConfig -->
                                                      <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:26beb935-7b78-4e1d-8409-4b3085f26539">
                                                         <SHORT-NAME>CanIcomRxMessageSignalConfig</SHORT-NAME>
                                                         <DESC>
                                                            <L-2 L="EN">This container contains the configuration parameters for the wakeup causes for matching signals.</L-2>
                                                         </DESC>
                                                         <INTRODUCTION>
                                                            <P>
                                                               <L-1 L="EN">It has to be configured as often as a signal is defined as wakeup cause. If at least one Signal conditions defined in a CanIcomRxMessageSignalConfig evaluates to true or if no CanIcomRxMessageSignalConfig are defined, the whole wakeup condition is considered to be true. All instances of this container refer to the same frame/pdu (see CanIcomMessageId).</L-1>
                                                            </P>
                                                         </INTRODUCTION>
                                                         <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_Can_00452</RELATED-TRACE-ITEM-REF>
                                                         <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                                         <UPPER-MULTIPLICITY-INFINITE>true</UPPER-MULTIPLICITY-INFINITE>
                                                         <PARAMETERS>
                                                            <!-- PARAMETER DEFINITION: CanIcomSignalMask -->
                                                            <ECUC-INTEGER-PARAM-DEF UUID="ECUC:b3259eec-85a6-4940-b2eb-9b30e7545548">
                                                               <SHORT-NAME>CanIcomSignalMask</SHORT-NAME>
                                                               <DESC>
                                                                  <L-2 L="EN">This parameter shall be used to mask a signal in the payload of a CAN message.</L-2>
                                                               </DESC>
                                                               <INTRODUCTION>
                                                                  <P>
                                                                     <L-1 L="EN">The mask is binary AND with the signal payload. The result will be used in combination of the operations defined in CanIcomSignalOperation with the CanIcomSignalValue.</L-1>
                                                                  </P>
                                                               </INTRODUCTION>
                                                               <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_Can_00487</RELATED-TRACE-ITEM-REF>
                                                               <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                                               <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                                               <SCOPE>LOCAL</SCOPE>
                                                               <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                                               <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                                               <VALUE-CONFIG-CLASSES>
                                                                  <ECUC-VALUE-CONFIGURATION-CLASS>
                                                                     <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                                     <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                                                  </ECUC-VALUE-CONFIGURATION-CLASS>
                                                                  <ECUC-VALUE-CONFIGURATION-CLASS>
                                                                     <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                                     <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                                                  </ECUC-VALUE-CONFIGURATION-CLASS>
                                                               </VALUE-CONFIG-CLASSES>
                                                               <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                                               <MAX>18446744073709551615</MAX>
                                                               <MIN>0</MIN>
                                                            </ECUC-INTEGER-PARAM-DEF>
                                                            <!-- PARAMETER DEFINITION: CanIcomSignalOperation -->
                                                            <ECUC-ENUMERATION-PARAM-DEF UUID="ECUC:c6a66701-801b-4ba7-b033-2c81ccb20fd5">
                                                               <SHORT-NAME>CanIcomSignalOperation</SHORT-NAME>
                                                               <DESC>
                                                                  <L-2 L="EN">This parameter defines the operation, which shall be used to verify the signal value creates a wakeup condition.</L-2>
                                                               </DESC>
                                                               <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_Can_00462</RELATED-TRACE-ITEM-REF>
                                                               <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                                               <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                                               <SCOPE>ECU</SCOPE>
                                                               <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                                               <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                                               <VALUE-CONFIG-CLASSES>
                                                                  <ECUC-VALUE-CONFIGURATION-CLASS>
                                                                     <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                                     <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                                                  </ECUC-VALUE-CONFIGURATION-CLASS>
                                                                  <ECUC-VALUE-CONFIGURATION-CLASS>
                                                                     <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                                     <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                                                  </ECUC-VALUE-CONFIGURATION-CLASS>
                                                               </VALUE-CONFIG-CLASSES>
                                                               <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                                               <LITERALS>
                                                                  <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:d5cf18c0-fe09-8fcb-2e8b-ed76c70c6a42">
                                                                     <SHORT-NAME>AND</SHORT-NAME>
                                                                     <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                                                  </ECUC-ENUMERATION-LITERAL-DEF>
                                                                  <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:4a84b6bc-c7a1-980b-32c2-3cd930622267">
                                                                     <SHORT-NAME>EQUAL</SHORT-NAME>
                                                                     <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                                                  </ECUC-ENUMERATION-LITERAL-DEF>
                                                                  <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:c9824ae6-91af-9181-0c79-5a4d3a0c5476">
                                                                     <SHORT-NAME>GREATER</SHORT-NAME>
                                                                     <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                                                  </ECUC-ENUMERATION-LITERAL-DEF>
                                                                  <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:74cfb700-cf12-9469-42dc-949b625b6c82">
                                                                     <SHORT-NAME>SMALLER</SHORT-NAME>
                                                                     <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                                                  </ECUC-ENUMERATION-LITERAL-DEF>
                                                                  <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:ce450865-9a8a-9436-0939-57ece7bf02ca">
                                                                     <SHORT-NAME>XOR</SHORT-NAME>
                                                                     <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                                                  </ECUC-ENUMERATION-LITERAL-DEF>
                                                               </LITERALS>
                                                            </ECUC-ENUMERATION-PARAM-DEF>
                                                            <!-- PARAMETER DEFINITION: CanIcomSignalValue -->
                                                            <ECUC-INTEGER-PARAM-DEF UUID="ECUC:bcc8ac06-0acb-4c88-95b6-1ccb750482a6">
                                                               <SHORT-NAME>CanIcomSignalValue</SHORT-NAME>
                                                               <DESC>
                                                                  <L-2 L="EN">This parameter shall be used to define a signal value which shall be compared (CanIcomSignalOperation) with the masked CanIcomSignalMask value of the received signal (CanIcomSignalRef).</L-2>
                                                               </DESC>
                                                               <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_Can_00488</RELATED-TRACE-ITEM-REF>
                                                               <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                                               <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                                               <SCOPE>LOCAL</SCOPE>
                                                               <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                                               <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                                               <VALUE-CONFIG-CLASSES>
                                                                  <ECUC-VALUE-CONFIGURATION-CLASS>
                                                                     <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                                     <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                                                  </ECUC-VALUE-CONFIGURATION-CLASS>
                                                                  <ECUC-VALUE-CONFIGURATION-CLASS>
                                                                     <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                                     <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                                                  </ECUC-VALUE-CONFIGURATION-CLASS>
                                                               </VALUE-CONFIG-CLASSES>
                                                               <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                                               <MAX>18446744073709551615</MAX>
                                                               <MIN>0</MIN>
                                                            </ECUC-INTEGER-PARAM-DEF>
                                                         </PARAMETERS>
                                                         <REFERENCES>
                                                            <!-- Reference Definition: CanIcomSignalRef -->
                                                            <ECUC-REFERENCE-DEF UUID="ECUC:161d89b2-a487-4461-8cc1-0d5164d13424">
                                                               <SHORT-NAME>CanIcomSignalRef</SHORT-NAME>
                                                               <DESC>
                                                                  <L-2 L="EN">This parameter defines a reference to the signal which shall be checked additional to the message id (CanIcomMessageId).</L-2>
                                                               </DESC>
                                                               <INTRODUCTION>
                                                                  <P>
                                                                     <L-1 L="EN">This reference is used for documentation to define which ComSignal originates this filter setting. All signals being referred by this reference shall point to the same PDU.</L-1>
                                                                  </P>
                                                               </INTRODUCTION>
                                                               <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_Can_00456</RELATED-TRACE-ITEM-REF>
                                                               <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                                               <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                                               <SCOPE>ECU</SCOPE>
                                                               <MULTIPLICITY-CONFIG-CLASSES>
                                                                  <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                                                     <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                                     <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                                                  </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                                                  <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                                                     <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                                     <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                                                  </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                                               </MULTIPLICITY-CONFIG-CLASSES>
                                                               <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                                               <POST-BUILD-VARIANT-MULTIPLICITY>false</POST-BUILD-VARIANT-MULTIPLICITY>
                                                               <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                                               <VALUE-CONFIG-CLASSES>
                                                                  <ECUC-VALUE-CONFIGURATION-CLASS>
                                                                     <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                                     <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                                                  </ECUC-VALUE-CONFIGURATION-CLASS>
                                                                  <ECUC-VALUE-CONFIGURATION-CLASS>
                                                                     <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                                     <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                                                  </ECUC-VALUE-CONFIGURATION-CLASS>
                                                               </VALUE-CONFIG-CLASSES>
                                                               <DESTINATION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/AUTOSAR/EcucDefs/Com/ComConfig/ComSignal</DESTINATION-REF>
                                                            </ECUC-REFERENCE-DEF>
                                                         </REFERENCES>
                                                      </ECUC-PARAM-CONF-CONTAINER-DEF>
                                                   </SUB-CONTAINERS>
                                                </ECUC-PARAM-CONF-CONTAINER-DEF>
                                             </SUB-CONTAINERS>
                                          </ECUC-PARAM-CONF-CONTAINER-DEF>
                                       </SUB-CONTAINERS>
                                    </ECUC-PARAM-CONF-CONTAINER-DEF>
                                 </SUB-CONTAINERS>
                              </ECUC-PARAM-CONF-CONTAINER-DEF>
                           </SUB-CONTAINERS>
                        </ECUC-PARAM-CONF-CONTAINER-DEF>
                        <!-- Container Definition: CanGeneral -->
                        <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:856dd730-a715-4e74-89f9-cd03e465c206">
                           <SHORT-NAME>CanGeneral</SHORT-NAME>
                           <DESC>
                              <L-2 L="EN">This container contains the parameters related each CAN Driver Unit.</L-2>
                           </DESC>
                           <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_Can_00328</RELATED-TRACE-ITEM-REF>
                           <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                           <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                           <PARAMETERS>
                              <!-- PARAMETER DEFINITION: CanDevErrorDetection -->
                              <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:00beaaf9-8ba3-448a-aa81-a27661c11c8b">
                                 <SHORT-NAME>CanDevErrorDetection</SHORT-NAME>
                                 <DESC>
                                    <L-2 L="EN">Switches the Default Error Tracer (Det) detection and notification ON or OFF.</L-2>
                                 </DESC>
                                 <INTRODUCTION>
                                    <P>
                                       <L-1 L="EN">* true: enabled (ON).
                                        * false: disabled (OFF).</L-1>
                                    </P>
                                 </INTRODUCTION>
                                 <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_Can_00064</RELATED-TRACE-ITEM-REF>
                                 <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                 <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                 <SCOPE>LOCAL</SCOPE>
                                 <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                 <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                 <VALUE-CONFIG-CLASSES>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                       <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                       <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                       <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                       <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                 </VALUE-CONFIG-CLASSES>
                                 <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                              </ECUC-BOOLEAN-PARAM-DEF>
                              <!-- PARAMETER DEFINITION: CanIndex -->
                              <ECUC-INTEGER-PARAM-DEF UUID="ECUC:18b93eb8-b1dc-4779-9372-277b674dd618">
                                 <SHORT-NAME>CanIndex</SHORT-NAME>
                                 <DESC>
                                    <L-2 L="EN">Specifies the InstanceId of this module instance. If only one instance is present it shall have the Id 0.</L-2>
                                 </DESC>
                                 <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_Can_00320</RELATED-TRACE-ITEM-REF>
                                 <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                 <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                 <SCOPE>LOCAL</SCOPE>
                                 <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                 <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                 <VALUE-CONFIG-CLASSES>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                       <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                       <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                       <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                       <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                 </VALUE-CONFIG-CLASSES>
                                 <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                 <MAX>255</MAX>
                                 <MIN>0</MIN>
                              </ECUC-INTEGER-PARAM-DEF>
                              <!-- PARAMETER DEFINITION: CanLPduReceiveCalloutFunction -->
                              <ECUC-FUNCTION-NAME-DEF UUID="ECUC:0bf48002-3ae8-405d-8e51-63cbb66a3f2a">
                                 <SHORT-NAME>CanLPduReceiveCalloutFunction</SHORT-NAME>
                                 <DESC>
                                    <L-2 L="EN">This parameter defines the existence and the name of a callout function that is called after a successful</L-2>
                                 </DESC>
                                 <INTRODUCTION>
                                    <P>
                                       <L-1 L="EN">reception of a received CAN Rx L-PDU. If this parameter is omitted no callout shall take place.</L-1>
                                    </P>
                                 </INTRODUCTION>
                                 <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_Can_00434</RELATED-TRACE-ITEM-REF>
                                 <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                 <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                 <SCOPE>LOCAL</SCOPE>
                                 <MULTIPLICITY-CONFIG-CLASSES>
                                    <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                       <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                       <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                    </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                    <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                       <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                       <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                 </MULTIPLICITY-CONFIG-CLASSES>
                                 <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                 <POST-BUILD-VARIANT-MULTIPLICITY>false</POST-BUILD-VARIANT-MULTIPLICITY>
                                 <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                 <VALUE-CONFIG-CLASSES>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                       <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                       <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                       <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                       <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                 </VALUE-CONFIG-CLASSES>
                                 <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                 <ECUC-FUNCTION-NAME-DEF-VARIANTS>
                                    <ECUC-FUNCTION-NAME-DEF-CONDITIONAL/>
                                 </ECUC-FUNCTION-NAME-DEF-VARIANTS>
                              </ECUC-FUNCTION-NAME-DEF>
                              <!-- PARAMETER DEFINITION: CanMainFunctionBusoffPeriod -->
                              <ECUC-FLOAT-PARAM-DEF UUID="ECUC:12306b16-f8b2-418a-9262-e10b8222f967">
                                 <SHORT-NAME>CanMainFunctionBusoffPeriod</SHORT-NAME>
                                 <DESC>
                                    <L-2 L="EN">This parameter describes the period for cyclic call to Can_MainFunction_Busoff. Unit is seconds.</L-2>
                                 </DESC>
                                 <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_Can_00355</RELATED-TRACE-ITEM-REF>
                                 <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                 <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                 <MULTIPLICITY-CONFIG-CLASSES>
                                    <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                       <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                       <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                    </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                    <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                       <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                       <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                 </MULTIPLICITY-CONFIG-CLASSES>
                                 <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                 <POST-BUILD-VARIANT-MULTIPLICITY>false</POST-BUILD-VARIANT-MULTIPLICITY>
                                 <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                 <VALUE-CONFIG-CLASSES>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                       <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                       <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                       <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                       <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                 </VALUE-CONFIG-CLASSES>
                                 <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                 <MAX>65.535</MAX>
                                 <MIN>0.001</MIN>
                              </ECUC-FLOAT-PARAM-DEF>
                              <!-- PARAMETER DEFINITION: CanMainFunctionModePeriod -->
                              <ECUC-FLOAT-PARAM-DEF UUID="ECUC:a4a82737-e923-4dd2-a0c3-8e56b5c0ce7c">
                                 <SHORT-NAME>CanMainFunctionModePeriod</SHORT-NAME>
                                 <DESC>
                                    <L-2 L="EN">This parameter describes the period for cyclic call to Can_MainFunction_Mode. Unit is seconds.</L-2>
                                 </DESC>
                                 <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_Can_00376</RELATED-TRACE-ITEM-REF>
                                 <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                 <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                 <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                 <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                 <VALUE-CONFIG-CLASSES>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                       <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                       <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                       <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                       <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                 </VALUE-CONFIG-CLASSES>
                                 <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                 <MAX>65.535</MAX>
                                 <MIN>0.001</MIN>
                              </ECUC-FLOAT-PARAM-DEF>
                              <!-- PARAMETER DEFINITION: CanMainFunctionWakeupPeriod -->
                              <ECUC-FLOAT-PARAM-DEF UUID="ECUC:c25c3355-86db-4423-a9cb-3f081c873488">
                                 <SHORT-NAME>CanMainFunctionWakeupPeriod</SHORT-NAME>
                                 <DESC>
                                    <L-2 L="EN">This parameter describes the period for cyclic call to Can_MainFunction_Wakeup. Unit is seconds.</L-2>
                                 </DESC>
                                 <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_Can_00357</RELATED-TRACE-ITEM-REF>
                                 <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                 <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                 <MULTIPLICITY-CONFIG-CLASSES>
                                    <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                       <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                       <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                    </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                    <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
