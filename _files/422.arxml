                        <!-- Container Definition: DltMemory -->
                        <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:1a1331b6-d21c-426c-91e2-a798adec55b3">
                           <SHORT-NAME>DltMemory</SHORT-NAME>
                           <DESC>
                              <L-2 L="EN">Configuration parameters for reserving memory for some internal storing and buffer.</L-2>
                           </DESC>
                           <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_Dlt_00828</RELATED-TRACE-ITEM-REF>
                           <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                           <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
