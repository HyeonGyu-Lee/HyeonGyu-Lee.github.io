                                    <ECUC-INTEGER-PARAM-DEF UUID="ECUC:ebc4ec8f-9bcc-4284-befa-fda296bc41b1">
                                       <SHORT-NAME>XcpMaxOdtEntries</SHORT-NAME>
                                       <DESC>
                                          <L-2 L="EN">This parameter indicates the maximum amount of entries in an ODT of this DAQ list (STATIC configuration).</L-2>
                                       </DESC>
                                       <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_Xcp_00058</RELATED-TRACE-ITEM-REF>
                                       <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                       <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                       <SCOPE>ECU</SCOPE>
                                       <ORIGIN>AUTOSAR_ECUC</ORIGIN>
