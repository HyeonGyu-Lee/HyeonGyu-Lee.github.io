                        </ECUC-PARAM-CONF-CONTAINER-DEF>
                        <!-- Container Definition: FrTSynGlobalTimeDomain -->
                        <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:02607b16-6475-42ef-ba99-cde5b5f061b4">
                           <SHORT-NAME>FrTSynGlobalTimeDomain</SHORT-NAME>
                           <DESC>
                              <L-2 L="EN">This represents the existence of a global time domain on Flexray. The FrTSyn module can administrate several global time domains at the same time that in itself form a hierarchy of domains and sub-domains.</L-2>
                           </DESC>
                           <INTRODUCTION>
                              <P>
                                 <L-1 L="EN">If the FrTSyn exists it is assumed that at least one global time domain exists.</L-1>
                              </P>
                           </INTRODUCTION>
                           <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_FrTSyn_00004</RELATED-TRACE-ITEM-REF>
                           <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                           <UPPER-MULTIPLICITY-INFINITE>true</UPPER-MULTIPLICITY-INFINITE>
                           <PARAMETERS>
                              <!-- PARAMETER DEFINITION: FrTSynGlobalTimeDomainId -->
                              <ECUC-INTEGER-PARAM-DEF UUID="ECUC:0f2915c2-44e3-49c0-8901-33efb01f29e1">
                                 <SHORT-NAME>FrTSynGlobalTimeDomainId</SHORT-NAME>
                                 <DESC>
                                    <L-2 L="EN">The global time domain ID.</L-2>
                                 </DESC>
                                 <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_FrTSyn_00005</RELATED-TRACE-ITEM-REF>
                                 <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                 <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                 <SCOPE>LOCAL</SCOPE>
                                 <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                 <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                 <VALUE-CONFIG-CLASSES>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                       <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                       <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                       <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                       <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                 </VALUE-CONFIG-CLASSES>
                                 <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                 <MAX>31</MAX>
                                 <MIN>0</MIN>
                              </ECUC-INTEGER-PARAM-DEF>
                              <!-- PARAMETER DEFINITION: FrTSynGlobalTimeSequenceCounterJumpWidth -->
                              <ECUC-INTEGER-PARAM-DEF UUID="ECUC:6ae0c5ee-752a-4e81-8761-d5dca60b2181">
                                 <SHORT-NAME>FrTSynGlobalTimeSequenceCounterJumpWidth</SHORT-NAME>
                                 <DESC>
                                    <L-2 L="EN">The SequenceCounterJumpWidth specifies the maximum allowed gap of the Sequence Counter between two SYNC resp. two OFS messages.</L-2>
                                 </DESC>
                                 <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_FrTSyn_00022</RELATED-TRACE-ITEM-REF>
                                 <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                 <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                 <SCOPE>LOCAL</SCOPE>
                                 <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                 <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                 <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                 <MAX>15</MAX>
                                 <MIN>1</MIN>
                              </ECUC-INTEGER-PARAM-DEF>
                           </PARAMETERS>
                           <REFERENCES>
                              <!-- Symbolic Name Reference Definition: FrTSynSynchronizedTimeBaseRef -->
                              <ECUC-SYMBOLIC-NAME-REFERENCE-DEF UUID="ECUC:5c424dae-ffcb-4d06-a9be-bcdddc027801">
                                 <SHORT-NAME>FrTSynSynchronizedTimeBaseRef</SHORT-NAME>
                                 <DESC>
                                    <L-2 L="EN">Mandatory reference to the required synchronized time-base.</L-2>
                                 </DESC>
                                 <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_FrTSyn_00018</RELATED-TRACE-ITEM-REF>
                                 <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                 <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                 <SCOPE>LOCAL</SCOPE>
                                 <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                 <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                 <VALUE-CONFIG-CLASSES>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                       <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                       <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                       <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                       <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                 </VALUE-CONFIG-CLASSES>
                                 <DESTINATION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/AUTOSAR/EcucDefs/StbM/StbMSynchronizedTimeBase</DESTINATION-REF>
                              </ECUC-SYMBOLIC-NAME-REFERENCE-DEF>
                           </REFERENCES>
                           <SUB-CONTAINERS>
                              <!-- Container Definition: FrTSynGlobalTimeMaster -->
                              <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:c81d2327-685e-4a2b-bc0f-558a4e47bd25">
                                 <SHORT-NAME>FrTSynGlobalTimeMaster</SHORT-NAME>
                                 <DESC>
                                    <L-2 L="EN">Configuration of the global time master. Each global time domain is required to have exactly one global time master. This master may or may not exist on the configured ECU.</L-2>
                                 </DESC>
                                 <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_FrTSyn_00006</RELATED-TRACE-ITEM-REF>
                                 <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                 <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                 <PARAMETERS>
                                    <!-- PARAMETER DEFINITION: FrTSynGlobalTimeTxCrcSecured -->
                                    <ECUC-ENUMERATION-PARAM-DEF UUID="ECUC:54650f12-e70d-459e-a47b-a74faef4c78b">
                                       <SHORT-NAME>FrTSynGlobalTimeTxCrcSecured</SHORT-NAME>
                                       <DESC>
                                          <L-2 L="EN">This represents the configuration of whether or not CRC is supported.</L-2>
                                       </DESC>
                                       <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_FrTSyn_00013</RELATED-TRACE-ITEM-REF>
                                       <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                       <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                       <SCOPE>LOCAL</SCOPE>
                                       <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                       <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                       <VALUE-CONFIG-CLASSES>
                                          <ECUC-VALUE-CONFIGURATION-CLASS>
                                             <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                             <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                          </ECUC-VALUE-CONFIGURATION-CLASS>
                                          <ECUC-VALUE-CONFIGURATION-CLASS>
                                             <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                             <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                          </ECUC-VALUE-CONFIGURATION-CLASS>
                                       </VALUE-CONFIG-CLASSES>
                                       <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                       <LITERALS>
                                          <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:c524000a-801c-dbd2-fdad-fa4fec0ee752">
                                             <SHORT-NAME>CRC_NOT_SUPPORTED</SHORT-NAME>
                                             <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                          </ECUC-ENUMERATION-LITERAL-DEF>
                                          <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:a905ede2-0181-de3f-e57e-84ab71412e57">
                                             <SHORT-NAME>CRC_SUPPORTED</SHORT-NAME>
                                             <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                          </ECUC-ENUMERATION-LITERAL-DEF>
                                       </LITERALS>
                                    </ECUC-ENUMERATION-PARAM-DEF>
                                    <!-- PARAMETER DEFINITION: FrTSynGlobalTimeTxPeriod -->
                                    <ECUC-FLOAT-PARAM-DEF UUID="ECUC:ba4fee0f-3169-4423-bcde-14f772f57729">
                                       <SHORT-NAME>FrTSynGlobalTimeTxPeriod</SHORT-NAME>
                                       <DESC>
                                          <L-2 L="EN">This represents the TX period. Unit: seconds</L-2>
                                       </DESC>
                                       <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_FrTSyn_00014</RELATED-TRACE-ITEM-REF>
                                       <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                       <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                       <SCOPE>LOCAL</SCOPE>
                                       <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                       <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                       <VALUE-CONFIG-CLASSES>
                                          <ECUC-VALUE-CONFIGURATION-CLASS>
                                             <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                             <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                          </ECUC-VALUE-CONFIGURATION-CLASS>
                                          <ECUC-VALUE-CONFIGURATION-CLASS>
                                             <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                             <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                          </ECUC-VALUE-CONFIGURATION-CLASS>
                                       </VALUE-CONFIG-CLASSES>
                                       <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                       <MAX>Inf</MAX>
                                       <MIN>0</MIN>
                                    </ECUC-FLOAT-PARAM-DEF>
                                 </PARAMETERS>
                                 <SUB-CONTAINERS>
                                    <!-- Container Definition: FrTSynGlobalTimeMasterPdu -->
                                    <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:a6520827-5db3-437b-88ec-4546098276aa">
                                       <SHORT-NAME>FrTSynGlobalTimeMasterPdu</SHORT-NAME>
                                       <DESC>
                                          <L-2 L="EN">This container carries all properties required to configure the PDU sent by the global time master for the given global time domain.</L-2>
                                       </DESC>
                                       <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_FrTSyn_00008</RELATED-TRACE-ITEM-REF>
                                       <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                       <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                       <PARAMETERS>
                                          <!-- PARAMETER DEFINITION: FrTSynGlobalTimeMasterConfirmationHandleId -->
                                          <ECUC-INTEGER-PARAM-DEF UUID="ECUC:b038a143-2607-4a84-a653-5cba56f8faf0">
                                             <SHORT-NAME>FrTSynGlobalTimeMasterConfirmationHandleId</SHORT-NAME>
                                             <DESC>
                                                <L-2 L="EN">This represents the handle ID of the PDU that contains the global time information.</L-2>
                                             </DESC>
                                             <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_FrTSyn_00007</RELATED-TRACE-ITEM-REF>
                                             <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                             <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                             <SCOPE>LOCAL</SCOPE>
                                             <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                             <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                             <VALUE-CONFIG-CLASSES>
                                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                             </VALUE-CONFIG-CLASSES>
                                             <SYMBOLIC-NAME-VALUE>true</SYMBOLIC-NAME-VALUE>
                                             <MAX>65535</MAX>
                                             <MIN>0</MIN>
                                          </ECUC-INTEGER-PARAM-DEF>
                                       </PARAMETERS>
                                       <REFERENCES>
                                          <!-- Reference Definition: FrTSynGlobalTimePduRef -->
                                          <ECUC-REFERENCE-DEF UUID="ECUC:ff92e074-24df-9071-0a59-81b5c1075eac">
                                             <SHORT-NAME>FrTSynGlobalTimePduRef</SHORT-NAME>
                                             <DESC>
                                                <L-2 L="EN">This represents the reference to the Pdu taken to transmit the global time information. The global time master of a global time domain acts as the sender of the Pdu while all the time slaves are supposed to receive the Pdu.</L-2>
                                             </DESC>
                                             <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_FrTSyn_00020</RELATED-TRACE-ITEM-REF>
                                             <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                             <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                             <SCOPE>LOCAL</SCOPE>
                                             <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                             <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                                             <VALUE-CONFIG-CLASSES>
                                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                             </VALUE-CONFIG-CLASSES>
                                             <DESTINATION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/AUTOSAR/EcucDefs/EcuC/EcucConfigSet/EcucPduCollection/Pdu</DESTINATION-REF>
                                          </ECUC-REFERENCE-DEF>
                                       </REFERENCES>
                                    </ECUC-PARAM-CONF-CONTAINER-DEF>
                                 </SUB-CONTAINERS>
                              </ECUC-PARAM-CONF-CONTAINER-DEF>
                              <!-- Container Definition: FrTSynGlobalTimeSlave -->
                              <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:1fc02f8e-48f6-4f0f-bde6-1474e5a447ed">
                                 <SHORT-NAME>FrTSynGlobalTimeSlave</SHORT-NAME>
                                 <DESC>
                                    <L-2 L="EN">This represents the time slave for the enclosing global time domain.</L-2>
                                 </DESC>
                                 <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_FrTSyn_00010</RELATED-TRACE-ITEM-REF>
                                 <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                 <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                 <PARAMETERS>
                                    <!-- PARAMETER DEFINITION: FrTSynRxCrcValidated -->
                                    <ECUC-ENUMERATION-PARAM-DEF UUID="ECUC:506cebff-befa-4be2-a05a-1eacc76a8dfd">
                                       <SHORT-NAME>FrTSynRxCrcValidated</SHORT-NAME>
                                       <DESC>
                                          <L-2 L="EN">This parameter controls whether or not CRC validation shall be supported.</L-2>
                                       </DESC>
                                       <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_FrTSyn_00017</RELATED-TRACE-ITEM-REF>
                                       <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                       <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                       <SCOPE>LOCAL</SCOPE>
                                       <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                       <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                       <VALUE-CONFIG-CLASSES>
                                          <ECUC-VALUE-CONFIGURATION-CLASS>
                                             <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                             <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                          </ECUC-VALUE-CONFIGURATION-CLASS>
                                          <ECUC-VALUE-CONFIGURATION-CLASS>
                                             <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                             <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                          </ECUC-VALUE-CONFIGURATION-CLASS>
                                       </VALUE-CONFIG-CLASSES>
                                       <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                       <LITERALS>
                                          <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:c9aaeb6c-8c9e-dd65-17f0-b22854309ccb">
                                             <SHORT-NAME>CRC_IGNORED</SHORT-NAME>
                                             <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                          </ECUC-ENUMERATION-LITERAL-DEF>
                                          <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:084955cd-ead0-e215-e798-9d5709a62921">
                                             <SHORT-NAME>CRC_NOT_VALIDATED</SHORT-NAME>
                                             <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                          </ECUC-ENUMERATION-LITERAL-DEF>
                                          <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:f490be0e-39e5-e7d6-e26a-135a1571e6d2">
                                             <SHORT-NAME>CRC_VALIDATED</SHORT-NAME>
                                             <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                          </ECUC-ENUMERATION-LITERAL-DEF>
                                       </LITERALS>
                                    </ECUC-ENUMERATION-PARAM-DEF>
                                 </PARAMETERS>
                                 <SUB-CONTAINERS>
                                    <!-- Container Definition: FrTSynGlobalTimeSlavePdu -->
                                    <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:a2b74047-bd0f-4e72-bb21-d7fa946f40e6">
                                       <SHORT-NAME>FrTSynGlobalTimeSlavePdu</SHORT-NAME>
                                       <DESC>
                                          <L-2 L="EN">This container carries all properties required to configure the PDU received by the time slave for the given global time domain.</L-2>
                                       </DESC>
                                       <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_FrTSyn_00012</RELATED-TRACE-ITEM-REF>
                                       <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                       <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                       <PARAMETERS>
                                          <!-- PARAMETER DEFINITION: FrTSynGlobalTimeSlaveHandleId -->
                                          <ECUC-INTEGER-PARAM-DEF UUID="ECUC:4543db85-68dc-481d-bcf5-224358ce207d">
                                             <SHORT-NAME>FrTSynGlobalTimeSlaveHandleId</SHORT-NAME>
                                             <DESC>
                                                <L-2 L="EN">This represents the handle ID of the PDU that contains the global time information.</L-2>
                                             </DESC>
                                             <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_FrTSyn_00011</RELATED-TRACE-ITEM-REF>
                                             <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                             <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                             <SCOPE>LOCAL</SCOPE>
                                             <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                             <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                             <VALUE-CONFIG-CLASSES>
                                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                             </VALUE-CONFIG-CLASSES>
                                             <SYMBOLIC-NAME-VALUE>true</SYMBOLIC-NAME-VALUE>
                                             <MAX>65535</MAX>
                                             <MIN>0</MIN>
                                          </ECUC-INTEGER-PARAM-DEF>
                                       </PARAMETERS>
                                       <REFERENCES>
                                          <!-- Reference Definition: FrTSynGlobalTimePduRef -->
                                          <ECUC-REFERENCE-DEF UUID="ECUC:fbf81894-843b-9b68-3c8f-146a4bf428e8">
                                             <SHORT-NAME>FrTSynGlobalTimePduRef</SHORT-NAME>
                                             <DESC>
                                                <L-2 L="EN">This represents the reference to the Pdu taken to transmit the global time information. The global time master of a global time domain acts as the sender of the Pdu while all the time slaves are supposed to receive the Pdu.</L-2>
                                             </DESC>
                                             <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_FrTSyn_00021</RELATED-TRACE-ITEM-REF>
                                             <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                             <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                             <SCOPE>LOCAL</SCOPE>
                                             <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                             <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                                             <VALUE-CONFIG-CLASSES>
                                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                             </VALUE-CONFIG-CLASSES>
                                             <DESTINATION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/AUTOSAR/EcucDefs/EcuC/EcucConfigSet/EcucPduCollection/Pdu</DESTINATION-REF>
                                          </ECUC-REFERENCE-DEF>
                                       </REFERENCES>
                                    </ECUC-PARAM-CONF-CONTAINER-DEF>
                                 </SUB-CONTAINERS>
                              </ECUC-PARAM-CONF-CONTAINER-DEF>
                           </SUB-CONTAINERS>
                        </ECUC-PARAM-CONF-CONTAINER-DEF>
                     </CONTAINERS>
                  </ECUC-MODULE-DEF>
                  <!-- Module Definition: FrTp -->
                  <ECUC-MODULE-DEF UUID="ECUC:2934096d-28a8-4cd7-bd56-5cd7c19809ba">
                     <SHORT-NAME>FrTp</SHORT-NAME>
                     <DESC>
                        <L-2 L="EN">Configuration of the FlexRay Transport Protocol module according to ISO 10681-2.</L-2>
                     </DESC>
                     <ADMIN-DATA>
                        <DOC-REVISIONS>
                           <DOC-REVISION>
                              <REVISION-LABEL>4.2.2</REVISION-LABEL>
                              <ISSUED-BY>AUTOSAR</ISSUED-BY>
                              <DATE>2014-10-31</DATE>
                           </DOC-REVISION>
                        </DOC-REVISIONS>
                     </ADMIN-DATA>
                     <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_FrTp_00001</RELATED-TRACE-ITEM-REF>
                     <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                     <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                     <POST-BUILD-VARIANT-SUPPORT>true</POST-BUILD-VARIANT-SUPPORT>
                     <SUPPORTED-CONFIG-VARIANTS>
                        <SUPPORTED-CONFIG-VARIANT>VARIANT-POST-BUILD</SUPPORTED-CONFIG-VARIANT>
                        <SUPPORTED-CONFIG-VARIANT>VARIANT-PRE-COMPILE</SUPPORTED-CONFIG-VARIANT>
                     </SUPPORTED-CONFIG-VARIANTS>
                     <CONTAINERS>
                        <!-- Container Definition: FrTpGeneral -->
                        <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:75dd14c2-0fdb-4fa2-9ab7-002e922049a1">
                           <SHORT-NAME>FrTpGeneral</SHORT-NAME>
                           <DESC>
                              <L-2 L="EN">This container contains the general configuration parameters of the FlexRay Transport Protocol module.</L-2>
                           </DESC>
                           <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_FrTp_00009</RELATED-TRACE-ITEM-REF>
                           <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                           <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                           <PARAMETERS>
                              <!-- PARAMETER DEFINITION: FrTpAckRt -->
                              <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:7910a674-32c7-4b67-8eea-598e80fc2e55">
                                 <SHORT-NAME>FrTpAckRt</SHORT-NAME>
                                 <DESC>
                                    <L-2 L="EN">Preprocessor switch for enabling the Acknowledgement and retry mechanisms.</L-2>
                                 </DESC>
                                 <INTRODUCTION>
                                    <P>
                                       <L-1 L="EN">True:  Acknowledge and Retry is enabled
                                        False: Acknowledge and Retry is disabled</L-1>
                                    </P>
                                 </INTRODUCTION>
                                 <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_FrTp_00002</RELATED-TRACE-ITEM-REF>
                                 <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                 <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                 <SCOPE>LOCAL</SCOPE>
                                 <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                 <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                 <VALUE-CONFIG-CLASSES>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                       <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                       <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                       <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                       <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                 </VALUE-CONFIG-CLASSES>
                                 <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                              </ECUC-BOOLEAN-PARAM-DEF>
                              <!-- PARAMETER DEFINITION: FrTpChanNum -->
                              <ECUC-INTEGER-PARAM-DEF UUID="ECUC:2c60f0d8-b645-49c3-9ae1-2a9d9c5ca3af">
                                 <SHORT-NAME>FrTpChanNum</SHORT-NAME>
                                 <DESC>
                                    <L-2 L="EN">Preprocessor switch for defining the number of concurrent channels the module supports. Up to 32 channels shall be definable here.</L-2>
                                 </DESC>
                                 <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_FrTp_00004</RELATED-TRACE-ITEM-REF>
                                 <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                 <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                 <SCOPE>LOCAL</SCOPE>
                                 <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                 <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                 <VALUE-CONFIG-CLASSES>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                       <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                       <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                       <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                       <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                 </VALUE-CONFIG-CLASSES>
                                 <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                 <MAX>32</MAX>
                                 <MIN>1</MIN>
                              </ECUC-INTEGER-PARAM-DEF>
                              <!-- PARAMETER DEFINITION: FrTpChangeParamApi -->
                              <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:85e4b12b-782f-4e3d-8e90-02c5c3f6f023">
                                 <SHORT-NAME>FrTpChangeParamApi</SHORT-NAME>
                                 <DESC>
                                    <L-2 L="EN">Preprocessor switch for enabling the API to change FrTp communication</L-2>
                                 </DESC>
                                 <INTRODUCTION>
                                    <P>
                                       <L-1 L="EN">parameters. 
                                        True: ChangeParameter API is enabled 
                                        False: ChangeParameter API is disabled.</L-1>
                                    </P>
                                 </INTRODUCTION>
                                 <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_FrTp_00052</RELATED-TRACE-ITEM-REF>
                                 <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                 <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                 <SCOPE>LOCAL</SCOPE>
                                 <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                 <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                 <VALUE-CONFIG-CLASSES>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                       <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                       <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                       <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                       <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                 </VALUE-CONFIG-CLASSES>
                                 <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                              </ECUC-BOOLEAN-PARAM-DEF>
                              <!-- PARAMETER DEFINITION: FrTpDevErrorDetect -->
                              <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:dbe9dcee-eb95-48ec-9f9a-f6cb24e443c9">
                                 <SHORT-NAME>FrTpDevErrorDetect</SHORT-NAME>
                                 <DESC>
                                    <L-2 L="EN">Switches the Default Error Tracer (Det) detection and notification ON or OFF.</L-2>
                                 </DESC>
                                 <INTRODUCTION>
                                    <P>
                                       <L-1 L="EN">* true: enabled (ON).
                                        * false: disabled (OFF).</L-1>
                                    </P>
                                 </INTRODUCTION>
                                 <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_FrTp_00008</RELATED-TRACE-ITEM-REF>
                                 <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                 <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                 <SCOPE>LOCAL</SCOPE>
                                 <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                 <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                 <VALUE-CONFIG-CLASSES>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                       <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                       <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                       <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                       <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                 </VALUE-CONFIG-CLASSES>
                                 <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                              </ECUC-BOOLEAN-PARAM-DEF>
                              <!-- PARAMETER DEFINITION: FrTpFullDuplexEnable -->
                              <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:6db47148-f6bc-438a-9a44-b2866e298b45">
                                 <SHORT-NAME>FrTpFullDuplexEnable</SHORT-NAME>
                                 <DESC>
                                    <L-2 L="EN">Preprocessor switch for enabling full duplex mechanisms for all channels.</L-2>
                                 </DESC>
                                 <INTRODUCTION>
                                    <P>
                                       <L-1 L="EN">True: Full duplex is enabled 
                                        False: Fullduplex is disabled (Half duplex is enabled)</L-1>
                                    </P>
                                 </INTRODUCTION>
                                 <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_FrTp_00051</RELATED-TRACE-ITEM-REF>
                                 <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                 <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                 <SCOPE>LOCAL</SCOPE>
                                 <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                 <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                 <VALUE-CONFIG-CLASSES>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                       <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                       <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                       <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                       <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                 </VALUE-CONFIG-CLASSES>
                                 <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                 <DEFAULT-VALUE>false</DEFAULT-VALUE>
                              </ECUC-BOOLEAN-PARAM-DEF>
                              <!-- PARAMETER DEFINITION: FrTpMainFuncCycle -->
                              <ECUC-FLOAT-PARAM-DEF UUID="ECUC:5856a139-09b4-4ca8-9bcb-75382ffadae4">
                                 <SHORT-NAME>FrTpMainFuncCycle</SHORT-NAME>
                                 <DESC>
                                    <L-2 L="EN">This parameter contains the calling period of the TPs Main Function. The parameter is specified in seconds.</L-2>
                                 </DESC>
                                 <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_FrTp_00011</RELATED-TRACE-ITEM-REF>
                                 <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                 <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                 <SCOPE>LOCAL</SCOPE>
                                 <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                 <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                 <VALUE-CONFIG-CLASSES>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                       <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                       <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                       <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                       <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                 </VALUE-CONFIG-CLASSES>
                                 <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                 <MAX>Inf</MAX>
                                 <MIN>0</MIN>
                              </ECUC-FLOAT-PARAM-DEF>
                              <!-- PARAMETER DEFINITION: FrTpTransmitCancellation -->
                              <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:23763db2-59f4-4aa4-9b85-2c275c821b27">
                                 <SHORT-NAME>FrTpTransmitCancellation</SHORT-NAME>
                                 <DESC>
                                    <L-2 L="EN">Preprocessor switch for enabling Transmit Cancellation and Receive Cancellation.</L-2>
                                 </DESC>
                                 <INTRODUCTION>
                                    <P>
                                       <L-1 L="EN">True:  Transmit/Receive Cancellation is enabled
                                        False: Transmit/Receive Cancellation is disabled</L-1>
                                    </P>
                                 </INTRODUCTION>
                                 <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_FrTp_00036</RELATED-TRACE-ITEM-REF>
                                 <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                 <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                 <SCOPE>LOCAL</SCOPE>
                                 <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                 <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                 <VALUE-CONFIG-CLASSES>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                       <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                       <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                       <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                       <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                 </VALUE-CONFIG-CLASSES>
                                 <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                 <DEFAULT-VALUE>false</DEFAULT-VALUE>
                              </ECUC-BOOLEAN-PARAM-DEF>
                              <!-- PARAMETER DEFINITION: FrTpUnknownMsgLength -->
                              <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:c226ddd7-ae28-4cdd-baca-791fe3cad4e1">
                                 <SHORT-NAME>FrTpUnknownMsgLength</SHORT-NAME>
                                 <DESC>
                                    <L-2 L="EN">Preprocessor switch to support data transfer with unknown message length.</L-2>
                                 </DESC>
                                 <INTRODUCTION>
                                    <P>
                                       <L-1 L="EN">True:  Transmission with unknown message length is enabled
                                        False: Transmission with unknown message length is disabled</L-1>
                                    </P>
                                 </INTRODUCTION>
                                 <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_FrTp_00044</RELATED-TRACE-ITEM-REF>
                                 <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                 <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                 <SCOPE>LOCAL</SCOPE>
                                 <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                 <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                 <VALUE-CONFIG-CLASSES>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                       <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                       <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                       <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                       <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                 </VALUE-CONFIG-CLASSES>
                                 <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                              </ECUC-BOOLEAN-PARAM-DEF>
                              <!-- PARAMETER DEFINITION: FrTpVersionInfoApi -->
                              <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:8ce0d461-1481-4f38-b0f2-dbbb6739c42f">
                                 <SHORT-NAME>FrTpVersionInfoApi</SHORT-NAME>
                                 <DESC>
                                    <L-2 L="EN">Preprocessor switch for enabling the Version info API.</L-2>
                                 </DESC>
                                 <INTRODUCTION>
                                    <P>
                                       <L-1 L="EN">True:  Version Info API is enabled
                                        False: Version Info API is disabled</L-1>
                                    </P>
                                 </INTRODUCTION>
                                 <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_FrTp_00045</RELATED-TRACE-ITEM-REF>
                                 <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                 <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                 <SCOPE>LOCAL</SCOPE>
                                 <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                 <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                 <VALUE-CONFIG-CLASSES>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                       <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                       <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                       <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                       <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                 </VALUE-CONFIG-CLASSES>
                                 <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                              </ECUC-BOOLEAN-PARAM-DEF>
                           </PARAMETERS>
                        </ECUC-PARAM-CONF-CONTAINER-DEF>
                        <!-- Container Definition: FrTpMultipleConfig -->
                        <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:a9475420-4a73-4ce4-83bb-b93a5cee8dff">
                           <SHORT-NAME>FrTpMultipleConfig</SHORT-NAME>
                           <DESC>
                              <L-2 L="EN">This container contains the configuration parameters and sub containers of the AUTOSAR FrTp module.</L-2>
                           </DESC>
                           <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_FrTp_00018</RELATED-TRACE-ITEM-REF>
                           <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                           <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                           <PARAMETERS>
                              <!-- PARAMETER DEFINITION: FrTpMaxConnectionCnt -->
                              <ECUC-INTEGER-PARAM-DEF UUID="ECUC:8761f4cd-c438-475a-b286-7bb2c8242c33">
                                 <SHORT-NAME>FrTpMaxConnectionCnt</SHORT-NAME>
                                 <DESC>
                                    <L-2 L="EN">Maximum number of TP connections. This parameter is needed only in case of post-build loadable implementation using static memory allocation.</L-2>
                                 </DESC>
                                 <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_FrTp_00054</RELATED-TRACE-ITEM-REF>
                                 <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                 <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                 <SCOPE>LOCAL</SCOPE>
                                 <MULTIPLICITY-CONFIG-CLASSES>
                                    <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                       <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                       <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                    </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                    <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                       <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                       <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                 </MULTIPLICITY-CONFIG-CLASSES>
                                 <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                 <POST-BUILD-VARIANT-MULTIPLICITY>false</POST-BUILD-VARIANT-MULTIPLICITY>
                                 <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                 <VALUE-CONFIG-CLASSES>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                       <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                       <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                       <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                       <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                 </VALUE-CONFIG-CLASSES>
                                 <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                 <MAX>18446744073709551615</MAX>
                                 <MIN>0</MIN>
                              </ECUC-INTEGER-PARAM-DEF>
                           </PARAMETERS>
                           <SUB-CONTAINERS>
                              <!-- Container Definition: FrTpConnection -->
                              <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:daf437b6-aa4f-4ef5-92b5-33874ada757a">
                                 <SHORT-NAME>FrTpConnection</SHORT-NAME>
                                 <DESC>
                                    <L-2 L="EN">This container contains the connection specific parameters to transfer N-PDUs via FlexRay TP.</L-2>
                                 </DESC>
                                 <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_FrTp_00006</RELATED-TRACE-ITEM-REF>
                                 <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                 <UPPER-MULTIPLICITY-INFINITE>true</UPPER-MULTIPLICITY-INFINITE>
                                 <MULTIPLICITY-CONFIG-CLASSES>
                                    <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                       <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                       <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                    </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                    <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                       <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                       <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                 </MULTIPLICITY-CONFIG-CLASSES>
                                 <POST-BUILD-VARIANT-MULTIPLICITY>true</POST-BUILD-VARIANT-MULTIPLICITY>
                                 <PARAMETERS>
                                    <!-- PARAMETER DEFINITION: FrTpBandwidthLimitation -->
                                    <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:be5bca90-0e33-4c7d-87ad-76dec2d0d2aa">
                                       <SHORT-NAME>FrTpBandwidthLimitation</SHORT-NAME>
                                       <DESC>
                                          <L-2 L="EN">This parameter indicates whether the connection requires a bandwidth limitation or not. If FrTpBandwidthLimitation=True the sender shall send a StartFrame always on the first PDU of a PDU-Pool.</L-2>
                                       </DESC>
                                       <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_FrTp_00050</RELATED-TRACE-ITEM-REF>
                                       <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                       <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                       <SCOPE>LOCAL</SCOPE>
                                       <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                       <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                                       <VALUE-CONFIG-CLASSES>
                                          <ECUC-VALUE-CONFIGURATION-CLASS>
                                             <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                             <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                          </ECUC-VALUE-CONFIGURATION-CLASS>
                                          <ECUC-VALUE-CONFIGURATION-CLASS>
                                             <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                             <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                          </ECUC-VALUE-CONFIGURATION-CLASS>
                                       </VALUE-CONFIG-CLASSES>
                                       <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                    </ECUC-BOOLEAN-PARAM-DEF>
                                    <!-- PARAMETER DEFINITION: FrTpLa -->
                                    <ECUC-INTEGER-PARAM-DEF UUID="ECUC:132fb4bd-1955-4930-8d55-7ac3532fdfaf">
                                       <SHORT-NAME>FrTpLa</SHORT-NAME>
                                       <DESC>
                                          <L-2 L="EN">This parameter defines the Local Address for the respective connection. When the local instance is the sender, this is the Source Address within the TP frame. When the local instance is the receiver, this is the Target Address within the TP frame.</L-2>
                                       </DESC>
                                       <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_FrTp_00010</RELATED-TRACE-ITEM-REF>
                                       <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                       <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                       <SCOPE>LOCAL</SCOPE>
                                       <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                       <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                                       <VALUE-CONFIG-CLASSES>
                                          <ECUC-VALUE-CONFIGURATION-CLASS>
                                             <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                             <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                          </ECUC-VALUE-CONFIGURATION-CLASS>
                                          <ECUC-VALUE-CONFIGURATION-CLASS>
                                             <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                             <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                          </ECUC-VALUE-CONFIGURATION-CLASS>
                                       </VALUE-CONFIG-CLASSES>
                                       <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                       <MAX>65535</MAX>
                                       <MIN>0</MIN>
                                    </ECUC-INTEGER-PARAM-DEF>
                                    <!-- PARAMETER DEFINITION: FrTpMultipleReceiverCon -->
                                    <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:3dbd0c29-a62d-4d7b-b708-151974cd4b20">
                                       <SHORT-NAME>FrTpMultipleReceiverCon</SHORT-NAME>
                                       <DESC>
                                          <L-2 L="EN">This parameter defines, whether this connection is an 1:1 ('false') or an 1:n ('true') connection. If data segmentation is required this parameter is used to check whether segmentation is possible or not. If the connection is 1:n segmentation is not possible and an error will occur.</L-2>
                                       </DESC>
                                       <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_FrTp_00019</RELATED-TRACE-ITEM-REF>
                                       <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                       <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                       <SCOPE>LOCAL</SCOPE>
                                       <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                       <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                                       <VALUE-CONFIG-CLASSES>
                                          <ECUC-VALUE-CONFIGURATION-CLASS>
                                             <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                             <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                          </ECUC-VALUE-CONFIGURATION-CLASS>
                                          <ECUC-VALUE-CONFIGURATION-CLASS>
                                             <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                             <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                          </ECUC-VALUE-CONFIGURATION-CLASS>
                                       </VALUE-CONFIG-CLASSES>
                                       <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                    </ECUC-BOOLEAN-PARAM-DEF>
                                    <!-- PARAMETER DEFINITION: FrTpRa -->
                                    <ECUC-INTEGER-PARAM-DEF UUID="ECUC:e213f58a-7e1f-4d2a-a4d3-1605a5a82429">
                                       <SHORT-NAME>FrTpRa</SHORT-NAME>
                                       <DESC>
                                          <L-2 L="EN">This parameter defines the Remote Address for the respective connection. When the local instance is the sender, this is the Target Address within the TP frame. When the local instance is the receiver, this is the Source Address within the TP frame.</L-2>
                                       </DESC>
                                       <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_FrTp_00021</RELATED-TRACE-ITEM-REF>
                                       <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                       <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                       <SCOPE>LOCAL</SCOPE>
                                       <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                       <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                                       <VALUE-CONFIG-CLASSES>
                                          <ECUC-VALUE-CONFIGURATION-CLASS>
                                             <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                             <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                          </ECUC-VALUE-CONFIGURATION-CLASS>
                                          <ECUC-VALUE-CONFIGURATION-CLASS>
                                             <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                             <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                          </ECUC-VALUE-CONFIGURATION-CLASS>
                                       </VALUE-CONFIG-CLASSES>
                                       <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                       <MAX>65535</MAX>
                                       <MIN>0</MIN>
                                    </ECUC-INTEGER-PARAM-DEF>
                                 </PARAMETERS>
                                 <REFERENCES>
                                    <!-- Reference Definition: FrTpConCtrlRef -->
                                    <ECUC-REFERENCE-DEF UUID="ECUC:af3befcd-45e9-4148-8faf-64746c35f94f">
                                       <SHORT-NAME>FrTpConCtrlRef</SHORT-NAME>
                                       <DESC>
                                          <L-2 L="EN">FrTpConnectionControlReference:</L-2>
                                       </DESC>
                                       <INTRODUCTION>
                                          <P>
                                             <L-1 L="EN">This parameter defines a reference to a connection control container.</L-1>
                                          </P>
                                       </INTRODUCTION>
                                       <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_FrTp_00005</RELATED-TRACE-ITEM-REF>
                                       <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                       <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                       <SCOPE>LOCAL</SCOPE>
                                       <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                       <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                                       <VALUE-CONFIG-CLASSES>
                                          <ECUC-VALUE-CONFIGURATION-CLASS>
                                             <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                             <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                          </ECUC-VALUE-CONFIGURATION-CLASS>
                                          <ECUC-VALUE-CONFIGURATION-CLASS>
                                             <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                             <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                          </ECUC-VALUE-CONFIGURATION-CLASS>
                                       </VALUE-CONFIG-CLASSES>
                                       <DESTINATION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/AUTOSAR/EcucDefs/FrTp/FrTpMultipleConfig/FrTpConnectionControl</DESTINATION-REF>
                                    </ECUC-REFERENCE-DEF>
                                    <!-- Reference Definition: FrTpRxPduPoolRef -->
                                    <ECUC-REFERENCE-DEF UUID="ECUC:e0933913-63de-43ec-8cb5-422fc5309288">
                                       <SHORT-NAME>FrTpRxPduPoolRef</SHORT-NAME>
                                       <DESC>
                                          <L-2 L="EN">This parameter defines a reference to a RxPduPool.</L-2>
                                       </DESC>
                                       <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_FrTp_00025</RELATED-TRACE-ITEM-REF>
                                       <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                       <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                       <SCOPE>LOCAL</SCOPE>
                                       <MULTIPLICITY-CONFIG-CLASSES>
                                          <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                             <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                             <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                          </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                          <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                             <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                             <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                          </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                       </MULTIPLICITY-CONFIG-CLASSES>
                                       <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                       <POST-BUILD-VARIANT-MULTIPLICITY>true</POST-BUILD-VARIANT-MULTIPLICITY>
                                       <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                                       <VALUE-CONFIG-CLASSES>
                                          <ECUC-VALUE-CONFIGURATION-CLASS>
                                             <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                             <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                          </ECUC-VALUE-CONFIGURATION-CLASS>
                                          <ECUC-VALUE-CONFIGURATION-CLASS>
                                             <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                             <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                          </ECUC-VALUE-CONFIGURATION-CLASS>
                                       </VALUE-CONFIG-CLASSES>
                                       <DESTINATION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/AUTOSAR/EcucDefs/FrTp/FrTpMultipleConfig/FrTpRxPduPool</DESTINATION-REF>
                                    </ECUC-REFERENCE-DEF>
                                    <!-- Reference Definition: FrTpTxPduPoolRef -->
                                    <ECUC-REFERENCE-DEF UUID="ECUC:ad5e9a14-327d-4303-ae3e-a8b729639193">
                                       <SHORT-NAME>FrTpTxPduPoolRef</SHORT-NAME>
                                       <DESC>
                                          <L-2 L="EN">This parameter defines a reference to a TxPduPool.</L-2>
                                       </DESC>
                                       <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_FrTp_00039</RELATED-TRACE-ITEM-REF>
                                       <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                       <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                       <SCOPE>LOCAL</SCOPE>
                                       <MULTIPLICITY-CONFIG-CLASSES>
                                          <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                             <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                             <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                          </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                          <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                             <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                             <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                          </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                       </MULTIPLICITY-CONFIG-CLASSES>
