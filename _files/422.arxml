                              <ECUC-STRING-PARAM-DEF UUID="ECUC:ce3b2af2-6be2-4729-b2a5-c401fec3c8b7">
                                 <SHORT-NAME>FrSMCddHeaderFile</SHORT-NAME>
                                 <DESC>
                                    <L-2 L="EN">This parameter defines header files for callback functions which are implemented by CDD, e.g. &lt;Cdd&gt;_SyncLossErrorIndication.</L-2>
                                 </DESC>
                                 <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_FrSM_00171</RELATED-TRACE-ITEM-REF>
