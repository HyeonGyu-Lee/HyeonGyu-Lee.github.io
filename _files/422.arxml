                                          <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:cd0817ff-4984-4c30-945b-17d9f12a5937">
                                             <SHORT-NAME>SdEventHandler</SHORT-NAME>
                                             <DESC>
                                                <L-2 L="EN">Container Element for representing an EventGroup as part of the Service Instance.</L-2>
                                             </DESC>
                                             <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_SD_00055</RELATED-TRACE-ITEM-REF>
