                                             <MIN>0</MIN>
                                          </ECUC-FLOAT-PARAM-DEF>
                                          <!-- PARAMETER DEFINITION: SdServerTimerInitialOfferDelayMin -->
                                          <ECUC-FLOAT-PARAM-DEF UUID="ECUC:4a39de00-b0fb-42e5-a5d8-53c0921bd820">
                                             <SHORT-NAME>SdServerTimerInitialOfferDelayMin</SHORT-NAME>
