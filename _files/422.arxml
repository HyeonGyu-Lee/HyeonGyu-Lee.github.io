                                       <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                    </ECUC-ENUMERATION-LITERAL-DEF>
                                    <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:8e58c3cb-891f-98a3-5ace-27345622addf">
