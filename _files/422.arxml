                                    </ECUC-REFERENCE-DEF>
                                 </REFERENCES>
                                 <SUB-CONTAINERS>
                                    <!-- Container Definition: SpiChannelList -->
                                    <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:ab2edd79-9273-437e-a4a1-61b8a5b3813c">
                                       <SHORT-NAME>SpiChannelList</SHORT-NAME>
                                       <DESC>
