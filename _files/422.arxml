                                                                              <!-- PARAMETER DEFINITION: DcmDspDiagnosisRepresentationDataResolution -->
                                                                              <ECUC-FLOAT-PARAM-DEF UUID="ECUC:393aaa04-47b4-6dd1-0a6b-5b1ab722a134">
