                                                      <!-- PARAMETER DEFINITION: ComTxModeTimeOffset -->
                                                      <ECUC-FLOAT-PARAM-DEF UUID="ECUC:ce45c969-d5d9-d305-f36e-8e8a95353990">
                                                         <SHORT-NAME>ComTxModeTimeOffset</SHORT-NAME>
                                                         <DESC>
                                                            <L-2 L="EN">Defines the period in seconds between the start of the I-PDU by Com_IpduGroupControl and the first transmission request in case ComTxModeMode is configured to PERIODIC or MIXED. In case of the mixed transmission mode only the periodic part is affected.</L-2>
                                                         </DESC>
                                                         <INTRODUCTION>
                                                            <P>
                                                               <L-1 L="EN">In case ComTxModeTimeOffset is omitted or configured to 0, the first periodic transmission shall be transmitted within the next invocation of Com_MainFunctionTx.</L-1>
                                                            </P>
                                                         </INTRODUCTION>
                                                         <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_Com_00180</RELATED-TRACE-ITEM-REF>
