                                             <SHORT-NAME>FrRange</SHORT-NAME>
                                             <DESC>
                                                <L-2 L="EN">FIFO Frame Id range acceptance criteria.</L-2>
                                             </DESC>
                                             <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_Fr_00013</RELATED-TRACE-ITEM-REF>
                                             <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
