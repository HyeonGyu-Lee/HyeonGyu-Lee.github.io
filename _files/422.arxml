                                       <SUB-CONTAINERS>
                                          <!-- Container Definition: RamTstBlockParams -->
                                          <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:365453a2-a957-4210-899c-637b8bb698fe">
                                             <SHORT-NAME>RamTstBlockParams</SHORT-NAME>
                                             <DESC>
                                                <L-2 L="EN">This container holds the description for one block of RAM.  For each RAM block to be tested by a given algorithm, there is one container which describes the block.  Multiple instances of this container are included in each container RamTst_AlgParams.</L-2>
                                             </DESC>
                                             <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_RamTst_00091</RELATED-TRACE-ITEM-REF>
                                             <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                             <UPPER-MULTIPLICITY>65535</UPPER-MULTIPLICITY>
