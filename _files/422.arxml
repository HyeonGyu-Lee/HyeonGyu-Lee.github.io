                                 <MAX>4294967295</MAX>
                                 <MIN>0</MIN>
                              </ECUC-INTEGER-PARAM-DEF>
                              <!-- PARAMETER DEFINITION: DltMaxCountAppIds -->
                              <ECUC-INTEGER-PARAM-DEF UUID="ECUC:b5e67bde-10d3-4c8b-a84d-2f6dd5c19950">
                                 <SHORT-NAME>DltMaxCountAppIds</SHORT-NAME>
                                 <DESC>
                                    <L-2 L="EN">The maximum count of register able Application Ids. There shall be a table to manage registered Application IDs, this is the number of lines to hold in this table.</L-2>
                                 </DESC>
                                 <INTRODUCTION>
                                    <P>
                                       <L-1 L="EN">Unit: byte</L-1>
                                    </P>
                                 </INTRODUCTION>
                                 <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_Dlt_00824</RELATED-TRACE-ITEM-REF>
