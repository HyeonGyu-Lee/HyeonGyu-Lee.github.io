                                                   <SHORT-NAME>FrIfTxPduRef</SHORT-NAME>
                                                   <DESC>
                                                      <L-2 L="EN">Reference to the external PDU definition.</L-2>
                                                   </DESC>
                                                   <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_FrIf_06074</RELATED-TRACE-ITEM-REF>
