                                    <ECUC-INTEGER-PARAM-DEF UUID="ECUC:86331330-8cf2-4ae5-af39-f65878df134e">
                                       <SHORT-NAME>J1939NmNodePreferredAddress</SHORT-NAME>
                                       <DESC>
                                          <L-2 L="EN">Source address of this node used for address claiming.</L-2>
                                       </DESC>
                                       <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_J1939Nm_00016</RELATED-TRACE-ITEM-REF>
                                       <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
