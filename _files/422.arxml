                                             </REFERENCES>
                                          </ECUC-PARAM-CONF-CONTAINER-DEF>
                                          <!-- Container Definition: SdServerCapabilityRecord -->
                                          <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:874b7563-1cb2-8eb2-5927-b700f35c97e7">
                                             <SHORT-NAME>SdServerCapabilityRecord</SHORT-NAME>
                                             <DESC>
                                                <L-2 L="EN">Sd uses capability records to store arbitrary name/value pairs conveying additional information about the named service.</L-2>
                                             </DESC>
                                             <INTRODUCTION>
                                                <P>
                                                   <L-1 L="EN">The following use cases are supported:
                                                        1) Key present, with no value (e.g. "passreq" -- password required for this service)

                                                        2) Key present, with empty value (e.g. "PlugIns=" server supports plugins, but none are presently installed)

                                                        3) Key present, with non-empty value (e.g. "PlugIns=JPEG,MPEG2,MPEG4")</L-1>
                                                </P>
                                             </INTRODUCTION>
                                             <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_SD_00032</RELATED-TRACE-ITEM-REF>
                                             <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                             <UPPER-MULTIPLICITY-INFINITE>true</UPPER-MULTIPLICITY-INFINITE>
                                             <PARAMETERS>
                                                <!-- PARAMETER DEFINITION: SdServerCapabilityRecordKey -->
                                                <ECUC-STRING-PARAM-DEF UUID="ECUC:2bf79f01-8d7d-dcdd-fa22-be8fe3ac494f">
                                                   <SHORT-NAME>SdServerCapabilityRecordKey</SHORT-NAME>
                                                   <DESC>
                                                      <L-2 L="EN">Defines a CapabilityRecord key.</L-2>
                                                   </DESC>
                                                   <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_SD_00033</RELATED-TRACE-ITEM-REF>
                                                   <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                                   <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
