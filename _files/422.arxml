                                             <MAX>4294967295</MAX>
                                             <MIN>2</MIN>
                                          </ECUC-INTEGER-PARAM-DEF>
                                          <!-- PARAMETER DEFINITION: ComFilterX -->
                                          <ECUC-INTEGER-PARAM-DEF UUID="ECUC:bfd4f837-ab5f-d1f8-aa48-97c8a5479380">
                                             <SHORT-NAME>ComFilterX</SHORT-NAME>
                                             <DESC>
                                                <L-2 L="EN">The name of this attribute corresponds to the parameter name in the [17] specification of Reception Filtering.</L-2>
                                             </DESC>
                                             <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_Com_00147</RELATED-TRACE-ITEM-REF>
                                             <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                             <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
