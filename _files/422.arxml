                                          <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:63cf01ce-91f9-4153-816e-f9bfd840a359">
                                             <SHORT-NAME>FrNmRxPdu</SHORT-NAME>
                                             <DESC>
                                                <L-2 L="EN">This container describes the FlexRay NM RX PDU:s.</L-2>
                                             </DESC>
