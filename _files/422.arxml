                                             <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                             <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                             <PARAMETERS>
                                                <!-- PARAMETER DEFINITION: DbgASAbsoluteAddress -->
                                                <ECUC-INTEGER-PARAM-DEF UUID="ECUC:f26ad0a2-2136-42e9-b018-a84e99287fac">
                                                   <SHORT-NAME>DbgASAbsoluteAddress</SHORT-NAME>
                                                   <DESC>
                                                      <L-2 L="EN">Absolute address of memory location to be debugged.</L-2>
                                                   </DESC>
                                                   <INTRODUCTION>
                                                      <P>
                                                         <L-1 L="EN">max = (2**32)-1</L-1>
                                                      </P>
                                                   </INTRODUCTION>
                                                   <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_Dbg_00800</RELATED-TRACE-ITEM-REF>
                                                   <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                                   <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                                   <SCOPE>LOCAL</SCOPE>
