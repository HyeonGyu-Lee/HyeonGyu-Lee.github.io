                  <!-- Module Definition: Xcp -->
                  <ECUC-MODULE-DEF UUID="ECUC:922942fb-6d0c-448b-b576-27276fbb1677">
                     <SHORT-NAME>Xcp</SHORT-NAME>
                     <DESC>
                        <L-2 L="EN">Configuration of the XCP module</L-2>
                     </DESC>
                     <ADMIN-DATA>
                        <DOC-REVISIONS>
                           <DOC-REVISION>
                              <REVISION-LABEL>4.2.2</REVISION-LABEL>
