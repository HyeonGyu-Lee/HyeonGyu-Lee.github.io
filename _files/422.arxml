                              <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:10243c44-9d06-4db8-a9d1-c5e5fe09133b">
                                 <SHORT-NAME>CanSMTxOfflineActiveSupport</SHORT-NAME>
                                 <DESC>
                                    <L-2 L="EN">Determines whether the ECU passive feature is supported by CanSM.</L-2>
                                 </DESC>
                                 <INTRODUCTION>
                                    <P>
                                       <L-1 L="EN">True: Enabled 
                                        False: Disabled</L-1>
