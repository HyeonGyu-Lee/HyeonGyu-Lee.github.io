                              </ECUC-INTEGER-PARAM-DEF>
                              <!-- PARAMETER DEFINITION: ComUserCbkHeaderFile -->
                              <ECUC-STRING-PARAM-DEF UUID="ECUC:91b95a6a-0103-41a5-a50b-4ec526119bb2">
                                 <SHORT-NAME>ComUserCbkHeaderFile</SHORT-NAME>
                                 <DESC>
                                    <L-2 L="EN">Defines the header files for callback functions which shall be included by the COM module.</L-2>
                                 </DESC>
