                              </ECUC-PARAM-CONF-CONTAINER-DEF>
                           </SUB-CONTAINERS>
                        </ECUC-PARAM-CONF-CONTAINER-DEF>
                        <!-- Container Definition: CanTSynGlobalTimeDomain -->
                        <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:e4a9aecb-0fe0-4597-9f3b-8f156d9ac964">
                           <SHORT-NAME>CanTSynGlobalTimeDomain</SHORT-NAME>
                           <DESC>
                              <L-2 L="EN">This represents the existence of a global time domain on CAN. The CanTSyn module can administrate several global time domains at the same time that in itself form a hierarchy of domains and sub-domains.</L-2>
                           </DESC>
                           <INTRODUCTION>
                              <P>
                                 <L-1 L="EN">If the CanTSyn exists it is assumed that at least one global time domain exists.</L-1>
                              </P>
                           </INTRODUCTION>
                           <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_CanTSyn_00004</RELATED-TRACE-ITEM-REF>
                           <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                           <UPPER-MULTIPLICITY-INFINITE>true</UPPER-MULTIPLICITY-INFINITE>
                           <PARAMETERS>
                              <!-- PARAMETER DEFINITION: CanTSynGlobalTimeDomainId -->
                              <ECUC-INTEGER-PARAM-DEF UUID="ECUC:f6ad8a08-a1be-4d15-9351-d5c855dd5461">
                                 <SHORT-NAME>CanTSynGlobalTimeDomainId</SHORT-NAME>
                                 <DESC>
                                    <L-2 L="EN">The global time domain ID.</L-2>
                                 </DESC>
                                 <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_CanTSyn_00005</RELATED-TRACE-ITEM-REF>
                                 <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                 <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                 <SCOPE>LOCAL</SCOPE>
                                 <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                 <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                 <VALUE-CONFIG-CLASSES>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                       <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                       <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                       <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                       <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                 </VALUE-CONFIG-CLASSES>
                                 <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                 <MAX>31</MAX>
                                 <MIN>0</MIN>
                              </ECUC-INTEGER-PARAM-DEF>
                              <!-- PARAMETER DEFINITION: CanTSynGlobalTimeFollowUpTimeout -->
                              <ECUC-FLOAT-PARAM-DEF UUID="ECUC:0d5073b6-c81e-4f08-9fb7-4638128c5801">
                                 <SHORT-NAME>CanTSynGlobalTimeFollowUpTimeout</SHORT-NAME>
                                 <DESC>
                                    <L-2 L="EN">Rx timeout for the follow-up message. This is only relevant for selected bus systems Unit:seconds</L-2>
                                 </DESC>
                                 <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_CanTSyn_00006</RELATED-TRACE-ITEM-REF>
                                 <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                 <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                 <SCOPE>LOCAL</SCOPE>
                                 <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                 <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                 <VALUE-CONFIG-CLASSES>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                       <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                       <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                       <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                       <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                 </VALUE-CONFIG-CLASSES>
                                 <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                 <MAX>Inf</MAX>
                                 <MIN>0</MIN>
                              </ECUC-FLOAT-PARAM-DEF>
                              <!-- PARAMETER DEFINITION: CanTSynGlobalTimeSequenceCounterJumpWidth -->
                              <ECUC-INTEGER-PARAM-DEF UUID="ECUC:e77f7729-6186-4ac0-9020-5d883541ea54">
                                 <SHORT-NAME>CanTSynGlobalTimeSequenceCounterJumpWidth</SHORT-NAME>
                                 <DESC>
                                    <L-2 L="EN">The SequenceCounterJumpWidth specifies the maximum allowed gap of the Sequence Counter between two SYNC resp. two OFS messages.</L-2>
                                 </DESC>
                                 <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_CanTSyn_00011</RELATED-TRACE-ITEM-REF>
                                 <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                 <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                 <SCOPE>LOCAL</SCOPE>
                                 <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                 <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                 <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                 <MAX>15</MAX>
                                 <MIN>1</MIN>
                              </ECUC-INTEGER-PARAM-DEF>
                           </PARAMETERS>
                           <REFERENCES>
                              <!-- Symbolic Name Reference Definition: CanTSynSynchronizedTimeBaseRef -->
                              <ECUC-SYMBOLIC-NAME-REFERENCE-DEF UUID="ECUC:5edfeb0d-45c7-42d0-8089-f0a608cbeeed">
                                 <SHORT-NAME>CanTSynSynchronizedTimeBaseRef</SHORT-NAME>
                                 <DESC>
                                    <L-2 L="EN">Mandatory reference to the required synchronized time-base.</L-2>
                                 </DESC>
                                 <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_CanTSyn_00022</RELATED-TRACE-ITEM-REF>
                                 <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                 <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                 <SCOPE>LOCAL</SCOPE>
                                 <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                 <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                 <VALUE-CONFIG-CLASSES>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                       <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                       <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                       <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                       <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                 </VALUE-CONFIG-CLASSES>
                                 <DESTINATION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/AUTOSAR/EcucDefs/StbM/StbMSynchronizedTimeBase</DESTINATION-REF>
                              </ECUC-SYMBOLIC-NAME-REFERENCE-DEF>
                           </REFERENCES>
                           <SUB-CONTAINERS>
                              <!-- Container Definition: CanTSynGlobalTimeMaster -->
                              <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:cff9a851-6d70-4e41-a02c-77f9b7a76422">
                                 <SHORT-NAME>CanTSynGlobalTimeMaster</SHORT-NAME>
                                 <DESC>
                                    <L-2 L="EN">Configuration of the global time master. Each global time domain is required to have exactly one global time master. This master may or may not exist on the configured ECU.</L-2>
                                 </DESC>
                                 <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_CanTSyn_00007</RELATED-TRACE-ITEM-REF>
                                 <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                 <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                 <PARAMETERS>
                                    <!-- PARAMETER DEFINITION: CanTSynGlobalTimeTxCrcSecured -->
                                    <ECUC-ENUMERATION-PARAM-DEF UUID="ECUC:688ff3f8-829d-4ffe-a058-d39f4094eb3b">
                                       <SHORT-NAME>CanTSynGlobalTimeTxCrcSecured</SHORT-NAME>
                                       <DESC>
                                          <L-2 L="EN">This represents the configuration of whether or not CRC is supported.</L-2>
                                       </DESC>
                                       <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_CanTSyn_00015</RELATED-TRACE-ITEM-REF>
                                       <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                       <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                       <SCOPE>LOCAL</SCOPE>
                                       <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                       <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                       <VALUE-CONFIG-CLASSES>
                                          <ECUC-VALUE-CONFIGURATION-CLASS>
                                             <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                             <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                          </ECUC-VALUE-CONFIGURATION-CLASS>
                                          <ECUC-VALUE-CONFIGURATION-CLASS>
                                             <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                             <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                          </ECUC-VALUE-CONFIGURATION-CLASS>
                                       </VALUE-CONFIG-CLASSES>
                                       <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                       <LITERALS>
                                          <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:e12b6a1a-20be-ea48-dda8-490ee70eb1ff">
                                             <SHORT-NAME>CRC_NOT_SUPPORTED</SHORT-NAME>
                                             <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                          </ECUC-ENUMERATION-LITERAL-DEF>
                                          <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:c50d57f1-a223-ecb5-c578-d36a6c40f904">
                                             <SHORT-NAME>CRC_SUPPORTED</SHORT-NAME>
                                             <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                          </ECUC-ENUMERATION-LITERAL-DEF>
                                       </LITERALS>
                                    </ECUC-ENUMERATION-PARAM-DEF>
                                    <!-- PARAMETER DEFINITION: CanTSynGlobalTimeTxFollowUpOffset -->
                                    <ECUC-FLOAT-PARAM-DEF UUID="ECUC:0db52eec-d8d2-46fb-8fab-ec8a161c3c6c">
                                       <SHORT-NAME>CanTSynGlobalTimeTxFollowUpOffset</SHORT-NAME>
                                       <DESC>
                                          <L-2 L="EN">This represents the transmission time offset between a SYNC message and the related FUP message resp. OFS message and related OFNS message. Unit: seconds.</L-2>
                                       </DESC>
                                       <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_CanTSyn_00016</RELATED-TRACE-ITEM-REF>
                                       <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                       <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                       <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                       <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                       <VALUE-CONFIG-CLASSES>
                                          <ECUC-VALUE-CONFIGURATION-CLASS>
                                             <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                             <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                          </ECUC-VALUE-CONFIGURATION-CLASS>
                                          <ECUC-VALUE-CONFIGURATION-CLASS>
                                             <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                             <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                          </ECUC-VALUE-CONFIGURATION-CLASS>
                                       </VALUE-CONFIG-CLASSES>
                                       <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                       <MAX>Inf</MAX>
                                       <MIN>0</MIN>
                                    </ECUC-FLOAT-PARAM-DEF>
                                    <!-- PARAMETER DEFINITION: CanTSynGlobalTimeTxPeriod -->
                                    <ECUC-FLOAT-PARAM-DEF UUID="ECUC:6f787960-e6d3-4cd8-9be0-b8b8f1cfd6fa">
                                       <SHORT-NAME>CanTSynGlobalTimeTxPeriod</SHORT-NAME>
                                       <DESC>
                                          <L-2 L="EN">This represents configuration of the TX period. Unit: seconds</L-2>
                                       </DESC>
                                       <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_CanTSyn_00017</RELATED-TRACE-ITEM-REF>
                                       <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                       <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                       <SCOPE>LOCAL</SCOPE>
                                       <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                       <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                       <VALUE-CONFIG-CLASSES>
                                          <ECUC-VALUE-CONFIGURATION-CLASS>
                                             <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                             <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                          </ECUC-VALUE-CONFIGURATION-CLASS>
                                          <ECUC-VALUE-CONFIGURATION-CLASS>
                                             <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                             <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                          </ECUC-VALUE-CONFIGURATION-CLASS>
                                       </VALUE-CONFIG-CLASSES>
                                       <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                       <MAX>Inf</MAX>
                                       <MIN>0</MIN>
                                    </ECUC-FLOAT-PARAM-DEF>
                                    <!-- PARAMETER DEFINITION: CanTSynMasterConfirmationTimeout -->
                                    <ECUC-FLOAT-PARAM-DEF UUID="ECUC:5134b771-783b-49e8-aa30-7b1c92f56e2a">
                                       <SHORT-NAME>CanTSynMasterConfirmationTimeout</SHORT-NAME>
                                       <DESC>
                                          <L-2 L="EN">This represents the confirmation timeout after transmission of a SYNC message resp. OFS message. Unit: seconds.</L-2>
                                       </DESC>
                                       <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_CanTSyn_00020</RELATED-TRACE-ITEM-REF>
                                       <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                       <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                       <SCOPE>LOCAL</SCOPE>
                                       <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                       <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                       <VALUE-CONFIG-CLASSES>
                                          <ECUC-VALUE-CONFIGURATION-CLASS>
                                             <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                             <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                          </ECUC-VALUE-CONFIGURATION-CLASS>
                                          <ECUC-VALUE-CONFIGURATION-CLASS>
                                             <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                             <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                          </ECUC-VALUE-CONFIGURATION-CLASS>
                                       </VALUE-CONFIG-CLASSES>
                                       <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                       <MAX>Inf</MAX>
                                       <MIN>0</MIN>
                                    </ECUC-FLOAT-PARAM-DEF>
                                 </PARAMETERS>
                                 <SUB-CONTAINERS>
                                    <!-- Container Definition: CanTSynGlobalTimeMasterPdu -->
                                    <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:d5318374-9ff0-4dea-abdf-12e25c4fc4fd">
                                       <SHORT-NAME>CanTSynGlobalTimeMasterPdu</SHORT-NAME>
                                       <DESC>
                                          <L-2 L="EN">This container encloses the configuration of the PDU that is supposed to contain the global time information.</L-2>
                                       </DESC>
                                       <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_CanTSyn_00009</RELATED-TRACE-ITEM-REF>
                                       <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                       <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                       <PARAMETERS>
                                          <!-- PARAMETER DEFINITION: CanTSynGlobalTimeMasterConfirmationHandleId -->
                                          <ECUC-INTEGER-PARAM-DEF UUID="ECUC:19d98c8e-3bc0-4332-9f2f-53900e56fa17">
                                             <SHORT-NAME>CanTSynGlobalTimeMasterConfirmationHandleId</SHORT-NAME>
                                             <DESC>
                                                <L-2 L="EN">This represents the handle ID of the PDU that contains the global time information.</L-2>
                                             </DESC>
                                             <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_CanTSyn_00008</RELATED-TRACE-ITEM-REF>
                                             <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                             <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                             <SCOPE>LOCAL</SCOPE>
                                             <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                             <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                             <VALUE-CONFIG-CLASSES>
                                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                             </VALUE-CONFIG-CLASSES>
                                             <SYMBOLIC-NAME-VALUE>true</SYMBOLIC-NAME-VALUE>
                                             <MAX>65535</MAX>
                                             <MIN>0</MIN>
                                          </ECUC-INTEGER-PARAM-DEF>
                                       </PARAMETERS>
                                       <REFERENCES>
                                          <!-- Reference Definition: CanTSynGlobalTimePduRef -->
                                          <ECUC-REFERENCE-DEF UUID="ECUC:6847e4d6-07d1-953f-4c6a-eb3652785f28">
                                             <SHORT-NAME>CanTSynGlobalTimePduRef</SHORT-NAME>
                                             <DESC>
                                                <L-2 L="EN">This represents the reference to the Pdu taken to transmit the global time information. The global time master of a global time domain acts as the sender of the Pdu while all the time slaves are supposed to receive the Pdu.</L-2>
                                             </DESC>
                                             <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_CanTSyn_00027</RELATED-TRACE-ITEM-REF>
                                             <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                             <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                             <SCOPE>LOCAL</SCOPE>
                                             <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                             <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                                             <VALUE-CONFIG-CLASSES>
                                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                             </VALUE-CONFIG-CLASSES>
                                             <DESTINATION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/AUTOSAR/EcucDefs/EcuC/EcucConfigSet/EcucPduCollection/Pdu</DESTINATION-REF>
                                          </ECUC-REFERENCE-DEF>
                                       </REFERENCES>
                                    </ECUC-PARAM-CONF-CONTAINER-DEF>
                                 </SUB-CONTAINERS>
                              </ECUC-PARAM-CONF-CONTAINER-DEF>
                              <!-- Container Definition: CanTSynGlobalTimeSlave -->
                              <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:453b6e91-cb63-4fdc-b77d-2204844ed77a">
                                 <SHORT-NAME>CanTSynGlobalTimeSlave</SHORT-NAME>
                                 <DESC>
                                    <L-2 L="EN">Configuration of a global time slave. Each global time domain is required to have at least one time slave. The configured ECU may or may not represent a time slave.</L-2>
                                 </DESC>
                                 <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_CanTSyn_00012</RELATED-TRACE-ITEM-REF>
                                 <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                 <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                 <PARAMETERS>
                                    <!-- PARAMETER DEFINITION: CanTSynRxCrcValidated -->
                                    <ECUC-ENUMERATION-PARAM-DEF UUID="ECUC:7784397b-19ae-463b-a28c-5e41dba352aa">
                                       <SHORT-NAME>CanTSynRxCrcValidated</SHORT-NAME>
                                       <DESC>
                                          <L-2 L="EN">Definition of whether or not validation of the CRC is supported.</L-2>
                                       </DESC>
                                       <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_CanTSyn_00021</RELATED-TRACE-ITEM-REF>
                                       <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                       <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                       <SCOPE>LOCAL</SCOPE>
                                       <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                       <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                       <VALUE-CONFIG-CLASSES>
                                          <ECUC-VALUE-CONFIGURATION-CLASS>
                                             <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                             <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                          </ECUC-VALUE-CONFIGURATION-CLASS>
                                          <ECUC-VALUE-CONFIGURATION-CLASS>
                                             <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                             <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                          </ECUC-VALUE-CONFIGURATION-CLASS>
                                       </VALUE-CONFIG-CLASSES>
                                       <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                       <LITERALS>
                                          <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:163d77eb-69bf-d88b-13b9-ff4d0713f105">
                                             <SHORT-NAME>CRC_IGNORED</SHORT-NAME>
                                             <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                          </ECUC-ENUMERATION-LITERAL-DEF>
                                          <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:54dbe24c-c7f1-dd3b-e361-ea7bbc897d5b">
                                             <SHORT-NAME>CRC_NOT_VALIDATED</SHORT-NAME>
                                             <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                          </ECUC-ENUMERATION-LITERAL-DEF>
                                          <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:41234a8d-1706-e2fc-de33-607ec8553b0c">
                                             <SHORT-NAME>CRC_VALIDATED</SHORT-NAME>
                                             <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                          </ECUC-ENUMERATION-LITERAL-DEF>
                                       </LITERALS>
                                    </ECUC-ENUMERATION-PARAM-DEF>
                                 </PARAMETERS>
                                 <SUB-CONTAINERS>
                                    <!-- Container Definition: CanTSynGlobalTimeSlavePdu -->
                                    <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:98a5703c-de7c-4eab-80aa-8f4df6f3eb46">
                                       <SHORT-NAME>CanTSynGlobalTimeSlavePdu</SHORT-NAME>
                                       <DESC>
                                          <L-2 L="EN">This container encloses the configuration of the PDU that is supposed to contain the global time information.</L-2>
                                       </DESC>
                                       <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_CanTSyn_00014</RELATED-TRACE-ITEM-REF>
                                       <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                       <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                       <PARAMETERS>
                                          <!-- PARAMETER DEFINITION: CanTSynGlobalTimeSlaveHandleId -->
                                          <ECUC-INTEGER-PARAM-DEF UUID="ECUC:f7af8e82-c061-4415-9619-25e5c1bccf67">
                                             <SHORT-NAME>CanTSynGlobalTimeSlaveHandleId</SHORT-NAME>
                                             <DESC>
                                                <L-2 L="EN">This represents the handle ID of the PDU that contains the global time information.</L-2>
                                             </DESC>
                                             <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_CanTSyn_00013</RELATED-TRACE-ITEM-REF>
                                             <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                             <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                             <SCOPE>LOCAL</SCOPE>
                                             <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                             <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                             <VALUE-CONFIG-CLASSES>
                                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                             </VALUE-CONFIG-CLASSES>
                                             <SYMBOLIC-NAME-VALUE>true</SYMBOLIC-NAME-VALUE>
                                             <MAX>65535</MAX>
                                             <MIN>0</MIN>
                                          </ECUC-INTEGER-PARAM-DEF>
                                       </PARAMETERS>
                                       <REFERENCES>
                                          <!-- Reference Definition: CanTSynGlobalTimePduRef -->
                                          <ECUC-REFERENCE-DEF UUID="ECUC:2bbbd19e-465d-9600-2136-67a1ed1c8571">
                                             <SHORT-NAME>CanTSynGlobalTimePduRef</SHORT-NAME>
                                             <DESC>
                                                <L-2 L="EN">This represents the reference to the Pdu taken to transmit the global time information. The global time master of a global time domain acts as the sender of the Pdu while all the time slaves are supposed to receive the Pdu.</L-2>
                                             </DESC>
                                             <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_CanTSyn_00040</RELATED-TRACE-ITEM-REF>
                                             <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                             <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                             <SCOPE>LOCAL</SCOPE>
                                             <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                             <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                                             <VALUE-CONFIG-CLASSES>
                                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                             </VALUE-CONFIG-CLASSES>
                                             <DESTINATION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/AUTOSAR/EcucDefs/EcuC/EcucConfigSet/EcucPduCollection/Pdu</DESTINATION-REF>
                                          </ECUC-REFERENCE-DEF>
                                       </REFERENCES>
                                    </ECUC-PARAM-CONF-CONTAINER-DEF>
                                 </SUB-CONTAINERS>
                              </ECUC-PARAM-CONF-CONTAINER-DEF>
                           </SUB-CONTAINERS>
                        </ECUC-PARAM-CONF-CONTAINER-DEF>
                     </CONTAINERS>
                  </ECUC-MODULE-DEF>
                  <!-- Module Definition: CanTp -->
                  <ECUC-MODULE-DEF UUID="ECUC:ba6a8f4a-27d6-4452-8bd6-331300657557">
                     <SHORT-NAME>CanTp</SHORT-NAME>
                     <DESC>
                        <L-2 L="EN">Configuration of the CanTp (CAN Transport Protocol) module.</L-2>
                     </DESC>
                     <ADMIN-DATA>
                        <DOC-REVISIONS>
                           <DOC-REVISION>
                              <REVISION-LABEL>4.2.2</REVISION-LABEL>
                              <ISSUED-BY>AUTOSAR</ISSUED-BY>
                              <DATE>2014-10-31</DATE>
                           </DOC-REVISION>
                        </DOC-REVISIONS>
                     </ADMIN-DATA>
                     <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                     <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                     <POST-BUILD-VARIANT-SUPPORT>true</POST-BUILD-VARIANT-SUPPORT>
                     <SUPPORTED-CONFIG-VARIANTS>
                        <SUPPORTED-CONFIG-VARIANT>VARIANT-POST-BUILD</SUPPORTED-CONFIG-VARIANT>
                        <SUPPORTED-CONFIG-VARIANT>VARIANT-PRE-COMPILE</SUPPORTED-CONFIG-VARIANT>
                     </SUPPORTED-CONFIG-VARIANTS>
                     <CONTAINERS>
                        <!-- Container Definition: CanTpConfig -->
                        <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:bda25515-3634-4597-9be2-8d5d1405d9e7">
                           <SHORT-NAME>CanTpConfig</SHORT-NAME>
                           <DESC>
                              <L-2 L="EN">This container contains the configuration parameters and sub containers of the AUTOSAR CanTp module.</L-2>
                           </DESC>
                           <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_CanTp_00290</RELATED-TRACE-ITEM-REF>
                           <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                           <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                           <PARAMETERS>
                              <!-- PARAMETER DEFINITION: CanTpMainFunctionPeriod -->
                              <ECUC-FLOAT-PARAM-DEF UUID="ECUC:9411ad02-2e5e-499f-b474-41daf0a62d3b">
                                 <SHORT-NAME>CanTpMainFunctionPeriod</SHORT-NAME>
                                 <DESC>
                                    <L-2 L="EN">Allow to configure the time for the MainFunction (as float in seconds). The CanTpMainFunctionPeriod should be assigned a value which is optimal regarding all of the timers configured for CanTp in TX and RX data transfer i.e. the differences from the configured timing should be as small as possible. Please note: This period shall be the same as call cycle time of the periodic task were CanTp Main function is called.</L-2>
                                 </DESC>
                                 <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_CanTp_00240</RELATED-TRACE-ITEM-REF>
                                 <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                 <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                 <SCOPE>ECU</SCOPE>
                                 <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                 <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                 <VALUE-CONFIG-CLASSES>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                       <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                       <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                       <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                       <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                 </VALUE-CONFIG-CLASSES>
                                 <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                 <MAX>0.255</MAX>
                                 <MIN>0</MIN>
                              </ECUC-FLOAT-PARAM-DEF>
                              <!-- PARAMETER DEFINITION: CanTpMaxChannelCnt -->
                              <ECUC-INTEGER-PARAM-DEF UUID="ECUC:74647c97-e7ac-436c-8e50-b2de15695902">
                                 <SHORT-NAME>CanTpMaxChannelCnt</SHORT-NAME>
                                 <DESC>
                                    <L-2 L="EN">Maximum number of channels. This parameter is needed only in case of post-build loadable implementation using static memory allocation.</L-2>
                                 </DESC>
                                 <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_CanTp_00304</RELATED-TRACE-ITEM-REF>
                                 <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                 <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                 <SCOPE>LOCAL</SCOPE>
                                 <MULTIPLICITY-CONFIG-CLASSES>
                                    <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                       <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                       <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                    </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                    <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                       <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                       <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                 </MULTIPLICITY-CONFIG-CLASSES>
                                 <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                 <POST-BUILD-VARIANT-MULTIPLICITY>false</POST-BUILD-VARIANT-MULTIPLICITY>
                                 <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                 <VALUE-CONFIG-CLASSES>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                       <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                       <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                       <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                       <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                 </VALUE-CONFIG-CLASSES>
                                 <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                 <MAX>18446744073709551615</MAX>
                                 <MIN>0</MIN>
                              </ECUC-INTEGER-PARAM-DEF>
                           </PARAMETERS>
                           <SUB-CONTAINERS>
                              <!-- Container Definition: CanTpChannel -->
                              <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:755e5d1d-0639-40a4-aed2-3e537d79362a">
                                 <SHORT-NAME>CanTpChannel</SHORT-NAME>
                                 <DESC>
                                    <L-2 L="EN">This container contains the configuration parameters of the CanTp channel.</L-2>
                                 </DESC>
                                 <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_CanTp_00288</RELATED-TRACE-ITEM-REF>
                                 <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                 <UPPER-MULTIPLICITY-INFINITE>true</UPPER-MULTIPLICITY-INFINITE>
                                 <MULTIPLICITY-CONFIG-CLASSES>
                                    <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                       <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                       <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                    </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                    <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                       <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                       <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                 </MULTIPLICITY-CONFIG-CLASSES>
                                 <POST-BUILD-VARIANT-MULTIPLICITY>true</POST-BUILD-VARIANT-MULTIPLICITY>
                                 <PARAMETERS>
                                    <!-- PARAMETER DEFINITION: CanTpChannelMode -->
                                    <ECUC-ENUMERATION-PARAM-DEF UUID="ECUC:6a4ebc88-1ecd-4bf2-b3e5-7fa3000a974b">
                                       <SHORT-NAME>CanTpChannelMode</SHORT-NAME>
                                       <DESC>
                                          <L-2 L="EN">The CAN Transport Layer supports half and full duplex channel modes.</L-2>
                                       </DESC>
                                       <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_CanTp_00289</RELATED-TRACE-ITEM-REF>
                                       <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                       <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                       <SCOPE>LOCAL</SCOPE>
                                       <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                       <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                       <VALUE-CONFIG-CLASSES>
                                          <ECUC-VALUE-CONFIGURATION-CLASS>
                                             <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                             <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                          </ECUC-VALUE-CONFIGURATION-CLASS>
                                          <ECUC-VALUE-CONFIGURATION-CLASS>
                                             <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                             <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                          </ECUC-VALUE-CONFIGURATION-CLASS>
                                       </VALUE-CONFIG-CLASSES>
                                       <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                       <LITERALS>
                                          <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:c631b911-1d9d-8f02-5800-08e9845fd3c5">
                                             <SHORT-NAME>CANTP_MODE_FULL_DUPLEX</SHORT-NAME>
                                             <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                          </ECUC-ENUMERATION-LITERAL-DEF>
                                          <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:e518e292-4275-8543-6a1c-226c462273d4">
                                             <SHORT-NAME>CANTP_MODE_HALF_DUPLEX</SHORT-NAME>
                                             <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                          </ECUC-ENUMERATION-LITERAL-DEF>
                                       </LITERALS>
                                    </ECUC-ENUMERATION-PARAM-DEF>
                                 </PARAMETERS>
                                 <SUB-CONTAINERS>
                                    <!-- Container Definition: CanTpRxNSdu -->
                                    <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:252c3693-8f61-4fdb-bc0f-defd6a327590">
                                       <SHORT-NAME>CanTpRxNSdu</SHORT-NAME>
                                       <DESC>
                                          <L-2 L="EN">The following parameters needs to be configured for each CAN N-SDU that the CanTp module receives via the CanTpChannel.</L-2>
                                       </DESC>
                                       <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_CanTp_00137</RELATED-TRACE-ITEM-REF>
                                       <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                       <UPPER-MULTIPLICITY-INFINITE>true</UPPER-MULTIPLICITY-INFINITE>
                                       <MULTIPLICITY-CONFIG-CLASSES>
                                          <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                             <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                             <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                          </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                          <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                             <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                             <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                          </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                       </MULTIPLICITY-CONFIG-CLASSES>
                                       <POST-BUILD-VARIANT-MULTIPLICITY>true</POST-BUILD-VARIANT-MULTIPLICITY>
                                       <PARAMETERS>
                                          <!-- PARAMETER DEFINITION: CanTpBs -->
                                          <ECUC-INTEGER-PARAM-DEF UUID="ECUC:9e272594-cfed-4b05-acf4-140870cfaf98">
                                             <SHORT-NAME>CanTpBs</SHORT-NAME>
                                             <DESC>
                                                <L-2 L="EN">Sets the number of N-PDUs the CanTp receiver allows the sender to send, before waiting for an authorization to continue transmission of the following N-PDUs.For further details on this parameter value see ISO 15765-2 specification.</L-2>
                                             </DESC>
                                             <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_CanTp_00276</RELATED-TRACE-ITEM-REF>
                                             <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                             <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                             <SCOPE>LOCAL</SCOPE>
                                             <MULTIPLICITY-CONFIG-CLASSES>
                                                <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                                </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                                <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                                </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                             </MULTIPLICITY-CONFIG-CLASSES>
                                             <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                             <POST-BUILD-VARIANT-MULTIPLICITY>true</POST-BUILD-VARIANT-MULTIPLICITY>
                                             <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                                             <VALUE-CONFIG-CLASSES>
                                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                             </VALUE-CONFIG-CLASSES>
                                             <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                             <MAX>255</MAX>
                                             <MIN>0</MIN>
                                          </ECUC-INTEGER-PARAM-DEF>
                                          <!-- PARAMETER DEFINITION: CanTpNar -->
                                          <ECUC-FLOAT-PARAM-DEF UUID="ECUC:7f55eb6a-9157-4409-b921-d055c6043c74">
                                             <SHORT-NAME>CanTpNar</SHORT-NAME>
                                             <DESC>
                                                <L-2 L="EN">Value in seconds of the N_Ar timeout. N_Ar is the time for transmission of a CAN frame (any N_PDU) on the receiver side.</L-2>
                                             </DESC>
                                             <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_CanTp_00277</RELATED-TRACE-ITEM-REF>
                                             <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                             <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                             <SCOPE>LOCAL</SCOPE>
                                             <MULTIPLICITY-CONFIG-CLASSES>
                                                <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                                </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                                <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                                </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                             </MULTIPLICITY-CONFIG-CLASSES>
                                             <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                             <POST-BUILD-VARIANT-MULTIPLICITY>true</POST-BUILD-VARIANT-MULTIPLICITY>
                                             <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                                             <VALUE-CONFIG-CLASSES>
                                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                             </VALUE-CONFIG-CLASSES>
                                             <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                             <MAX>Inf</MAX>
                                             <MIN>0</MIN>
                                          </ECUC-FLOAT-PARAM-DEF>
                                          <!-- PARAMETER DEFINITION: CanTpNbr -->
                                          <ECUC-FLOAT-PARAM-DEF UUID="ECUC:52b014bc-5bc7-46ac-b56b-5451de79a28f">
                                             <SHORT-NAME>CanTpNbr</SHORT-NAME>
                                             <DESC>
                                                <L-2 L="EN">Value in seconds of the performance requirement for (N_Br + N_Ar). N_Br is the elapsed time between the receiving indication of a FF or CF or the transmit confirmation of a FC, until the transmit request of the next FC.</L-2>
                                             </DESC>
                                             <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_CanTp_00245</RELATED-TRACE-ITEM-REF>
                                             <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                             <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                             <SCOPE>LOCAL</SCOPE>
                                             <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                             <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                                             <VALUE-CONFIG-CLASSES>
                                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                             </VALUE-CONFIG-CLASSES>
                                             <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                             <MAX>Inf</MAX>
                                             <MIN>0</MIN>
                                          </ECUC-FLOAT-PARAM-DEF>
                                          <!-- PARAMETER DEFINITION: CanTpNcr -->
                                          <ECUC-FLOAT-PARAM-DEF UUID="ECUC:4d6b2bf7-3aa8-47aa-9d36-57087f5352fa">
                                             <SHORT-NAME>CanTpNcr</SHORT-NAME>
                                             <DESC>
                                                <L-2 L="EN">Value in seconds of the N_Cr timeout. N_Cr is the time until reception of the next Consecutive Frame N_PDU.</L-2>
                                             </DESC>
                                             <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_CanTp_00279</RELATED-TRACE-ITEM-REF>
                                             <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                             <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                             <SCOPE>LOCAL</SCOPE>
                                             <MULTIPLICITY-CONFIG-CLASSES>
                                                <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                                </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                                <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                                </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                             </MULTIPLICITY-CONFIG-CLASSES>
                                             <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                             <POST-BUILD-VARIANT-MULTIPLICITY>true</POST-BUILD-VARIANT-MULTIPLICITY>
                                             <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                                             <VALUE-CONFIG-CLASSES>
                                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                             </VALUE-CONFIG-CLASSES>
                                             <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                             <MAX>Inf</MAX>
                                             <MIN>0</MIN>
                                          </ECUC-FLOAT-PARAM-DEF>
                                          <!-- PARAMETER DEFINITION: CanTpRxAddressingFormat -->
                                          <ECUC-ENUMERATION-PARAM-DEF UUID="ECUC:fb78a30b-39a0-4018-8840-efb008c07a7c">
                                             <SHORT-NAME>CanTpRxAddressingFormat</SHORT-NAME>
                                             <DESC>
                                                <L-2 L="EN">Declares which communication addressing mode is supported for this RxNSdu. Definition of Enumeration values:</L-2>
                                             </DESC>
                                             <INTRODUCTION>
                                                <P>
                                                   <L-1 L="EN">CanTpStandard to use normal addressing format. 
                                                        CanTpExtended to use extended addressing format. 
                                                        CanTpMixed to use mixed 11 bit addressing format.
                                                        CanTpNormalFixed to use normal fixed addressing format. 
                                                        CanTpMixed29Bit to use mixed 29 bit addressing format.</L-1>
                                                </P>
                                             </INTRODUCTION>
                                             <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_CanTp_00281</RELATED-TRACE-ITEM-REF>
                                             <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                             <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                             <SCOPE>LOCAL</SCOPE>
                                             <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                             <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                             <VALUE-CONFIG-CLASSES>
                                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                             </VALUE-CONFIG-CLASSES>
                                             <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                             <LITERALS>
                                                <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:82cfe502-1cb5-9c0c-7a46-bd45546df968">
                                                   <SHORT-NAME>CANTP_EXTENDED</SHORT-NAME>
                                                   <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                                </ECUC-ENUMERATION-LITERAL-DEF>
                                                <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:aa2c3136-a146-9457-48a2-53d36f8b99b5">
                                                   <SHORT-NAME>CANTP_MIXED</SHORT-NAME>
                                                   <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                                </ECUC-ENUMERATION-LITERAL-DEF>
                                                <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:b09b2513-e816-de44-dcfe-8167fabb9e32">
                                                   <SHORT-NAME>CANTP_MIXED29BIT</SHORT-NAME>
                                                   <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                                </ECUC-ENUMERATION-LITERAL-DEF>
                                                <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:346732c1-8a0e-d577-c696-ae4616a5a853">
                                                   <SHORT-NAME>CANTP_NORMALFIXED</SHORT-NAME>
                                                   <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                                </ECUC-ENUMERATION-LITERAL-DEF>
                                                <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:74cf0c0f-584e-91ae-5202-96ce52ed86fb">
                                                   <SHORT-NAME>CANTP_STANDARD</SHORT-NAME>
                                                   <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                                </ECUC-ENUMERATION-LITERAL-DEF>
                                             </LITERALS>
                                          </ECUC-ENUMERATION-PARAM-DEF>
                                          <!-- PARAMETER DEFINITION: CanTpRxNSduId -->
                                          <ECUC-INTEGER-PARAM-DEF UUID="ECUC:3a4bcfb0-4e57-4fac-a38a-2fe13b81ba11">
                                             <SHORT-NAME>CanTpRxNSduId</SHORT-NAME>
                                             <DESC>
                                                <L-2 L="EN">Unique identifier user by the upper layer to call CanTp_CancelReceive, CanTp_ChangeParameter and CanTp_ReadParameter.</L-2>
                                             </DESC>
                                             <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_CanTp_00301</RELATED-TRACE-ITEM-REF>
                                             <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                             <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                             <SCOPE>LOCAL</SCOPE>
                                             <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                             <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                             <VALUE-CONFIG-CLASSES>
                                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                             </VALUE-CONFIG-CLASSES>
                                             <SYMBOLIC-NAME-VALUE>true</SYMBOLIC-NAME-VALUE>
                                             <MAX>65535</MAX>
                                             <MIN>0</MIN>
                                          </ECUC-INTEGER-PARAM-DEF>
                                          <!-- PARAMETER DEFINITION: CanTpRxPaddingActivation -->
                                          <ECUC-ENUMERATION-PARAM-DEF UUID="ECUC:02a6f989-3eac-466e-b153-684542f925bc">
                                             <SHORT-NAME>CanTpRxPaddingActivation</SHORT-NAME>
                                             <DESC>
                                                <L-2 L="EN">Defines if the receive frame uses padding or not. This parameter is restricted to 8 byte N-PDUs.</L-2>
                                             </DESC>
                                             <INTRODUCTION>
                                                <P>
                                                   <L-1 L="EN">Definition of enumeration values:

                                                        CanTpOn:
                                                        The N-PDU received uses padding for SF, FC and the last CF. (N-PDU length is always &gt;= 8 bytes in case of CAN 2.0)

                                                        CanTpOff:
                                                        The N-PDU received does not use padding for SF, CF and the last CF. (N-PDU length is dynamic - any valid DLC value).
                                                        Note: The mandatory mapping to the next higher valid DLC value for N-PDUs with a length &gt; 8 bytes is not affected by this parameter.</L-1>
                                                </P>
                                             </INTRODUCTION>
                                             <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_CanTp_00249</RELATED-TRACE-ITEM-REF>
                                             <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                             <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                             <SCOPE>LOCAL</SCOPE>
                                             <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                             <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                                             <VALUE-CONFIG-CLASSES>
                                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                             </VALUE-CONFIG-CLASSES>
                                             <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                             <LITERALS>
                                                <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:399bd418-9da9-9f30-733f-4934e7bdcb0b">
                                                   <SHORT-NAME>CANTP_OFF</SHORT-NAME>
                                                   <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                                </ECUC-ENUMERATION-LITERAL-DEF>
                                                <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:d7229977-db35-95d0-4d3e-1273eb9f2026">
                                                   <SHORT-NAME>CANTP_ON</SHORT-NAME>
                                                   <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                                </ECUC-ENUMERATION-LITERAL-DEF>
                                             </LITERALS>
                                          </ECUC-ENUMERATION-PARAM-DEF>
                                          <!-- PARAMETER DEFINITION: CanTpRxTaType -->
                                          <ECUC-ENUMERATION-PARAM-DEF UUID="ECUC:f1a0d9e6-3b2c-4a26-bcd2-356d1f5798b5">
                                             <SHORT-NAME>CanTpRxTaType</SHORT-NAME>
                                             <DESC>
                                                <L-2 L="EN">Declares the communication type of this Rx N-SDU.</L-2>
                                             </DESC>
                                             <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_CanTp_00250</RELATED-TRACE-ITEM-REF>
                                             <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                             <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                             <SCOPE>LOCAL</SCOPE>
                                             <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                             <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                             <VALUE-CONFIG-CLASSES>
                                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                             </VALUE-CONFIG-CLASSES>
                                             <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                             <LITERALS>
                                                <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:b81fb04d-a057-9be2-63af-2b0bf8b71bc4">
                                                   <SHORT-NAME>CANTP_CANFD_FUNCTIONAL</SHORT-NAME>
                                                   <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                                </ECUC-ENUMERATION-LITERAL-DEF>
                                                <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:6028660c-da59-92ac-3d50-e57b2564f978">
                                                   <SHORT-NAME>CANTP_CANFD_PHYSICAL</SHORT-NAME>
                                                   <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                                </ECUC-ENUMERATION-LITERAL-DEF>
                                                <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:5b8d6050-0591-9596-5cd2-d8f571d0a5b7">
                                                   <SHORT-NAME>CANTP_FUNCTIONAL</SHORT-NAME>
                                                   <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                                </ECUC-ENUMERATION-LITERAL-DEF>
                                                <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:3082004f-968c-9c64-3c25-9b1fa9bd719a">
                                                   <SHORT-NAME>CANTP_PHYSICAL</SHORT-NAME>
                                                   <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                                </ECUC-ENUMERATION-LITERAL-DEF>
                                             </LITERALS>
                                          </ECUC-ENUMERATION-PARAM-DEF>
                                          <!-- PARAMETER DEFINITION: CanTpRxWftMax -->
                                          <ECUC-INTEGER-PARAM-DEF UUID="ECUC:690b3798-af94-47b2-bb18-c3c5dea0b89c">
                                             <SHORT-NAME>CanTpRxWftMax</SHORT-NAME>
                                             <DESC>
                                                <L-2 L="EN">This parameter indicates how many Flow Control wait N-PDUs can be consecutively transmitted by the receiver. It is local to the node and is not transmitted inside the FC protocol data unit.</L-2>
                                             </DESC>
                                             <INTRODUCTION>
                                                <P>
                                                   <L-1 L="EN">CanTpRxWftMax is used to avoid sender nodes being potentially hooked-up in case of a temporarily reception inability on the part of the receiver nodes, whereby the sender could be waiting continuously.</L-1>
                                                </P>
                                             </INTRODUCTION>
                                             <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_CanTp_00251</RELATED-TRACE-ITEM-REF>
                                             <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                             <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                             <SCOPE>LOCAL</SCOPE>
                                             <MULTIPLICITY-CONFIG-CLASSES>
                                                <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                                </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                                <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                                </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                             </MULTIPLICITY-CONFIG-CLASSES>
                                             <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                             <POST-BUILD-VARIANT-MULTIPLICITY>true</POST-BUILD-VARIANT-MULTIPLICITY>
                                             <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                                             <VALUE-CONFIG-CLASSES>
                                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                             </VALUE-CONFIG-CLASSES>
                                             <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                             <MAX>65535</MAX>
                                             <MIN>0</MIN>
                                          </ECUC-INTEGER-PARAM-DEF>
                                          <!-- PARAMETER DEFINITION: CanTpSTmin -->
                                          <ECUC-FLOAT-PARAM-DEF UUID="ECUC:d6287381-1914-4ab1-8da6-3ba8d004928b">
                                             <SHORT-NAME>CanTpSTmin</SHORT-NAME>
                                             <DESC>
                                                <L-2 L="EN">Sets the duration of the minimum time the CanTp sender shall wait between the transmissions of two CF N-PDUs.</L-2>
                                             </DESC>
                                             <INTRODUCTION>
                                                <P>
                                                   <L-1 L="EN">For further details on this parameter value see ISO 15765-2 specification.</L-1>
                                                </P>
                                             </INTRODUCTION>
                                             <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_CanTp_00252</RELATED-TRACE-ITEM-REF>
                                             <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                             <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                             <SCOPE>LOCAL</SCOPE>
                                             <MULTIPLICITY-CONFIG-CLASSES>
                                                <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                                </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                                <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                                </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                             </MULTIPLICITY-CONFIG-CLASSES>
                                             <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                             <POST-BUILD-VARIANT-MULTIPLICITY>true</POST-BUILD-VARIANT-MULTIPLICITY>
                                             <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                                             <VALUE-CONFIG-CLASSES>
                                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                             </VALUE-CONFIG-CLASSES>
                                             <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                             <MAX>Inf</MAX>
                                             <MIN>0</MIN>
                                          </ECUC-FLOAT-PARAM-DEF>
                                       </PARAMETERS>
                                       <REFERENCES>
                                          <!-- Reference Definition: CanTpRxNSduRef -->
                                          <ECUC-REFERENCE-DEF UUID="ECUC:6d3d5f1b-598b-4468-9e3d-46dadb685fb2">
                                             <SHORT-NAME>CanTpRxNSduRef</SHORT-NAME>
                                             <DESC>
                                                <L-2 L="EN">Reference to a Pdu in the COM-Stack.</L-2>
                                             </DESC>
                                             <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_CanTp_00241</RELATED-TRACE-ITEM-REF>
                                             <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                             <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                             <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                             <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                                             <VALUE-CONFIG-CLASSES>
                                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                             </VALUE-CONFIG-CLASSES>
                                             <DESTINATION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/AUTOSAR/EcucDefs/EcuC/EcucConfigSet/EcucPduCollection/Pdu</DESTINATION-REF>
                                          </ECUC-REFERENCE-DEF>
                                       </REFERENCES>
                                       <SUB-CONTAINERS>
                                          <!-- Container Definition: CanTpNAe -->
                                          <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:18b8222f-bd64-9aaf-705f-908e2a662c4d">
                                             <SHORT-NAME>CanTpNAe</SHORT-NAME>
                                             <DESC>
                                                <L-2 L="EN">This container is required for each RxNSdu and TxNSdu with AddressingFormat CANTP_MIXED or CANTP_MIXED29BIT.</L-2>
                                             </DESC>
                                             <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_CanTp_00284</RELATED-TRACE-ITEM-REF>
                                             <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                             <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                             <PARAMETERS>
                                                <!-- PARAMETER DEFINITION: CanTpNAe -->
                                                <ECUC-INTEGER-PARAM-DEF UUID="ECUC:ca4f6d74-43cf-de56-284c-f15c15991332">
                                                   <SHORT-NAME>CanTpNAe</SHORT-NAME>
                                                   <DESC>
                                                      <L-2 L="EN">This parameter contains the transport protocol address extension value.</L-2>
                                                   </DESC>
                                                   <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_CanTp_00285</RELATED-TRACE-ITEM-REF>
                                                   <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                                   <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                                   <SCOPE>LOCAL</SCOPE>
                                                   <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                                   <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                                   <VALUE-CONFIG-CLASSES>
                                                      <ECUC-VALUE-CONFIGURATION-CLASS>
                                                         <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                         <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                                      </ECUC-VALUE-CONFIGURATION-CLASS>
                                                      <ECUC-VALUE-CONFIGURATION-CLASS>
                                                         <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                         <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                                      </ECUC-VALUE-CONFIGURATION-CLASS>
                                                   </VALUE-CONFIG-CLASSES>
                                                   <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                                   <MAX>255</MAX>
                                                   <MIN>0</MIN>
                                                </ECUC-INTEGER-PARAM-DEF>
                                             </PARAMETERS>
                                          </ECUC-PARAM-CONF-CONTAINER-DEF>
                                          <!-- Container Definition: CanTpNSa -->
                                          <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:8ba3d8bb-3ecd-9132-3f29-4896b1409dad">
                                             <SHORT-NAME>CanTpNSa</SHORT-NAME>
                                             <DESC>
                                                <L-2 L="EN">This container is required for each RxNSdu and TxNSdu with RxTaType CANTP_PHYSICAL and CanTpAddressingFormat CANTP_EXTENDED. When DynIdSupport is enabled, this container is also required for each TxNSdu with AddressingFormat CANTP_NORMALFIXED or CANTP_MIXED29BIT. When DynIdSupport is enabled and GenericConnectionSupport is not enabled, this container is also required for each RxNSdu with AddressingFormat CANTP_NORMALFIXED or CANTP_MIXED29BIT.</L-2>
                                             </DESC>
                                             <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_CanTp_00253</RELATED-TRACE-ITEM-REF>
                                             <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                             <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                             <PARAMETERS>
                                                <!-- PARAMETER DEFINITION: CanTpNSa -->
                                                <ECUC-INTEGER-PARAM-DEF UUID="ECUC:c9dd6e8d-70ce-ddc3-c92d-60ad6a671331">
                                                   <SHORT-NAME>CanTpNSa</SHORT-NAME>
                                                   <DESC>
                                                      <L-2 L="EN">This parameter contains the transport protocol source address value.</L-2>
                                                   </DESC>
                                                   <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_CanTp_00254</RELATED-TRACE-ITEM-REF>
                                                   <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                                   <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                                   <SCOPE>LOCAL</SCOPE>
                                                   <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                                   <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                                   <VALUE-CONFIG-CLASSES>
                                                      <ECUC-VALUE-CONFIGURATION-CLASS>
                                                         <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                         <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                                      </ECUC-VALUE-CONFIGURATION-CLASS>
                                                      <ECUC-VALUE-CONFIGURATION-CLASS>
                                                         <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                         <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                                      </ECUC-VALUE-CONFIGURATION-CLASS>
                                                   </VALUE-CONFIG-CLASSES>
                                                   <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                                   <MAX>255</MAX>
                                                   <MIN>0</MIN>
                                                </ECUC-INTEGER-PARAM-DEF>
                                             </PARAMETERS>
                                          </ECUC-PARAM-CONF-CONTAINER-DEF>
                                          <!-- Container Definition: CanTpNTa -->
                                          <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:8a934eab-6a33-91e1-712b-19e06eac0399">
                                             <SHORT-NAME>CanTpNTa</SHORT-NAME>
                                             <DESC>
                                                <L-2 L="EN">This container is required for each RxNSdu and TxNSdu with AddressingFormat CANTP_EXTENDED. When DynIdSupport is enabled, this container is also required for each RxNSdu with AddressingFormat CANTP_NORMALFIXED or CANTP_MIXED29BIT. When DynIdSupport is enabled and GenericConnectionSupport is not enabled, this container is also required for each TxNSdu with AddressingFormat CANTP_NORMALFIXED or CANTP_MIXED29BIT.</L-2>
                                             </DESC>
                                             <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_CanTp_00139</RELATED-TRACE-ITEM-REF>
                                             <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                             <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                             <PARAMETERS>
                                                <!-- PARAMETER DEFINITION: CanTpNTa -->
                                                <ECUC-INTEGER-PARAM-DEF UUID="ECUC:16997313-3400-def4-0328-fd07f2930985">
                                                   <SHORT-NAME>CanTpNTa</SHORT-NAME>
                                                   <DESC>
                                                      <L-2 L="EN">This parameter contains the transport protocol target address value.</L-2>
                                                   </DESC>
                                                   <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_CanTp_00255</RELATED-TRACE-ITEM-REF>
                                                   <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                                   <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                                   <SCOPE>LOCAL</SCOPE>
                                                   <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                                   <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                                   <VALUE-CONFIG-CLASSES>
                                                      <ECUC-VALUE-CONFIGURATION-CLASS>
                                                         <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                         <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                                      </ECUC-VALUE-CONFIGURATION-CLASS>
                                                      <ECUC-VALUE-CONFIGURATION-CLASS>
                                                         <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                         <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                                      </ECUC-VALUE-CONFIGURATION-CLASS>
                                                   </VALUE-CONFIG-CLASSES>
                                                   <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                                   <MAX>255</MAX>
                                                   <MIN>0</MIN>
                                                </ECUC-INTEGER-PARAM-DEF>
                                             </PARAMETERS>
                                          </ECUC-PARAM-CONF-CONTAINER-DEF>
                                          <!-- Container Definition: CanTpRxNPdu -->
                                          <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:036c8537-7034-4cc4-bafc-40765f860705">
                                             <SHORT-NAME>CanTpRxNPdu</SHORT-NAME>
                                             <DESC>
                                                <L-2 L="EN">Used for grouping of the ID of a PDU and the Reference to a PDU.</L-2>
                                             </DESC>
                                             <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_CanTp_00256</RELATED-TRACE-ITEM-REF>
                                             <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                             <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                             <PARAMETERS>
                                                <!-- PARAMETER DEFINITION: CanTpRxNPduId -->
                                                <ECUC-INTEGER-PARAM-DEF UUID="ECUC:40262159-8c60-41ec-a8d8-981f42899648">
                                                   <SHORT-NAME>CanTpRxNPduId</SHORT-NAME>
                                                   <DESC>
                                                      <L-2 L="EN">The N-PDU identifier attached to the RxNsdu is identified by CanTpRxNSduId.</L-2>
                                                   </DESC>
                                                   <INTRODUCTION>
                                                      <P>
                                                         <L-1 L="EN">Each RxNsdu identifier is linked to only one SF/FF/CF N-PDU identifier. 
                                                                Nevertheless, in the case of extended or mixed addressing format, the same N-PDU identifier can be used for several N-SDU identifiers. The distinction is made by the N_TA or N_AE value (first data byte 
                                                                of SF or FF frames).</L-1>
                                                      </P>
                                                   </INTRODUCTION>
                                                   <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_CanTp_00258</RELATED-TRACE-ITEM-REF>
                                                   <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                                   <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                                   <SCOPE>LOCAL</SCOPE>
                                                   <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                                   <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                                   <VALUE-CONFIG-CLASSES>
                                                      <ECUC-VALUE-CONFIGURATION-CLASS>
                                                         <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                         <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                                      </ECUC-VALUE-CONFIGURATION-CLASS>
                                                      <ECUC-VALUE-CONFIGURATION-CLASS>
                                                         <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                         <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                                      </ECUC-VALUE-CONFIGURATION-CLASS>
                                                   </VALUE-CONFIG-CLASSES>
                                                   <SYMBOLIC-NAME-VALUE>true</SYMBOLIC-NAME-VALUE>
                                                   <MAX>65535</MAX>
                                                   <MIN>0</MIN>
                                                </ECUC-INTEGER-PARAM-DEF>
                                             </PARAMETERS>
                                             <REFERENCES>
                                                <!-- Reference Definition: CanTpRxNPduRef -->
                                                <ECUC-REFERENCE-DEF UUID="ECUC:b15ae189-a46c-4a18-be34-77f25a1d0465">
                                                   <SHORT-NAME>CanTpRxNPduRef</SHORT-NAME>
                                                   <DESC>
                                                      <L-2 L="EN">Reference to a Pdu in the COM-Stack.</L-2>
                                                   </DESC>
                                                   <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_CanTp_00257</RELATED-TRACE-ITEM-REF>
                                                   <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                                   <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                                   <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                                   <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                                                   <VALUE-CONFIG-CLASSES>
                                                      <ECUC-VALUE-CONFIGURATION-CLASS>
                                                         <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                                         <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                                      </ECUC-VALUE-CONFIGURATION-CLASS>
                                                      <ECUC-VALUE-CONFIGURATION-CLASS>
                                                         <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                         <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                                      </ECUC-VALUE-CONFIGURATION-CLASS>
                                                   </VALUE-CONFIG-CLASSES>
                                                   <DESTINATION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/AUTOSAR/EcucDefs/EcuC/EcucConfigSet/EcucPduCollection/Pdu</DESTINATION-REF>
                                                </ECUC-REFERENCE-DEF>
                                             </REFERENCES>
                                          </ECUC-PARAM-CONF-CONTAINER-DEF>
                                          <!-- Container Definition: CanTpTxFcNPdu -->
                                          <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:4991f892-f334-4fcc-b92b-2bbca315c562">
                                             <SHORT-NAME>CanTpTxFcNPdu</SHORT-NAME>
                                             <DESC>
                                                <L-2 L="EN">Used for grouping of the ID of a PDU and the Reference to a PDU.</L-2>
                                             </DESC>
                                             <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_CanTp_00259</RELATED-TRACE-ITEM-REF>
                                             <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                             <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                             <PARAMETERS>
                                                <!-- PARAMETER DEFINITION: CanTpTxFcNPduConfirmationPduId -->
                                                <ECUC-INTEGER-PARAM-DEF UUID="ECUC:c00d752b-13ad-4699-b3be-e597181b1072">
                                                   <SHORT-NAME>CanTpTxFcNPduConfirmationPduId</SHORT-NAME>
                                                   <DESC>
                                                      <L-2 L="EN">Handle Id to be used by the CanIf to confirm the transmission of the CanTpTxFcNPdu to the CanIf module.</L-2>
                                                   </DESC>
                                                   <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_CanTp_00287</RELATED-TRACE-ITEM-REF>
                                                   <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                                   <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                                   <SCOPE>LOCAL</SCOPE>
                                                   <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                                   <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                                   <VALUE-CONFIG-CLASSES>
                                                      <ECUC-VALUE-CONFIGURATION-CLASS>
                                                         <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                         <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                                      </ECUC-VALUE-CONFIGURATION-CLASS>
                                                      <ECUC-VALUE-CONFIGURATION-CLASS>
                                                         <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                         <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                                      </ECUC-VALUE-CONFIGURATION-CLASS>
                                                   </VALUE-CONFIG-CLASSES>
                                                   <SYMBOLIC-NAME-VALUE>true</SYMBOLIC-NAME-VALUE>
                                                   <MAX>65535</MAX>
                                                   <MIN>0</MIN>
                                                </ECUC-INTEGER-PARAM-DEF>
                                             </PARAMETERS>
                                             <REFERENCES>
                                                <!-- Reference Definition: CanTpTxFcNPduRef -->
                                                <ECUC-REFERENCE-DEF UUID="ECUC:4ea37b19-102e-4005-9da7-59e0a1f8fc4f">
                                                   <SHORT-NAME>CanTpTxFcNPduRef</SHORT-NAME>
                                                   <DESC>
                                                      <L-2 L="EN">Reference to a Pdu in the COM-Stack.</L-2>
                                                   </DESC>
                                                   <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_CanTp_00260</RELATED-TRACE-ITEM-REF>
                                                   <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                                   <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                                   <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                                   <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                                                   <VALUE-CONFIG-CLASSES>
                                                      <ECUC-VALUE-CONFIGURATION-CLASS>
                                                         <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                                         <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                                      </ECUC-VALUE-CONFIGURATION-CLASS>
                                                      <ECUC-VALUE-CONFIGURATION-CLASS>
                                                         <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                         <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                                      </ECUC-VALUE-CONFIGURATION-CLASS>
                                                   </VALUE-CONFIG-CLASSES>
                                                   <DESTINATION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/AUTOSAR/EcucDefs/EcuC/EcucConfigSet/EcucPduCollection/Pdu</DESTINATION-REF>
                                                </ECUC-REFERENCE-DEF>
                                             </REFERENCES>
                                          </ECUC-PARAM-CONF-CONTAINER-DEF>
                                       </SUB-CONTAINERS>
                                    </ECUC-PARAM-CONF-CONTAINER-DEF>
                                    <!-- Container Definition: CanTpTxNSdu -->
                                    <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:ae23c5cc-da8f-4952-a69e-1ac11ae31634">
                                       <SHORT-NAME>CanTpTxNSdu</SHORT-NAME>
                                       <DESC>
                                          <L-2 L="EN">The following parameters needs to be configured for each CAN N-SDU that the CanTp module transmits via the CanTpChannel.</L-2>
                                       </DESC>
                                       <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_CanTp_00138</RELATED-TRACE-ITEM-REF>
                                       <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                       <UPPER-MULTIPLICITY-INFINITE>true</UPPER-MULTIPLICITY-INFINITE>
                                       <MULTIPLICITY-CONFIG-CLASSES>
                                          <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                             <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                             <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                          </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                          <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                             <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                             <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                          </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                       </MULTIPLICITY-CONFIG-CLASSES>
                                       <POST-BUILD-VARIANT-MULTIPLICITY>true</POST-BUILD-VARIANT-MULTIPLICITY>
                                       <PARAMETERS>
                                          <!-- PARAMETER DEFINITION: CanTpNas -->
                                          <ECUC-FLOAT-PARAM-DEF UUID="ECUC:aa8cbd96-3f51-45d3-b7dd-97df8cab52b0">
                                             <SHORT-NAME>CanTpNas</SHORT-NAME>
                                             <DESC>
                                                <L-2 L="EN">Value in second of the N_As timeout. N_As is the time for transmission of a CAN frame (any N_PDU) on the part of the sender.</L-2>
                                             </DESC>
                                             <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_CanTp_00263</RELATED-TRACE-ITEM-REF>
                                             <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                             <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                             <SCOPE>LOCAL</SCOPE>
                                             <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                             <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                                             <VALUE-CONFIG-CLASSES>
                                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                             </VALUE-CONFIG-CLASSES>
                                             <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                             <MAX>Inf</MAX>
                                             <MIN>0</MIN>
                                          </ECUC-FLOAT-PARAM-DEF>
                                          <!-- PARAMETER DEFINITION: CanTpNbs -->
                                          <ECUC-FLOAT-PARAM-DEF UUID="ECUC:f9170c8d-c626-4740-b605-6e0984eeaaa9">
                                             <SHORT-NAME>CanTpNbs</SHORT-NAME>
                                             <DESC>
                                                <L-2 L="EN">Value in seconds of the N_Bs timeout. N_Bs is the time of transmission until reception of the next Flow Control N_PDU.</L-2>
                                             </DESC>
                                             <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_CanTp_00264</RELATED-TRACE-ITEM-REF>
                                             <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                             <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                             <SCOPE>LOCAL</SCOPE>
                                             <MULTIPLICITY-CONFIG-CLASSES>
                                                <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                                </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                                <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                                </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                             </MULTIPLICITY-CONFIG-CLASSES>
                                             <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                             <POST-BUILD-VARIANT-MULTIPLICITY>true</POST-BUILD-VARIANT-MULTIPLICITY>
                                             <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                                             <VALUE-CONFIG-CLASSES>
                                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                             </VALUE-CONFIG-CLASSES>
                                             <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                             <MAX>Inf</MAX>
                                             <MIN>0</MIN>
                                          </ECUC-FLOAT-PARAM-DEF>
                                          <!-- PARAMETER DEFINITION: CanTpNcs -->
                                          <ECUC-FLOAT-PARAM-DEF UUID="ECUC:76ef9dbd-266a-4a13-a9cc-ed92e147d5c3">
                                             <SHORT-NAME>CanTpNcs</SHORT-NAME>
                                             <DESC>
                                                <L-2 L="EN">Value in seconds of the performance requirement of (N_Cs + N_As). N_Cs is the time which elapses between the transmit request of a CF N-PDU until the transmit request of the next CF N-PDU.</L-2>
                                             </DESC>
                                             <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_CanTp_00265</RELATED-TRACE-ITEM-REF>
                                             <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                             <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                             <SCOPE>LOCAL</SCOPE>
                                             <MULTIPLICITY-CONFIG-CLASSES>
                                                <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                                </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                                <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                                </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                             </MULTIPLICITY-CONFIG-CLASSES>
                                             <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                             <POST-BUILD-VARIANT-MULTIPLICITY>true</POST-BUILD-VARIANT-MULTIPLICITY>
                                             <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                                             <VALUE-CONFIG-CLASSES>
                                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                             </VALUE-CONFIG-CLASSES>
                                             <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                             <MAX>Inf</MAX>
                                             <MIN>0</MIN>
                                          </ECUC-FLOAT-PARAM-DEF>
                                          <!-- PARAMETER DEFINITION: CanTpTc -->
                                          <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:aaf45ff0-1683-409e-8948-a14484b30250">
                                             <SHORT-NAME>CanTpTc</SHORT-NAME>
                                             <DESC>
                                                <L-2 L="EN">Switch for enabling Transmit Cancellation and Receive Cancellation.</L-2>
                                             </DESC>
                                             <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_CanTp_00282</RELATED-TRACE-ITEM-REF>
                                             <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                             <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                             <SCOPE>LOCAL</SCOPE>
                                             <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                             <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                             <VALUE-CONFIG-CLASSES>
                                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                             </VALUE-CONFIG-CLASSES>
                                             <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                          </ECUC-BOOLEAN-PARAM-DEF>
                                          <!-- PARAMETER DEFINITION: CanTpTxAddressingFormat -->
                                          <ECUC-ENUMERATION-PARAM-DEF UUID="ECUC:882d2f8d-fd9d-4a01-985f-cbbb3f2874a3">
                                             <SHORT-NAME>CanTpTxAddressingFormat</SHORT-NAME>
                                             <DESC>
                                                <L-2 L="EN">Declares which communication addressing format is supported for this TxNSdu. Definition of Enumeration values:</L-2>
                                             </DESC>
                                             <INTRODUCTION>
                                                <P>
                                                   <L-1 L="EN">CanTpStandard to use normal addressing format. 
                                                        CanTpExtended to use extended addressing format. 
                                                        CanTpMixed to use mixed 11 bit addressing format. 
                                                        CanTpNormalFixed to use normal fixed addressing format. 
                                                        CanTpMixed29Bit to use mixed 29 bit addressing format.</L-1>
                                                </P>
                                             </INTRODUCTION>
                                             <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_CanTp_00262</RELATED-TRACE-ITEM-REF>
                                             <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                             <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                             <SCOPE>LOCAL</SCOPE>
                                             <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                             <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                             <VALUE-CONFIG-CLASSES>
                                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                             </VALUE-CONFIG-CLASSES>
                                             <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                             <LITERALS>
                                                <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:7cf2c32b-b2a0-8bc7-554a-177182241ad4">
                                                   <SHORT-NAME>CANTP_EXTENDED</SHORT-NAME>
                                                   <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                                </ECUC-ENUMERATION-LITERAL-DEF>
                                                <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:89785d90-d4a8-8b83-3f07-360dacf66394">
                                                   <SHORT-NAME>CANTP_MIXED</SHORT-NAME>
                                                   <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                                </ECUC-ENUMERATION-LITERAL-DEF>
                                                <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:c64740cf-f741-e1a4-d7ab-9936e1d438fd">
                                                   <SHORT-NAME>CANTP_MIXED29BIT</SHORT-NAME>
                                                   <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                                </ECUC-ENUMERATION-LITERAL-DEF>
                                                <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:4a134e7d-9939-d8d7-c143-c614fdbe431e">
                                                   <SHORT-NAME>CANTP_NORMALFIXED</SHORT-NAME>
                                                   <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                                </ECUC-ENUMERATION-LITERAL-DEF>
                                                <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:fa70529c-b4c8-8ebf-59ce-f3339279f14c">
                                                   <SHORT-NAME>CANTP_STANDARD</SHORT-NAME>
                                                   <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                                </ECUC-ENUMERATION-LITERAL-DEF>
