                              </ECUC-BOOLEAN-PARAM-DEF>
                              <!-- PARAMETER DEFINITION: LinNmUserDataEnabled -->
                              <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:52314590-0421-48d3-bbf2-e15b7ec4f3b7">
                                 <SHORT-NAME>LinNmUserDataEnabled</SHORT-NAME>
                                 <DESC>
                                    <L-2 L="EN">Pre-processor switch for enabling User Data support.</L-2>
                                 </DESC>
