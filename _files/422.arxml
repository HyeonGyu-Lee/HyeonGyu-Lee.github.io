                              </ECUC-BOOLEAN-PARAM-DEF>
                              <!-- PARAMETER DEFINITION: CanSMSetBaudrateApi -->
                              <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:ec4a84cd-09ae-448b-aab2-c0239ed03b0e">
                                 <SHORT-NAME>CanSMSetBaudrateApi</SHORT-NAME>
                                 <DESC>
                                    <L-2 L="EN">The support of the Can_SetBaudrate API is optional. If this parameter is set to true the Can_SetBaudrate API shall be supported. Otherwise the API is not supported.</L-2>
                                 </DESC>
                                 <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_CanSM_00343</RELATED-TRACE-ITEM-REF>
