                                                         <SUB-CONTAINERS>
                                                            <!-- Container Definition: DcmDspArgumentScaling -->
                                                            <ECUC-CHOICE-CONTAINER-DEF UUID="ECUC:b9e00158-e166-97ff-4783-c471c4164f64">
                                                               <SHORT-NAME>DcmDspArgumentScaling</SHORT-NAME>
                                                               <DESC>
                                                                  <L-2 L="EN">This container contains the configuration (arguments) of an alternative Diagnosis Representation. Out if this the scaling between Diagnosis and ECU internal representation and vice versa can be calculated.</L-2>
                                                               </DESC>
                                                               <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_Dcm_01062</RELATED-TRACE-ITEM-REF>
                                                               <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                                               <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                                               <CHOICES>
                                                                  <!-- Container Definition: DcmDspAlternativeArgumentData -->
                                                                  <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:9bb8161f-2463-d9ad-da19-bf80584201d2">
                                                                     <SHORT-NAME>DcmDspAlternativeArgumentData</SHORT-NAME>
                                                                     <DESC>
                                                                        <L-2 L="EN">This container contains the configuration (parameters) of an alternative Diagnosis Representation by the means of a ArgumentDataPrototype.</L-2>
                                                                     </DESC>
                                                                     <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_Dcm_01055</RELATED-TRACE-ITEM-REF>
                                                                     <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                                                     <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                                                     <REFERENCES>
                                                                        <!-- Foreign Reference Definition: DcmDataElement -->
                                                                        <ECUC-FOREIGN-REFERENCE-DEF UUID="ECUC:79a87f29-46b9-1b15-8d05-68e87e0721f0">
                                                                           <SHORT-NAME>DcmDataElement</SHORT-NAME>
                                                                           <DESC>
                                                                              <L-2 L="EN">Alternative Diagnosis Representation for the data defined by the means of a ArgumentDataPrototype</L-2>
                                                                           </DESC>
                                                                           <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_Dcm_01056</RELATED-TRACE-ITEM-REF>
                                                                           <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                                                           <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                                                           <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                                                           <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
