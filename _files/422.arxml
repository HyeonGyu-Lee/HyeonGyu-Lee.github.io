                                 <SUB-CONTAINERS>
                                    <!-- Container Definition: FrNmChannelIdentifiers -->
                                    <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:392d860d-8822-4778-be94-d9cbed0b21ee">
                                       <SHORT-NAME>FrNmChannelIdentifiers</SHORT-NAME>
