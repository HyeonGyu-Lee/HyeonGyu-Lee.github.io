                                 <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                 <MAX>65.535</MAX>
                                 <MIN>0.001</MIN>
                              </ECUC-FLOAT-PARAM-DEF>
                              <!-- PARAMETER DEFINITION: CanSMPncSupport -->
                              <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:428e913d-8727-41c4-9923-7b19a97a76a8">
                                 <SHORT-NAME>CanSMPncSupport</SHORT-NAME>
                                 <DESC>
                                    <L-2 L="EN">Enables or disables support of partial networking.</L-2>
                                 </DESC>
                                 <INTRODUCTION>
                                    <P>
                                       <L-1 L="EN">False: Partial Networking is disabled 
                                        True: Partial Networking is enabled</L-1>
                                    </P>
                                 </INTRODUCTION>
                                 <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_CanSM_00344</RELATED-TRACE-ITEM-REF>
