                                    <!-- PARAMETER DEFINITION: FrNmPnEiraCalcEnabled -->
                                    <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:08325234-1f20-4c36-af9c-69a50a057b17">
                                       <SHORT-NAME>FrNmPnEiraCalcEnabled</SHORT-NAME>
                                       <DESC>
                                          <L-2 L="EN">Specifies if FrNm calculates the PN request information for internal an external requests. (EIRA)</L-2>
                                       </DESC>
                                       <INTRODUCTION>
                                          <P>
                                             <L-1 L="EN">true: PN request are calculated
