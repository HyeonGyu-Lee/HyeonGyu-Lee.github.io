                        <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:da0aaff6-3ed6-4a15-824e-dc32f3a8bd93">
                           <SHORT-NAME>AdcGeneral</SHORT-NAME>
                           <DESC>
