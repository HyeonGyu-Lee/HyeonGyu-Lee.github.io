                  </ECUC-MODULE-DEF>
                  <!-- Module Definition: LinNm -->
                  <ECUC-MODULE-DEF UUID="ECUC:5fffd262-bff3-4654-9e04-15186d0d360d">
                     <SHORT-NAME>LinNm</SHORT-NAME>
                     <DESC>
                        <L-2 L="EN">Configuration Parameters for the Lin Nm module.</L-2>
                     </DESC>
                     <ADMIN-DATA>
                        <DOC-REVISIONS>
                           <DOC-REVISION>
                              <REVISION-LABEL>4.2.2</REVISION-LABEL>
                              <ISSUED-BY>AUTOSAR</ISSUED-BY>
                              <DATE>2014-10-31</DATE>
                           </DOC-REVISION>
                        </DOC-REVISIONS>
                     </ADMIN-DATA>
                     <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                     <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                     <POST-BUILD-VARIANT-SUPPORT>false</POST-BUILD-VARIANT-SUPPORT>
                     <SUPPORTED-CONFIG-VARIANTS>
                        <SUPPORTED-CONFIG-VARIANT>VARIANT-LINK-TIME</SUPPORTED-CONFIG-VARIANT>
                        <SUPPORTED-CONFIG-VARIANT>VARIANT-PRE-COMPILE</SUPPORTED-CONFIG-VARIANT>
                     </SUPPORTED-CONFIG-VARIANTS>
                     <CONTAINERS>
                        <!-- Container Definition: LinNmGlobalConfig -->
                        <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:534f84b2-6d05-4c99-8dee-8f74bf3e15a1">
                           <SHORT-NAME>LinNmGlobalConfig</SHORT-NAME>
                           <DESC>
                              <L-2 L="EN">This container contains the global configuration parameter of the LinNm.</L-2>
                           </DESC>
                           <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_LinNm_00001</RELATED-TRACE-ITEM-REF>
                           <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                           <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                           <PARAMETERS>
                              <!-- PARAMETER DEFINITION: LinNmBusSynchronizationEnabled -->
                              <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:34aeae50-3f53-4ad2-ae2f-6d24cae5270b">
                                 <SHORT-NAME>LinNmBusSynchronizationEnabled</SHORT-NAME>
                                 <DESC>
                                    <L-2 L="EN">Pre-processor switch for enabling bus synchronization support of the LinNm. This feature is required for NM Coordinator nodes only.</L-2>
                                 </DESC>
                                 <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_LinNm_00015</RELATED-TRACE-ITEM-REF>
                                 <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                 <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                 <SCOPE>LOCAL</SCOPE>
                                 <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                 <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                 <VALUE-CONFIG-CLASSES>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                       <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                       <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                       <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                       <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                 </VALUE-CONFIG-CLASSES>
                                 <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                              </ECUC-BOOLEAN-PARAM-DEF>
                              <!-- PARAMETER DEFINITION: LinNmComControlEnabled -->
                              <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:fffa7ced-3e7e-4677-bb33-686b51c7ba4e">
                                 <SHORT-NAME>LinNmComControlEnabled</SHORT-NAME>
                                 <DESC>
                                    <L-2 L="EN">Pre-processor switch for enabling the Communication Control support.</L-2>
                                 </DESC>
                                 <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_LinNm_00019</RELATED-TRACE-ITEM-REF>
                                 <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                 <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                 <SCOPE>LOCAL</SCOPE>
                                 <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                 <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                 <VALUE-CONFIG-CLASSES>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                       <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                       <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                       <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                       <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                 </VALUE-CONFIG-CLASSES>
                                 <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                              </ECUC-BOOLEAN-PARAM-DEF>
                              <!-- PARAMETER DEFINITION: LinNmComUserDataSupport -->
                              <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:78d67e94-71c4-4acd-a90f-6b1307b0c31e">
                                 <SHORT-NAME>LinNmComUserDataSupport</SHORT-NAME>
                                 <DESC>
                                    <L-2 L="EN">Pre-processor switch for enabling the NM COM user data support.</L-2>
                                    <L-2 L="EN">Tags: atp.Status=obsolete</L-2>
                                 </DESC>
                                 <INTRODUCTION>
                                    <P>
                                       <L-1 L="EN">This parameter is set to obsolete and will be removed in release 4.3.</L-1>
                                    </P>
                                    <P>
                                       <L-1 L="EN">This element is obsolete and will be removed in a future revision.</L-1>
                                    </P>
                                 </INTRODUCTION>
                                 <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_LinNm_00025</RELATED-TRACE-ITEM-REF>
                                 <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                 <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                 <SCOPE>LOCAL</SCOPE>
                                 <ORIGIN>AUTOSAR_ECUC</ORIGIN>
