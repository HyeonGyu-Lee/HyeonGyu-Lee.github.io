                                       <SHORT-NAME>INITIALIZED_RAM</SHORT-NAME>
                                       <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                    </ECUC-ENUMERATION-LITERAL-DEF>
                                    <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:1a05cee2-b7c2-8535-3910-723eda23d71d">
                                       <SHORT-NAME>NONE</SHORT-NAME>
                                       <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                    </ECUC-ENUMERATION-LITERAL-DEF>
