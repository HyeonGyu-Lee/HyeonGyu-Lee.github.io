                                                      <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:9ee3dd2a-d4cb-4293-a851-abc6329c93ea">
                                                         <SHORT-NAME>DcmDspStopRoutineInSignal</SHORT-NAME>
                                                         <DESC>
                                                            <L-2 L="EN">Provide description of a routine signal used in RoutineControl service.</L-2>
                                                         </DESC>
                                                         <INTRODUCTION>
                                                            <P>
                                                               <L-1 L="EN">The ordering defined via the index attribute of the subcontainers in this list represents the order of the dataInN elements in the XXX_Stop function call.</L-1>
                                                            </P>
                                                         </INTRODUCTION>
                                                         <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_Dcm_00839</RELATED-TRACE-ITEM-REF>
                                                         <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                                         <UPPER-MULTIPLICITY-INFINITE>true</UPPER-MULTIPLICITY-INFINITE>
                                                         <REQUIRES-INDEX>true</REQUIRES-INDEX>
                                                         <PARAMETERS>
                                                            <!-- PARAMETER DEFINITION: DcmDspRoutineSignalEndianness -->
                                                            <ECUC-ENUMERATION-PARAM-DEF UUID="ECUC:516b4017-8fc4-4cb3-af62-95db3283f55f">
                                                               <SHORT-NAME>DcmDspRoutineSignalEndianness</SHORT-NAME>
                                                               <DESC>
                                                                  <L-2 L="EN">Defines the endianness of the data belonging to a Routine In Signal for Stop subfunction.</L-2>
                                                               </DESC>
                                                               <INTRODUCTION>
                                                                  <P>
                                                                     <L-1 L="EN">If no DcmDspRoutineSignalEndianness is defined the value of DcmDspDataDefaultEndianness is applicable.</L-1>
                                                                  </P>
                                                               </INTRODUCTION>
                                                               <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_Dcm_01014</RELATED-TRACE-ITEM-REF>
