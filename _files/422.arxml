                                                      </ECUC-ENUMERATION-LITERAL-DEF>
                                                   </LITERALS>
                                                </ECUC-ENUMERATION-PARAM-DEF>
                                                <!-- PARAMETER DEFINITION: EcuMModuleService -->
                                                <ECUC-STRING-PARAM-DEF UUID="ECUC:26110108-a692-e310-ed79-9e20de6d0c30">
                                                   <SHORT-NAME>EcuMModuleService</SHORT-NAME>
                                                   <DESC>
                                                      <L-2 L="EN">The service to be called to initialize that module, e.g. Init, PreInit, Start etc. If nothing is defined "Init" is taken by default.</L-2>
                                                   </DESC>
                                                   <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_EcuM_00124</RELATED-TRACE-ITEM-REF>
                                                   <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
