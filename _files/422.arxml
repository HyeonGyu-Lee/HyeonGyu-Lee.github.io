                                                         <DESC>
                                                            <L-2 L="EN">This is a foreign reference to the Mode Declaration Group Prototype.</L-2>
                                                            <L-2 L="EN">Tags: atp.Status=obsolete, atp.StatusRevisionBegin=4.2.2</L-2>
                                                         </DESC>
                                                         <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_BswM_00981</RELATED-TRACE-ITEM-REF>
                                                         <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
