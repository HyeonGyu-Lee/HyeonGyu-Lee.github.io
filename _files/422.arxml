                                 <MIN>1</MIN>
                              </ECUC-INTEGER-PARAM-DEF>
                              <!-- PARAMETER DEFINITION: DltMaxCountContextIds -->
                              <ECUC-INTEGER-PARAM-DEF UUID="ECUC:6c2f1f5e-1d47-49f0-b214-0979978cae61">
                                 <SHORT-NAME>DltMaxCountContextIds</SHORT-NAME>
                                 <DESC>
                                    <L-2 L="EN">The maximum count of registrable Context Ids. There shall be a table to manage registered Context IDs, this is the number of lines to hold in this table.</L-2>
                                 </DESC>
                                 <INTRODUCTION>
                                    <P>
                                       <L-1 L="EN">Unit: byte</L-1>
                                    </P>
                                 </INTRODUCTION>
                                 <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_Dlt_00825</RELATED-TRACE-ITEM-REF>
