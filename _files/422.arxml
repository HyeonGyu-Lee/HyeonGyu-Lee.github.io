                                    <!-- Symbolic Name Reference Definition: LinTpTxNSduChannelRef -->
                                    <ECUC-SYMBOLIC-NAME-REFERENCE-DEF UUID="ECUC:cf97bb02-8432-4030-a195-bfa294ac463d">
                                       <SHORT-NAME>LinTpTxNSduChannelRef</SHORT-NAME>
                                       <DESC>
