                           </DESC>
                           <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_LinTp_00617</RELATED-TRACE-ITEM-REF>
                           <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                           <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                           <PARAMETERS>
                              <!-- PARAMETER DEFINITION: LinTpChangeParameterApi -->
                              <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:722f06a2-90c9-43e7-844d-c869657b44e8">
                                 <SHORT-NAME>LinTpChangeParameterApi</SHORT-NAME>
                                 <DESC>
                                    <L-2 L="EN">This parameter, if set to true, enables the LinTp_ChangeParameterRequest Api for this Module.</L-2>
                                 </DESC>
                                 <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_LinTp_00638</RELATED-TRACE-ITEM-REF>
                                 <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                 <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
