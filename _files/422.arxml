                                 <SHORT-NAME>J1939DcmDM01BufferSize</SHORT-NAME>
                                 <DESC>
                                    <L-2 L="EN">Size of DM01 buffer (in Bytes). The buffer size should be as large as the longest DM01 response message.</L-2>
                                 </DESC>
                                 <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_J1939Dcm_00041</RELATED-TRACE-ITEM-REF>
