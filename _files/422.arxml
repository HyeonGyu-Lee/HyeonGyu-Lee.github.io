                        <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:b9c7141d-4b7f-4b67-a69a-94b54e5e2350">
                           <SHORT-NAME>J1939DcmGeneral</SHORT-NAME>
                           <DESC>
                              <L-2 L="EN">Contains the general configuration parameters of the module.</L-2>
                           </DESC>
