                                          <!-- PARAMETER DEFINITION: ComTransferProperty -->
                                          <ECUC-ENUMERATION-PARAM-DEF UUID="ECUC:74335baf-cc2f-4470-9926-0dde9c21f642">
                                             <SHORT-NAME>ComTransferProperty</SHORT-NAME>
                                             <DESC>
                                                <L-2 L="EN">Optionally defines whether this group signal shall contribute to the TRIGGERED_ON_CHANGE transfer property of the signal group. If at least one  group signal of a signal group has the "ComTransferProperty" configured all other group signals of that signal group shall have the attribute configured as well.</L-2>
                                             </DESC>
                                             <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_Com_00560</RELATED-TRACE-ITEM-REF>
