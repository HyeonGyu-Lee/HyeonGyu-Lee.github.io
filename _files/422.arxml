                                          <!-- PARAMETER DEFINITION: J1939RmUserRequestIndication -->
                                          <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:d4306c2d-71d4-41e5-b6c0-bc1354a535df">
                                             <SHORT-NAME>J1939RmUserRequestIndication</SHORT-NAME>
                                             <DESC>
                                                <L-2 L="EN">Enable RequestIndication for this module. In case of J1939Nm or J1939Dcm, the name is fixed. In case of CDD, the name is &lt;apiServicePrefix&gt;_RequestIndication. In case of RTE, J1939Rm will call the operation RequestIndication of the required port J1939Rm_RequestIndication_{user}.</L-2>
                                             </DESC>
                                             <INTRODUCTION>
                                                <P>
                                                   <L-1 L="EN">This parameter shall not be set for J1939RmUserType J1939RM_USER_COM.</L-1>
                                                </P>
                                             </INTRODUCTION>
                                             <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_J1939Rm_00027</RELATED-TRACE-ITEM-REF>
                                             <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                             <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
