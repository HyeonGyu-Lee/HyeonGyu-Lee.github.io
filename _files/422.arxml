                                             <SHORT-NAME>J1939TpRxCmNPduRef</SHORT-NAME>
                                             <DESC>
                                                <L-2 L="EN">Reference to the Pdu object representing the N-PDU.</L-2>
                                             </DESC>
                                             <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_J1939Tp_00158</RELATED-TRACE-ITEM-REF>
