                                                      <L-2 L="EN">Reference to the "global" Pdu structure to allow harmonization of handle IDs in the COM-Stack.</L-2>
                                                   </DESC>
                                                   <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_DoIP_00050</RELATED-TRACE-ITEM-REF>
                                                   <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                                   <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                                   <SCOPE>LOCAL</SCOPE>
                                                   <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                                   <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                                                   <VALUE-CONFIG-CLASSES>
                                                      <ECUC-VALUE-CONFIGURATION-CLASS>
                                                         <CONFIG-CLASS>LINK</CONFIG-CLASS>
                                                         <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                                                      </ECUC-VALUE-CONFIGURATION-CLASS>
                                                      <ECUC-VALUE-CONFIGURATION-CLASS>
                                                         <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                                         <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                                      </ECUC-VALUE-CONFIGURATION-CLASS>
                                                      <ECUC-VALUE-CONFIGURATION-CLASS>
                                                         <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                         <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                                      </ECUC-VALUE-CONFIGURATION-CLASS>
                                                   </VALUE-CONFIG-CLASSES>
                                                   <DESTINATION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/AUTOSAR/EcucDefs/EcuC/EcucConfigSet/EcucPduCollection/Pdu</DESTINATION-REF>
                                                </ECUC-REFERENCE-DEF>
                                             </REFERENCES>
                                          </ECUC-PARAM-CONF-CONTAINER-DEF>
                                       </SUB-CONTAINERS>
                                    </ECUC-PARAM-CONF-CONTAINER-DEF>
                                 </SUB-CONTAINERS>
                              </ECUC-PARAM-CONF-CONTAINER-DEF>
                              <!-- Container Definition: DoIPRoutingActivation -->
                              <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:8c07e2b0-4dd1-45fc-89ae-19a97da7e734">
                                 <SHORT-NAME>DoIPRoutingActivation</SHORT-NAME>
                                 <DESC>
                                    <L-2 L="EN">This container describes the routing activation possibilities by representing for each container a possible routing activation request message to the DoIP entity and the according references to the activated diagnostic messages.</L-2>
                                 </DESC>
                                 <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_DoIP_00030</RELATED-TRACE-ITEM-REF>
                                 <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                 <UPPER-MULTIPLICITY>255</UPPER-MULTIPLICITY>
                                 <MULTIPLICITY-CONFIG-CLASSES>
                                    <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                       <CONFIG-CLASS>LINK</CONFIG-CLASS>
                                       <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                                    </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                    <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                       <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                       <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                    </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                    <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                       <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                       <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                 </MULTIPLICITY-CONFIG-CLASSES>
                                 <POST-BUILD-VARIANT-MULTIPLICITY>true</POST-BUILD-VARIANT-MULTIPLICITY>
                                 <PARAMETERS>
                                    <!-- PARAMETER DEFINITION: DoIPRoutingActivationNumber -->
                                    <ECUC-INTEGER-PARAM-DEF UUID="ECUC:335e310b-8d47-48bf-b643-5c12468a5f01">
                                       <SHORT-NAME>DoIPRoutingActivationNumber</SHORT-NAME>
                                       <DESC>
                                          <L-2 L="EN">Identifies the Routing activation Number which is received for a DoIP routing activation request message.</L-2>
                                       </DESC>
                                       <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_DoIP_00033</RELATED-TRACE-ITEM-REF>
                                       <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                       <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                       <SCOPE>LOCAL</SCOPE>
                                       <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                       <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                                       <VALUE-CONFIG-CLASSES>
                                          <ECUC-VALUE-CONFIGURATION-CLASS>
                                             <CONFIG-CLASS>LINK</CONFIG-CLASS>
                                             <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                                          </ECUC-VALUE-CONFIGURATION-CLASS>
                                          <ECUC-VALUE-CONFIGURATION-CLASS>
                                             <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                             <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                          </ECUC-VALUE-CONFIGURATION-CLASS>
                                          <ECUC-VALUE-CONFIGURATION-CLASS>
                                             <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                             <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                          </ECUC-VALUE-CONFIGURATION-CLASS>
                                       </VALUE-CONFIG-CLASSES>
                                       <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                       <MAX>255</MAX>
                                       <MIN>0</MIN>
                                    </ECUC-INTEGER-PARAM-DEF>
                                 </PARAMETERS>
                                 <REFERENCES>
                                    <!-- Reference Definition: DoIPTargetAddressRef -->
                                    <ECUC-REFERENCE-DEF UUID="ECUC:ebc9f44b-f588-4a77-a371-08bfa7d33272">
                                       <SHORT-NAME>DoIPTargetAddressRef</SHORT-NAME>
                                       <DESC>
                                          <L-2 L="EN">Reference to all DoIPTargetAddress which are activated on this Routing activation.</L-2>
                                       </DESC>
                                       <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_DoIP_00034</RELATED-TRACE-ITEM-REF>
                                       <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                       <UPPER-MULTIPLICITY>255</UPPER-MULTIPLICITY>
                                       <SCOPE>LOCAL</SCOPE>
                                       <MULTIPLICITY-CONFIG-CLASSES>
                                          <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                             <CONFIG-CLASS>LINK</CONFIG-CLASS>
                                             <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                                          </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                          <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                             <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                             <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                          </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                          <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                             <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                             <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                          </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                       </MULTIPLICITY-CONFIG-CLASSES>
                                       <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                       <POST-BUILD-VARIANT-MULTIPLICITY>true</POST-BUILD-VARIANT-MULTIPLICITY>
                                       <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                                       <VALUE-CONFIG-CLASSES>
                                          <ECUC-VALUE-CONFIGURATION-CLASS>
                                             <CONFIG-CLASS>LINK</CONFIG-CLASS>
                                             <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                                          </ECUC-VALUE-CONFIGURATION-CLASS>
                                          <ECUC-VALUE-CONFIGURATION-CLASS>
                                             <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                             <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                          </ECUC-VALUE-CONFIGURATION-CLASS>
                                          <ECUC-VALUE-CONFIGURATION-CLASS>
                                             <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                             <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                          </ECUC-VALUE-CONFIGURATION-CLASS>
                                       </VALUE-CONFIG-CLASSES>
                                       <DESTINATION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/AUTOSAR/EcucDefs/DoIP/DoIPConfigSet/DoIPConnections/DoIPTargetAddress</DESTINATION-REF>
                                    </ECUC-REFERENCE-DEF>
                                 </REFERENCES>
                                 <SUB-CONTAINERS>
                                    <!-- Container Definition: DoIPRoutingActivationAuthenticationCallback -->
                                    <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:726377c7-0039-4edc-b57c-dd98bc5e99b7">
                                       <SHORT-NAME>DoIPRoutingActivationAuthenticationCallback</SHORT-NAME>
                                       <DESC>
                                          <L-2 L="EN">Container describes the Callbackfunction to call on a Routing Activation Request for Authentication. If this container is configured but the DoIPRoutingActivationAuthenticationFunc parameter is not present, the DoIP module will use an RPort of ServiceInterface &lt;RoutingActivation&gt;_RoutingActivation with the name "CB&lt;RoutingActivation&gt;RoutingActivation". &lt;RoutingActivation&gt; is the ShortName of the DoIPRoutingActiviation container.</L-2>
                                       </DESC>
                                       <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_DoIP_00035</RELATED-TRACE-ITEM-REF>
                                       <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                       <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                       <PARAMETERS>
                                          <!-- PARAMETER DEFINITION: DoIPRoutingActivationAuthenticationFunc -->
                                          <ECUC-FUNCTION-NAME-DEF UUID="ECUC:05ef7a06-64da-467c-be24-d40bac66acc3">
                                             <SHORT-NAME>DoIPRoutingActivationAuthenticationFunc</SHORT-NAME>
                                             <DESC>
                                                <L-2 L="EN">Direct C Callback function to trigger the authentication function for routing activation. If the DoIPRoutingActivationAuthenticationFunc parameter is present, the DoIP module will not use an RPort of ServiceInterface &lt;RoutingActivation&gt;_RoutingActivation but call the configured function.</L-2>
                                             </DESC>
                                             <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_DoIP_00039</RELATED-TRACE-ITEM-REF>
                                             <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                             <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                             <SCOPE>LOCAL</SCOPE>
                                             <MULTIPLICITY-CONFIG-CLASSES>
                                                <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>LINK</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                                                </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                                <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>LINK</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                                </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                                <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                                </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                             </MULTIPLICITY-CONFIG-CLASSES>
                                             <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                             <POST-BUILD-VARIANT-MULTIPLICITY>false</POST-BUILD-VARIANT-MULTIPLICITY>
                                             <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                             <VALUE-CONFIG-CLASSES>
                                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>LINK</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>LINK</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                             </VALUE-CONFIG-CLASSES>
                                             <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                             <ECUC-FUNCTION-NAME-DEF-VARIANTS>
                                                <ECUC-FUNCTION-NAME-DEF-CONDITIONAL/>
                                             </ECUC-FUNCTION-NAME-DEF-VARIANTS>
                                          </ECUC-FUNCTION-NAME-DEF>
                                          <!-- PARAMETER DEFINITION: DoIPRoutingActivationAuthenticationReqLength -->
                                          <ECUC-INTEGER-PARAM-DEF UUID="ECUC:2abdcf96-9b8e-4936-afc0-ede76b21f3a7">
                                             <SHORT-NAME>DoIPRoutingActivationAuthenticationReqLength</SHORT-NAME>
                                             <DESC>
                                                <L-2 L="EN">Describes the amount of bytes used to handle to the authentication function on routing activation. If 0 is configured as length the parameter AuthenticationReqData will not be handled to the API.</L-2>
                                             </DESC>
                                             <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_DoIP_00040</RELATED-TRACE-ITEM-REF>
                                             <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                             <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                             <SCOPE>LOCAL</SCOPE>
                                             <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                             <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                             <VALUE-CONFIG-CLASSES>
                                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>LINK</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>LINK</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                             </VALUE-CONFIG-CLASSES>
                                             <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                             <MAX>4</MAX>
                                             <MIN>0</MIN>
                                          </ECUC-INTEGER-PARAM-DEF>
                                          <!-- PARAMETER DEFINITION: DoIPRoutingActivationAuthenticationResLength -->
                                          <ECUC-INTEGER-PARAM-DEF UUID="ECUC:45e1fc22-6491-40ed-87b8-7917007771a8">
                                             <SHORT-NAME>DoIPRoutingActivationAuthenticationResLength</SHORT-NAME>
                                             <DESC>
                                                <L-2 L="EN">Describes the amount of bytes used to read by the authentication function on routing activation. If 0 is configured as length the parameter AuthenticationResData will not be fetched via the API.</L-2>
                                             </DESC>
                                             <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_DoIP_00041</RELATED-TRACE-ITEM-REF>
                                             <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                             <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                             <SCOPE>LOCAL</SCOPE>
                                             <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                             <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                             <VALUE-CONFIG-CLASSES>
                                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>LINK</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>LINK</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                             </VALUE-CONFIG-CLASSES>
                                             <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                             <MAX>4</MAX>
                                             <MIN>0</MIN>
                                          </ECUC-INTEGER-PARAM-DEF>
                                       </PARAMETERS>
                                    </ECUC-PARAM-CONF-CONTAINER-DEF>
                                    <!-- Container Definition: DoIPRoutingActivationConfirmationCallback -->
                                    <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:7e1d1ce3-eff6-43ab-a071-e6b83dfa4855">
                                       <SHORT-NAME>DoIPRoutingActivationConfirmationCallback</SHORT-NAME>
                                       <DESC>
                                          <L-2 L="EN">Container describes the Callbackfunction to call on a Routing Activation Request for Confirmation. If this container is configured but the DoIPRoutingActivationConfirmationFunc parameter is not present the DoIP module will use an RPort of ServiceInterface &lt;RoutingActivation&gt;_RoutingActivation with the name "CB&lt;RoutingActivation&gt;RoutingActivation". &lt;RoutingActivation&gt; is the ShortName of the DoIPRoutingActiviation container.</L-2>
                                       </DESC>
                                       <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_DoIP_00061</RELATED-TRACE-ITEM-REF>
                                       <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                       <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                       <PARAMETERS>
                                          <!-- PARAMETER DEFINITION: DoIPRoutingActivationConfirmationFunc -->
                                          <ECUC-FUNCTION-NAME-DEF UUID="ECUC:4630dc00-f4e8-4bf0-b18c-1a98a4f2f7c9">
                                             <SHORT-NAME>DoIPRoutingActivationConfirmationFunc</SHORT-NAME>
                                             <DESC>
                                                <L-2 L="EN">Direct C Callback function to trigger the confirmation function for routing activation. If the DoIPRoutingActivationConfirmationFunc parameter is present the DoIP module will not use an RPort of ServiceInterface &lt;RoutingActivation&gt;_RoutingActivation but call the configured function.</L-2>
                                             </DESC>
                                             <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_DoIP_00036</RELATED-TRACE-ITEM-REF>
                                             <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                             <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                             <SCOPE>LOCAL</SCOPE>
                                             <MULTIPLICITY-CONFIG-CLASSES>
                                                <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>LINK</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                                                </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                                <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>LINK</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                                </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                                <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                                </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                             </MULTIPLICITY-CONFIG-CLASSES>
                                             <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                             <POST-BUILD-VARIANT-MULTIPLICITY>false</POST-BUILD-VARIANT-MULTIPLICITY>
                                             <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                             <VALUE-CONFIG-CLASSES>
                                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>LINK</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>LINK</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                             </VALUE-CONFIG-CLASSES>
                                             <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                             <ECUC-FUNCTION-NAME-DEF-VARIANTS>
                                                <ECUC-FUNCTION-NAME-DEF-CONDITIONAL/>
                                             </ECUC-FUNCTION-NAME-DEF-VARIANTS>
                                          </ECUC-FUNCTION-NAME-DEF>
                                          <!-- PARAMETER DEFINITION: DoIPRoutingActivationConfirmationReqLength -->
                                          <ECUC-INTEGER-PARAM-DEF UUID="ECUC:b5b1030f-ad9f-4bbf-b2a0-9674bf5f20a7">
                                             <SHORT-NAME>DoIPRoutingActivationConfirmationReqLength</SHORT-NAME>
                                             <DESC>
                                                <L-2 L="EN">Describes the amount of bytes used to handle to the confirmation function on routing activation. If 0 is configured as length the parameter ConfirmedReqData will not be handled to the API.</L-2>
                                             </DESC>
                                             <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_DoIP_00037</RELATED-TRACE-ITEM-REF>
                                             <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
