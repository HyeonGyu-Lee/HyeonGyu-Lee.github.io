                                                   <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                                   <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                   <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                             </VALUE-CONFIG-CLASSES>
                                             <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                          </ECUC-BOOLEAN-PARAM-DEF>
                                          <!-- PARAMETER DEFINITION: J1939RmUserSendAck -->
                                          <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:8311a6fb-8b7b-41ff-8de9-c1d692af5ca4">
                                             <SHORT-NAME>J1939RmUserSendAck</SHORT-NAME>
                                             <DESC>
                                                <L-2 L="EN">Enable the SendAck API for this module. In case of RTE, the operation SendAck of the provided port J1939Rm_SendAck_{user} is called.</L-2>
                                             </DESC>
                                             <INTRODUCTION>
                                                <P>
                                                   <L-1 L="EN">This parameter shall not be set for J1939RmUserType J1939RM_USER_J1939NM or J1939RM_USER_COM.</L-1>
                                                </P>
                                             </INTRODUCTION>
                                             <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_J1939Rm_00030</RELATED-TRACE-ITEM-REF>
