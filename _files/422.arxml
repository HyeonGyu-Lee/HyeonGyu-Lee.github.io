                                          </ECUC-VALUE-CONFIGURATION-CLASS>
                                       </VALUE-CONFIG-CLASSES>
                                       <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                       <MAX>127</MAX>
                                       <MIN>0</MIN>
                                    </ECUC-INTEGER-PARAM-DEF>
                                    <!-- PARAMETER DEFINITION: J1939NmNodeNameVehicleSystemInstance -->
                                    <ECUC-INTEGER-PARAM-DEF UUID="ECUC:4f775893-203a-45ec-87be-5c9f165ea17f">
                                       <SHORT-NAME>J1939NmNodeNameVehicleSystemInstance</SHORT-NAME>
