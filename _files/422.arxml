                                             <MAX>8</MAX>
                                             <MIN>0</MIN>
                                          </ECUC-INTEGER-PARAM-DEF>
                                          <!-- PARAMETER DEFINITION: CanTrcvPowerOnFlag -->
                                          <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:869324cb-1350-4b1c-b366-5b8b609b4ffc">
                                             <SHORT-NAME>CanTrcvPowerOnFlag</SHORT-NAME>
                                             <DESC>
                                                <L-2 L="EN">Description: Indicates if the Power On Reset (POR) flag is available and is managed by the transceiver.</L-2>
                                             </DESC>
                                             <INTRODUCTION>
                                                <P>
                                                   <L-1 L="EN">TRUE = Supported by Hardware. 
                                                        FALSE = Not supported by Hardware</L-1>
                                                </P>
                                             </INTRODUCTION>
                                             <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_CanTrcv_00170</RELATED-TRACE-ITEM-REF>
                                             <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                             <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                             <SCOPE>LOCAL</SCOPE>
                                             <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                             <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                                             <VALUE-CONFIG-CLASSES>
