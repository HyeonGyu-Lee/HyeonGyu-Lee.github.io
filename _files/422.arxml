                                          </ECUC-SYMBOLIC-NAME-REFERENCE-DEF>
                                          <!-- Symbolic Name Reference Definition: TCPIP_E_PACKETTOBIG -->
                                          <ECUC-SYMBOLIC-NAME-REFERENCE-DEF UUID="ECUC:8ecc8dce-3178-4ff4-a4de-ca230a566b45">
