                                             <SHORT-NAME>RamTstNumberOfTestedCells</SHORT-NAME>
                                             <DESC>
                                                <L-2 L="EN">This is the initial value for a RAM variable, which can be changed by the function "RamTst_ChangeNumberOfTestedCells"</L-2>
                                             </DESC>
                                             <RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_RamTst_00142</RELATED-TRACE-ITEM-REF>
