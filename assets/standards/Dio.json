          "path": "/Dio/DioConfig/DioPort",
          "type": "ECUC-PARAM-CONF-CONTAINER-DEF",
          "lower": "1",
          "upper": null,
          "infinite": "true",
          "description": "Configuration of individual DIO ports, consisting of channels and possible channel groups.",
          "metadata": {
            "INTRODUCTION": "Note that this container definition does not explicitly define a symbolic name parameter. Instead, the container's short name will be used in the Ecu Configuration Description to specify the symbolic name of the port.",
            "RELATED-TRACE-ITEM-REF": "ECUC_Dio_00144",
            "LOWER-MULTIPLICITY": "1",
            "UPPER-MULTIPLICITY-INFINITE": "true"
          },
          "children": [
            {
              "name": "DioPortId",
              "path": "/Dio/DioConfig/DioPort/DioPortId",
              "type": "ECUC-INTEGER-PARAM-DEF",
              "lower": "1",
              "upper": "1",
              "infinite": null,
              "description": "Numeric identifier of the DIO port. Not all MCU ports may be used for DIO, thus there may be \"gaps\" in the list of all IDs. This value will be",
              "metadata": {
                "INTRODUCTION": "assigned to the DIO port symbolic name (i.e. the SHORT-NAME of the DioPort container).",
                "RELATED-TRACE-ITEM-REF": "ECUC_Dio_00145",
                "LOWER-MULTIPLICITY": "1",
                "UPPER-MULTIPLICITY": "1",
                "SCOPE": "ECU",
                "ORIGIN": "AUTOSAR_ECUC",
                "POST-BUILD-VARIANT-VALUE": "false",
                "VALUE-CONFIG-CLASSES": "PRE-COMPILE VARIANT-LINK-TIME PRE-COMPILE VARIANT-PRE-COMPILE",
                "SYMBOLIC-NAME-VALUE": "true",
                "MAX": "4294967295",
                "MIN": "0"
              },
              "children": []
            },
            {
              "name": "DioChannel",
              "path": "/Dio/DioConfig/DioPort/DioChannel",
