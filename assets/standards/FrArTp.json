              "lower": "1",
              "upper": "1",
              "infinite": null,
              "description": "This parameter defines the maximum number of trying to send a frame when a TIMEOUT AS occurs.",
              "metadata": {
                "RELATED-TRACE-ITEM-REF": "ECUC_FrArTp_00022",
